{
  "name": "bc250-control",
  "version": "0.1.0",
  "description": "Big Picture controls for the BC-250 SteamOS toolkit",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.12 <25",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyboardspecialist/bc250-steamos.git",
    "directory": "decky-plugin"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.0",
    "@rollup/rollup-linux-x64-musl": "4.64.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router": "5.1.20",
    "rollup": "4.64.12",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}

+#define CYAN_SKILLFISH_ROBIN3_SMU_VERSION	0x00580600
+#define CYAN_SKILLFISH_CORE_PRESENCE		0x0115a870
+#define CYAN_SKILLFISH_CORE_COUNT		8
+
+#define CYAN_SKILLFISH_ROBIN3_TABLE_SIZE	0x344
+#define CYAN_SKILLFISH_ROBIN3_CORE_POWER	0x118
+#define CYAN_SKILLFISH_ROBIN3_CORE_TEMP		0x158
+#define CYAN_SKILLFISH_ROBIN3_CORE_FREQ		0x198
+
+#define CYAN_SKILLFISH_ROBIN3_MSG_REG		0x03b10a20
+#define CYAN_SKILLFISH_ROBIN3_RESP_REG		0x03b10a80
+#define CYAN_SKILLFISH_ROBIN3_ARG_REG		0x03b10a88
+#define CYAN_SKILLFISH_ROBIN3_SET_ADDR_HIGH	0x7a
+#define CYAN_SKILLFISH_ROBIN3_SET_ADDR_LOW	0x7b
+#define CYAN_SKILLFISH_ROBIN3_TRANSFER_TABLE	0x22
+
+#define CYAN_SKILLFISH_ROBIN3_POLL_US		50
+#define CYAN_SKILLFISH_ROBIN3_TIMEOUT_US	1000000
+
+#define CYAN_SKILLFISH_CORE_FREQ_MIN_MHZ	100
+#define CYAN_SKILLFISH_CORE_FREQ_MAX_MHZ	6000
+#define CYAN_SKILLFISH_CORE_TEMP_MAX		15000
+
+struct cyan_skillfish_robin3_metrics {
+	u16 core_power[CYAN_SKILLFISH_CORE_COUNT];
+	u16 core_temperature[CYAN_SKILLFISH_CORE_COUNT];
+	u16 core_frequency[CYAN_SKILLFISH_CORE_COUNT];
+};
+
+static int cyan_skillfish_is_robin3_8core(struct smu_context *smu)
+{
+	struct amdgpu_device *adev = smu->adev;
+	u32 smu_version;
+	int ret;
+
+	ret = smu_cmn_get_smc_version(smu, NULL, &smu_version);
+	if (ret)
+		return ret;
+	if (smu_version != CYAN_SKILLFISH_ROBIN3_SMU_VERSION)
+		return -ENODEV;
+	if ((RREG32_PCIE(CYAN_SKILLFISH_CORE_PRESENCE) & 0xff) != 0xff)
+		return -ENODEV;
+	if (num_present_cpus() != CYAN_SKILLFISH_CORE_COUNT * 2)
+		return -ENODEV;
+
+	return 0;
+}
+
+static int
+cyan_skillfish_robin3_send_msg_locked(struct smu_context *smu, u8 msg, u32 arg)
+{
+	struct amdgpu_device *adev = smu->adev;
+	u32 response;
+	int ret;
+
+	lockdep_assert_held(&smu->message_lock);
+
+	ret = read_poll_timeout(RREG32_PCIE, response, response,
+				CYAN_SKILLFISH_ROBIN3_POLL_US,
+				CYAN_SKILLFISH_ROBIN3_TIMEOUT_US, false,
+				CYAN_SKILLFISH_ROBIN3_RESP_REG);
+	if (ret)
+		return ret;
+
+	WREG32_PCIE(CYAN_SKILLFISH_ROBIN3_RESP_REG, 0);
+	WREG32_PCIE(CYAN_SKILLFISH_ROBIN3_ARG_REG, arg);
+	WREG32_PCIE(CYAN_SKILLFISH_ROBIN3_MSG_REG, msg);
+
+	ret = read_poll_timeout(RREG32_PCIE, response, response,
+				CYAN_SKILLFISH_ROBIN3_POLL_US,
+				CYAN_SKILLFISH_ROBIN3_TIMEOUT_US, false,
+				CYAN_SKILLFISH_ROBIN3_RESP_REG);
+	if (ret)
+		return ret;
+
+	switch (response) {
+	case PPSMC_Result_OK:
+		return 0;
+	case PPSMC_Result_Failed:
+		return -EIO;
+	case PPSMC_Result_UnknownCmd:
+		return -EOPNOTSUPP;
+	case PPSMC_Result_CmdRejectedPrereq:
+		return -EINVAL;
+	case PPSMC_Result_CmdRejectedBusy:
+		return -EBUSY;
+	default:
+		return -EREMOTEIO;
+	}
+}
+
+/* Table 3 stores positive binary32 values; decode them without kernel FP. */
+static int
+cyan_skillfish_robin3_float_to_u16(const u8 *table, u32 offset, u32 scale,
+				   u32 min, u32 max, u16 *value)
+{
+	u32 bits = get_unaligned_le32(table + offset);
+	u32 exponent = (bits >> 23) & 0xff;
+	u64 significand, scaled;
+	int shift;
+
+	if (bits & BIT(31) || exponent == 0xff)
+		return -ERANGE;
+
+	if (exponent) {
+		significand = BIT(23) | (bits & GENMASK(22, 0));
+		shift = exponent - 127 - 23;
+	} else {
+		significand = bits & GENMASK(22, 0);
+		shift = -149;
+	}
+
+	scaled = significand * scale;
+	if (shift >= 0) {
+		if (shift >= 64 || scaled > (U64_MAX >> shift))
+			return -ERANGE;
+		scaled <<= shift;
+	} else if (shift <= -64) {
+		scaled = 0;
+	} else {
+		scaled >>= -shift;
+	}
+
+	if (scaled < min || scaled > max)
+		return -ERANGE;
+
+	*value = scaled;
+	return 0;
+}
+
+static int
+cyan_skillfish_get_robin3_core_metrics(struct smu_context *smu,
+				       struct cyan_skillfish_robin3_metrics *metrics)
+{
+	struct amdgpu_device *adev = smu->adev;
+	struct smu_table *table =
+		&smu->smu_table.tables[SMU_TABLE_PMSTATUSLOG];
+	const u8 *data;
+	int i, ret;
+
+	ret = cyan_skillfish_is_robin3_8core(smu);
+	if (ret)
+		return ret;
+	if (adev->no_hw_access)
+		return -EIO;
+	if (!table->bo || !table->cpu_addr || !table->mc_address ||
+	    table->size < CYAN_SKILLFISH_ROBIN3_TABLE_SIZE)
+		return -EINVAL;
+
+	mutex_lock(&smu->message_lock);
+
+	ret = cyan_skillfish_robin3_send_msg_locked(smu,
+				CYAN_SKILLFISH_ROBIN3_SET_ADDR_HIGH,
+				upper_32_bits(table->mc_address));
+	if (!ret)
+		ret = cyan_skillfish_robin3_send_msg_locked(smu,
+					CYAN_SKILLFISH_ROBIN3_SET_ADDR_LOW,
+					lower_32_bits(table->mc_address));
+	if (!ret)
+		ret = cyan_skillfish_robin3_send_msg_locked(smu,
+					CYAN_SKILLFISH_ROBIN3_TRANSFER_TABLE,
+					TABLE_PMSTATUSLOG);
+	if (ret)
+		goto out_unlock;
+
+	amdgpu_asic_invalidate_hdp(adev, NULL);
+	data = table->cpu_addr;
+
+	for (i = 0; i < CYAN_SKILLFISH_CORE_COUNT; i++) {
+		ret = cyan_skillfish_robin3_float_to_u16(data,
+					CYAN_SKILLFISH_ROBIN3_CORE_POWER + i * sizeof(u32),
+					1000, 0, U16_MAX, &metrics->core_power[i]);
+		if (ret)
+			goto out_unlock;
+		ret = cyan_skillfish_robin3_float_to_u16(data,
+					CYAN_SKILLFISH_ROBIN3_CORE_TEMP + i * sizeof(u32),
+					100, 0, CYAN_SKILLFISH_CORE_TEMP_MAX,
+					&metrics->core_temperature[i]);
+		if (ret)
+			goto out_unlock;
+		ret = cyan_skillfish_robin3_float_to_u16(data,
+					CYAN_SKILLFISH_ROBIN3_CORE_FREQ + i * sizeof(u32),
+					1000, CYAN_SKILLFISH_CORE_FREQ_MIN_MHZ,
+					CYAN_SKILLFISH_CORE_FREQ_MAX_MHZ,
+					&metrics->core_frequency[i]);
+		if (ret)
+			goto out_unlock;
+	}
+
+out_unlock:
+	mutex_unlock(&smu->message_lock);
+	return ret;
+}

+static uint16_t cyan_skillfish_core_count(void)
+{
+	unsigned int cpu;
+	uint16_t cores = 0;
+
+	for_each_present_cpu(cpu) {
+		if (topology_is_primary_thread(cpu))
+			cores++;
+	}
+
+	return cores;
+}
+
+static void cyan_skillfish_expand_metrics_table(SmuMetricsTable8_t *dst,
+						 const SmuMetricsTable_t *src)
+{
+	memcpy(dst->CoreFrequency, src->CoreFrequency,
+	       sizeof(src->CoreFrequency));
+	memcpy(dst->CorePower, src->CorePower, sizeof(src->CorePower));
+	memcpy(dst->CoreTemperature, src->CoreTemperature,
+	       sizeof(src->CoreTemperature));
+	memcpy(dst->L3Frequency, src->L3Frequency, sizeof(src->L3Frequency));
+	memcpy(dst->L3Temperature, src->L3Temperature,
+	       sizeof(src->L3Temperature));
+	memcpy(dst->C0Residency, src->C0Residency,
+	       sizeof(src->C0Residency));
+	memcpy(dst->Voltage, src->Voltage, sizeof(src->Voltage));
+	memcpy(dst->Current, src->Current, sizeof(src->Current));
+	memcpy(dst->Power, src->Power, sizeof(src->Power));
+
+	dst->GfxclkFrequency = src->GfxclkFrequency;
+	dst->GfxTemperature = src->GfxTemperature;
+	dst->SocclkFrequency = src->SocclkFrequency;
+	dst->VclkFrequency = src->VclkFrequency;
+	dst->DclkFrequency = src->DclkFrequency;
+	dst->MemclkFrequency = src->MemclkFrequency;
+	dst->CurrentSocketPower = src->CurrentSocketPower;
+	dst->SocTemperature = src->SocTemperature;
+	dst->EdgeTemperature = src->EdgeTemperature;
+	dst->ThrottlerStatus = src->ThrottlerStatus;
+	dst->Spare = src->Spare;
+}
+
+static bool cyan_skillfish_has_eight_core_metrics(struct smu_context *smu)
+{
+	return smu->smu_table.tables[SMU_TABLE_SMU_METRICS].size ==
+	       sizeof(SmuMetrics8_t);
+}
+
+static int cyan_skillfish_get_metrics_snapshot(
+		struct smu_context *smu,
+		struct cyan_skillfish_metrics_snapshot *snapshot,
+		bool bypass_cache)
+{
+	union cyan_skillfish_raw_metrics raw;
+	int ret;
+
+	ret = smu_cmn_get_metrics_table(smu, &raw, bypass_cache);
+	if (ret)
+		return ret;
+
+	/* Unavailable gpu_metrics_v2_2 slots must remain 0xffff. */
+	memset(snapshot, 0xff, sizeof(*snapshot));
+	if (cyan_skillfish_has_eight_core_metrics(smu)) {
+		SmuMetrics8_t *metrics = &raw.eight;
+
+		snapshot->Current = metrics->Current;
+		snapshot->Average = metrics->Average;
+	} else {
+		SmuMetrics_t *metrics = &raw.six;
+
+		cyan_skillfish_expand_metrics_table(&snapshot->Current,
+						    &metrics->Current);
+		cyan_skillfish_expand_metrics_table(&snapshot->Average,
+						    &metrics->Average);
+	}
+
+	return 0;
+}

+#define CYAN_SKILLFISH_ROBIN3_SMU_VERSION	0x00580600
+#define CYAN_SKILLFISH_CORE_PRESENCE		0x0115a870
+#define CYAN_SKILLFISH_CORE_COUNT		8
+#define CYAN_SKILLFISH_CORE_RECORD_STRIDE	0x178
+#define CYAN_SKILLFISH_CORE_POWER_BASE		0x03c0fad4
+#define CYAN_SKILLFISH_CORE_TEMP_BASE		0x03c0fae0
+#define CYAN_SKILLFISH_CORE_FREQ_BASE		0x03c0fc04
+#define CYAN_SKILLFISH_CORE_C0_BASE		0x03c0fc10
+
+#define CYAN_SKILLFISH_CORE_FREQ_MIN		100
+#define CYAN_SKILLFISH_CORE_FREQ_MAX		6000
+#define CYAN_SKILLFISH_CORE_POWER_MAX		30000
+#define CYAN_SKILLFISH_CORE_TEMP_MAX		15000
+#define CYAN_SKILLFISH_CORE_C0_MAX		100
+
+struct cyan_skillfish_core_metrics {
+	uint16_t frequency[CYAN_SKILLFISH_CORE_COUNT];
+	uint16_t power[CYAN_SKILLFISH_CORE_COUNT];
+	uint16_t temperature[CYAN_SKILLFISH_CORE_COUNT];
+};
+
+static int cyan_skillfish_float_to_u16(uint32_t raw, uint32_t scale,
+					uint16_t max, uint16_t *value)
+{
+	uint32_t exponent = (raw >> 23) & 0xff;
+	uint64_t mantissa, scaled;
+	int shift;
+
+	if (raw & BIT(31) || exponent == 0xff)
+		return -ERANGE;
+
+	mantissa = raw & GENMASK(22, 0);
+	if (!exponent) {
+		if (mantissa)
+			return -ERANGE;
+		*value = 0;
+		return 0;
+	}
+
+	mantissa |= BIT(23);
+	shift = exponent - 127 - 23;
+	scaled = mantissa * scale;
+	if (shift >= 0) {
+		if (shift >= 64 || scaled > (U64_MAX >> shift))
+			return -ERANGE;
+		scaled <<= shift;
+	} else if (shift <= -64) {
+		scaled = 0;
+	} else {
+		scaled >>= -shift;
+	}
+
+	if (scaled > max)
+		return -ERANGE;
+
+	*value = scaled;
+	return 0;
+}
+
+static int cyan_skillfish_get_robin3_core_metrics(
+		struct smu_context *smu,
+		struct cyan_skillfish_core_metrics *metrics)
+{
+	struct amdgpu_device *adev = smu->adev;
+	uint32_t address, smu_version;
+	uint16_t c0;
+	int i, ret;
+
+	ret = smu_cmn_get_smc_version(smu, NULL, &smu_version);
+	if (ret)
+		return ret;
+	if (smu_version != CYAN_SKILLFISH_ROBIN3_SMU_VERSION)
+		return -EOPNOTSUPP;
+	if ((RREG32_PCIE(CYAN_SKILLFISH_CORE_PRESENCE) & 0xff) != 0xff)
+		return -EOPNOTSUPP;
+
+	for (i = 0; i < CYAN_SKILLFISH_CORE_COUNT; i++) {
+		address = i * CYAN_SKILLFISH_CORE_RECORD_STRIDE;
+
+		ret = cyan_skillfish_float_to_u16(
+			RREG32_PCIE(CYAN_SKILLFISH_CORE_POWER_BASE + address),
+			1000, CYAN_SKILLFISH_CORE_POWER_MAX,
+			&metrics->power[i]);
+		if (ret)
+			return ret;
+
+		ret = cyan_skillfish_float_to_u16(
+			RREG32_PCIE(CYAN_SKILLFISH_CORE_TEMP_BASE + address),
+			100, CYAN_SKILLFISH_CORE_TEMP_MAX,
+			&metrics->temperature[i]);
+		if (ret)
+			return ret;
+
+		ret = cyan_skillfish_float_to_u16(
+			RREG32_PCIE(CYAN_SKILLFISH_CORE_FREQ_BASE + address),
+			1000, CYAN_SKILLFISH_CORE_FREQ_MAX,
+			&metrics->frequency[i]);
+		if (ret)
+			return ret;
+		if (metrics->frequency[i] < CYAN_SKILLFISH_CORE_FREQ_MIN)
+			return -ERANGE;
+
+		ret = cyan_skillfish_float_to_u16(
+			RREG32_PCIE(CYAN_SKILLFISH_CORE_C0_BASE + address),
+			100, CYAN_SKILLFISH_CORE_C0_MAX, &c0);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}

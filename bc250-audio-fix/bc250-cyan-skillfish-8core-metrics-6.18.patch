@@ -76,4 +76,46 @@ typedef struct SmuMetrics_t {
 	uint32_t Accnt;
 } SmuMetrics_t;
 
+/* Private ABI emitted by the BC-250 Robin 1/3 eight-core firmware patch. */
+typedef struct SmuMetricsTable_8core_t {
+	uint16_t CoreFrequency[8];		/* 0x00, MHz */
+	uint32_t CorePower[8];			/* 0x10, mW */
+	uint16_t CoreTemperature[8];		/* 0x30, centi-Celsius */
+	uint16_t L3Frequency[2];		/* 0x40, MHz */
+	uint16_t L3Temperature[2];		/* 0x44, centi-Celsius */
+	uint16_t C0Residency[8];		/* 0x48, percent */
+	uint16_t GfxclkFrequency;		/* 0x58, MHz */
+	uint16_t GfxTemperature;		/* 0x5a, centi-Celsius */
+	uint16_t SocclkFrequency;		/* 0x5c, MHz */
+	uint16_t VclkFrequency;			/* 0x5e, MHz */
+	uint16_t DclkFrequency;			/* 0x60, MHz */
+	uint16_t MemclkFrequency;		/* 0x62, MHz */
+	uint32_t Voltage[2];			/* 0x64, mV */
+	uint32_t Current[2];			/* 0x6c, mA */
+	uint32_t Power[2];			/* 0x74, mW */
+	uint32_t CurrentSocketPower;		/* 0x7c, mW */
+	uint16_t SocTemperature;		/* 0x80, centi-Celsius */
+	uint16_t EdgeTemperature;		/* 0x82, centi-Celsius */
+	uint16_t ThrottlerStatus;		/* 0x84 */
+	uint16_t Spare;				/* 0x86 */
+} SmuMetricsTable_8core_t;
+
+typedef struct SmuMetrics_8core_t {
+	SmuMetricsTable_8core_t Current;	/* 0x000 */
+	SmuMetricsTable_8core_t Average;	/* 0x088 */
+	uint32_t SampleStartTime;		/* 0x110 */
+	uint32_t SampleStopTime;		/* 0x114 */
+	uint32_t Accnt;				/* 0x118 */
+} SmuMetrics_8core_t;
+
+static_assert(sizeof(SmuMetricsTable_8core_t) == 0x88);
+static_assert(offsetof(SmuMetricsTable_8core_t, CorePower) == 0x10);
+static_assert(offsetof(SmuMetricsTable_8core_t, CoreTemperature) == 0x30);
+static_assert(offsetof(SmuMetricsTable_8core_t, C0Residency) == 0x48);
+static_assert(offsetof(SmuMetricsTable_8core_t, GfxclkFrequency) == 0x58);
+static_assert(offsetof(SmuMetricsTable_8core_t, ThrottlerStatus) == 0x84);
+static_assert(offsetof(SmuMetrics_8core_t, Average) == 0x88);
+static_assert(offsetof(SmuMetrics_8core_t, Accnt) == 0x118);
+static_assert(sizeof(SmuMetrics_8core_t) == 0x11c);
+
 #endif

 	return DIV_ROUND_CLOSEST(busy * 10000, 32);
 }
 
+static int cyan_skillfish_get_gfxclk_frequency(struct smu_context *smu,
+					       uint32_t *value)
+{
+	int ret;
+
+	ret = smu_cmn_send_smc_msg(smu, SMU_MSG_GetGfxclkFrequency, value);
+	if (ret)
+		return ret;
+	if (*value < CYAN_SKILLFISH_SCLK_MIN ||
+	    *value > CYAN_SKILLFISH_SCLK_MAX) {
+		dev_dbg(smu->adev->dev, "discarding invalid GFX clock %u MHz\n",
+			*value);
+		return -ERANGE;
+	}
+
+	return 0;
+}
+

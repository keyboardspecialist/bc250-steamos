diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
--- a/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu11/cyan_skillfish_ppt.c
@@ -119,6 +119,6 @@ static int cyan_skillfish_get_gfxclk_frequency(struct smu_context *smu,
 #define CYAN_SKILLFISH_ROBIN3_MSG_REG		0x03b10a20
 #define CYAN_SKILLFISH_ROBIN3_RESP_REG		0x03b10a80
 #define CYAN_SKILLFISH_ROBIN3_ARG_REG		0x03b10a88
-#define CYAN_SKILLFISH_ROBIN3_SET_ADDR_HIGH	0x7a
-#define CYAN_SKILLFISH_ROBIN3_SET_ADDR_LOW	0x7b
+#define CYAN_SKILLFISH_ROBIN3_SET_TOOLS_HIGH	0x3e
+#define CYAN_SKILLFISH_ROBIN3_SET_TOOLS_LOW	0x3f
 #define CYAN_SKILLFISH_ROBIN3_TRANSFER_TABLE	0x22
@@ -259 +259,8 @@ cyan_skillfish_get_robin3_core_metrics(struct smu_context *smu,
 	mutex_lock(&smu->message_lock);
+	/*
+	 * Table 3's first successful request only starts its sampler and does
+	 * not DMA. Poison and consume the shared BO under the same lock so an
+	 * untouched first result cannot be confused with another reader's data.
+	 */
+	memset(table->cpu_addr, 0xff, CYAN_SKILLFISH_ROBIN3_TABLE_SIZE);
+	amdgpu_asic_flush_hdp(adev, NULL);
@@ -261,7 +269,7 @@ cyan_skillfish_get_robin3_core_metrics(struct smu_context *smu,
 	ret = cyan_skillfish_robin3_send_msg_locked(smu,
-				CYAN_SKILLFISH_ROBIN3_SET_ADDR_HIGH,
+				CYAN_SKILLFISH_ROBIN3_SET_TOOLS_HIGH,
 				upper_32_bits(table->mc_address));
 	if (!ret)
 		ret = cyan_skillfish_robin3_send_msg_locked(smu,
-					CYAN_SKILLFISH_ROBIN3_SET_ADDR_LOW,
+					CYAN_SKILLFISH_ROBIN3_SET_TOOLS_LOW,
 					lower_32_bits(table->mc_address));
@@ -276 +284,6 @@ cyan_skillfish_get_robin3_core_metrics(struct smu_context *smu,
 	data = table->cpu_addr;
+	if (get_unaligned_le32(data + CYAN_SKILLFISH_ROBIN3_CORE_POWER) ==
+	    U32_MAX) {
+		ret = -EAGAIN;
+		goto out_unlock;
+	}

From 19860422da4e81b2b9bb5e4ec203db7df3e7074b Mon Sep 17 00:00:00 2001
From: BC-250 SteamOS contributors <bc250-steamos@users.noreply.github.com>
Date: Sat, 22 Aug 2026 19:32:23 -0500
Subject: [PATCH] radv: optimize GFX1013 ACO software sdot workloads

GFX1013 has no usable native signed packed 4x8 dot instruction, but FSR4
compute shaders contain large signed-dot reductions.  Preserve signed dots
for one private algebraic round, fold surrounding accumulators, and then
explicitly lower every remaining signed dot before ACO instruction selection.
Gate the entire custom path on `!use_llvm`; LLVM retains Mesa's generic
software lowering and never receives the ACO-supported `imul24` or
`imad24_ir3` forms.

Use signed MAD24 chains for accumulator-bearing and constant forms.  Use two
independent chains for zero-accumulator, saturating, and dense-reduction forms
to shorten dependency depth.  Select the dense strategy from dot count,
ALU density, and control-flow block count: at least 768 wrapping dots, with
either 30% dot density in at most 128 blocks or at least 2048 dots in a
control-rich shader.  This covers large reduction families without exact
shader fingerprints.

Teach ACO the existing NIR imul24 and imad24_ir3 semantics and reject any
GFX1013 signed dot that escapes lowering, preventing v_dot4_i32_i8 emission.
Preserve ACO's baseline LDS spill eligibility condition for every family and
shader.  For an already eligible pathological wave64/workgroup64 GFX1013
compute shader with no existing LDS and at least 16 VGPRs of excess pressure,
cap LDS spilling at eight slots per lane (2 KiB per workgroup), still subject
to ACO's existing occupancy accounting.  This is a resource-policy cap, not a
new LDS spill permission.

Do not alter or spoof RADV physical-device or compiler generation levels.  No
accelerated or native signed-dot capability is enabled.

Clean-room disclosure: this implementation was independently designed from
the functional specification and Mesa's MIT-licensed internals.  No external
FSR4 patch, repository, clone, binary, or research artifact was consulted or
copied.

Signed-off-by: BC-250 SteamOS contributors <bc250-steamos@users.noreply.github.com>
---
diff --git a/src/amd/compiler/aco_ir.cpp b/src/amd/compiler/aco_ir.cpp
index 1955bf76aca..08f4101ae6f 100644
--- a/src/amd/compiler/aco_ir.cpp
+++ b/src/amd/compiler/aco_ir.cpp
@@ -69,6 +69,7 @@ init_program(Program* program, Stage stage, const struct aco_shader_info* info,
    program->stage = stage;
    program->config = config;
    program->info = *info;
+   program->family = options->family;
    program->gfx_level = options->gfx_level;
    program->wave_size = info->wave_size;
    program->lane_mask = program->wave_size == 32 ? s1 : s2;
diff --git a/src/amd/compiler/aco_ir.h b/src/amd/compiler/aco_ir.h
index 4082a9519ed..a6a737c0f82 100644
--- a/src/amd/compiler/aco_ir.h
+++ b/src/amd/compiler/aco_ir.h
@@ -2332,6 +2332,7 @@ public:
    RegisterDemand fixed_reg_demand = RegisterDemand();
    ac_shader_config* config;
    struct aco_shader_info info;
+   enum radeon_family family;
    enum amd_gfx_level gfx_level;
    DeviceInfo dev;
    unsigned wave_size;
diff --git a/src/amd/compiler/aco_spill.cpp b/src/amd/compiler/aco_spill.cpp
index 3e238f1d97b..9fcc5028c9b 100644
--- a/src/amd/compiler/aco_spill.cpp
+++ b/src/amd/compiler/aco_spill.cpp
@@ -1884,6 +1884,10 @@ spill(Program* program)
    uint16_t extra_sgprs = 0;
 
    uint32_t max_lds_spill_slots = 0;
+   const bool gfx1013_pathological_spill =
+      program->family == CHIP_GFX1013 && program->stage == compute_cs &&
+      program->wave_size == 64 && program->workgroup_size == 64 &&
+      program->config->lds_size == 0 && demand.vgpr >= limit.vgpr + 16;
    /* Only use LDS for VGPR spilling if we can use addtid access, to avoid having a VGPR addr.
     * Limit to single wave workgroups, to avoid needing the wave_id for the offset.
     * If we have a scratch stack pointer, don't use LDS at all.
@@ -1906,6 +1910,8 @@ spill(Program* program)
        * on the CU at the same time, but that's unlikely and impossible to know at this point.
        */
       max_lds_spill_slots = MAX2(max_lds - used_lds, 0) / (program->workgroup_size * 4);
+      if (gfx1013_pathological_spill)
+         max_lds_spill_slots = MIN2(max_lds_spill_slots, 8u);
    }
 
    /* calculate extra VGPRs required for spilling SGPRs */
diff --git a/src/amd/compiler/instruction_selection/aco_select_nir_alu.cpp b/src/amd/compiler/instruction_selection/aco_select_nir_alu.cpp
index d509130f4d8..196c5e07a96 100644
--- a/src/amd/compiler/instruction_selection/aco_select_nir_alu.cpp
+++ b/src/amd/compiler/instruction_selection/aco_select_nir_alu.cpp
@@ -1766,6 +1766,18 @@ visit_alu_instr(isel_context* ctx, nir_alu_instr* instr)
       }
       break;
    }
+   case nir_op_imul24: {
+      if (dst.regClass() == v1) {
+         emit_vop2_instruction(ctx, instr, aco_opcode::v_mul_i32_i24, dst, true);
+      } else if (dst.regClass() == s1) {
+         Temp tmp = bld.tmp(v1);
+         emit_vop2_instruction(ctx, instr, aco_opcode::v_mul_i32_i24, tmp, true);
+         bld.pseudo(aco_opcode::p_as_uniform, Definition(dst), tmp);
+      } else {
+         isel_err(&instr->instr, "Unimplemented NIR instr bit size");
+      }
+      break;
+   }
    case nir_op_imul24_relaxed: {
       if (dst.regClass() == s1) {
          emit_sop2_instruction(ctx, instr, aco_opcode::s_mul_i32, dst, false, 0x3);
@@ -1776,6 +1788,18 @@ visit_alu_instr(isel_context* ctx, nir_alu_instr* instr)
       }
       break;
    }
+   case nir_op_imad24_ir3: {
+      if (dst.regClass() == v1) {
+         emit_vop3a_instruction(ctx, instr, aco_opcode::v_mad_i32_i24, dst, false, 3);
+      } else if (dst.regClass() == s1) {
+         Temp tmp = bld.tmp(v1);
+         emit_vop3a_instruction(ctx, instr, aco_opcode::v_mad_i32_i24, tmp, false, 3);
+         bld.pseudo(aco_opcode::p_as_uniform, Definition(dst), tmp);
+      } else {
+         isel_err(&instr->instr, "Unimplemented NIR instr bit size");
+      }
+      break;
+   }
    case nir_op_umul24_relaxed: {
       if (dst.regClass() == s1) {
          Operand op1(get_alu_src(ctx, instr->src[0]));
@@ -2021,6 +2045,10 @@ visit_alu_instr(isel_context* ctx, nir_alu_instr* instr)
       break;
    }
    case nir_op_sdot_4x8_iadd: {
+      if (ctx->options->family == CHIP_GFX1013) {
+         isel_err(&instr->instr, "GFX1013 signed dot must be lowered before instruction selection");
+         break;
+      }
       if (ctx->options->gfx_level >= GFX11)
          emit_idot_instruction(ctx, instr, aco_opcode::v_dot4_i32_iu8, dst, false, 0x3);
       else
@@ -2028,6 +2056,10 @@ visit_alu_instr(isel_context* ctx, nir_alu_instr* instr)
       break;
    }
    case nir_op_sdot_4x8_iadd_sat: {
+      if (ctx->options->family == CHIP_GFX1013) {
+         isel_err(&instr->instr, "GFX1013 signed dot must be lowered before instruction selection");
+         break;
+      }
       if (ctx->options->gfx_level >= GFX11)
          emit_idot_instruction(ctx, instr, aco_opcode::v_dot4_i32_iu8, dst, true, 0x3);
       else
diff --git a/src/amd/vulkan/radv_shader.c b/src/amd/vulkan/radv_shader.c
index 2a5f04a6dc9..d60fd729ebf 100644
--- a/src/amd/vulkan/radv_shader.c
+++ b/src/amd/vulkan/radv_shader.c
@@ -465,6 +465,159 @@ ycbcr_conversion_lookup(const void *data, uint32_t set, uint32_t binding, uint32
    }
 }
 
+struct radv_gfx1013_sdot_stats {
+   unsigned alu;
+   unsigned dots;
+   unsigned saturating_dots;
+   unsigned blocks;
+};
+
+static bool
+radv_gfx1013_use_dense_sdot(const struct radv_gfx1013_sdot_stats *stats)
+{
+   const unsigned wrapping_dots = stats->dots - stats->saturating_dots;
+
+   if (wrapping_dots < 768)
+      return false;
+
+   /* Dense straight-line reductions benefit from two independent MAD chains.
+    * Very large reductions get the same treatment even with substantial control flow.
+    */
+   return (stats->dots * 10 >= stats->alu * 3 && stats->blocks <= 128) ||
+          (stats->dots >= 2048 && stats->blocks >= 8);
+}
+
+static struct radv_gfx1013_sdot_stats
+radv_gfx1013_analyze_sdot(nir_shader *shader)
+{
+   struct radv_gfx1013_sdot_stats stats = {0};
+
+   nir_foreach_function_impl (impl, shader) {
+      nir_foreach_block (block, impl) {
+         stats.blocks++;
+         nir_foreach_instr (instr, block) {
+            if (instr->type != nir_instr_type_alu)
+               continue;
+
+            nir_alu_instr *alu = nir_instr_as_alu(instr);
+            stats.alu++;
+            if (alu->op == nir_op_sdot_4x8_iadd || alu->op == nir_op_sdot_4x8_iadd_sat) {
+               stats.dots++;
+               stats.saturating_dots += alu->op == nir_op_sdot_4x8_iadd_sat;
+            }
+         }
+      }
+   }
+
+   return stats;
+}
+
+struct radv_gfx1013_sdot_state {
+   bool dense;
+   bool wrappers;
+};
+
+static nir_def *
+radv_gfx1013_sdot_byte(nir_builder *b, nir_alu_instr *dot, unsigned src, unsigned byte)
+{
+   if (nir_src_is_const(dot->src[src].src)) {
+      uint32_t packed = nir_src_as_uint(dot->src[src].src);
+      return nir_imm_int(b, (int8_t)(packed >> (byte * 8)));
+   }
+
+   return nir_extract_i8_imm(b, nir_ssa_for_alu_src(b, dot, src), byte);
+}
+
+static nir_def *
+radv_gfx1013_lower_one_sdot(nir_builder *b, nir_alu_instr *dot, nir_def *extra_accum, bool dense)
+{
+   const bool saturate = dot->op == nir_op_sdot_4x8_iadd_sat;
+   nir_def *accum = nir_ssa_for_alu_src(b, dot, 2);
+
+   if (extra_accum)
+      accum = nir_iadd(b, accum, extra_accum);
+
+   nir_src accum_src = nir_src_for_ssa(accum);
+   const bool zero_accum = nir_src_is_const(accum_src) && nir_src_as_uint(accum_src) == 0;
+   const bool constant_operand = nir_src_is_const(dot->src[0].src) || nir_src_is_const(dot->src[1].src);
+   const bool split_chains = saturate || dense || (!constant_operand && zero_accum);
+
+   nir_def *a[4], *c[4];
+   for (unsigned i = 0; i < 4; i++) {
+      a[i] = radv_gfx1013_sdot_byte(b, dot, 0, i);
+      c[i] = radv_gfx1013_sdot_byte(b, dot, 1, i);
+   }
+
+   if (!split_chains) {
+      nir_def *sum = accum;
+      for (unsigned i = 0; i < 4; i++)
+         sum = nir_imad24_ir3(b, a[i], c[i], sum);
+      return sum;
+   }
+
+   nir_def *even = nir_imad24_ir3(b, a[0], c[0], nir_imm_int(b, 0));
+   nir_def *odd = nir_imad24_ir3(b, a[1], c[1], nir_imm_int(b, 0));
+   even = nir_imad24_ir3(b, a[2], c[2], even);
+   odd = nir_imad24_ir3(b, a[3], c[3], odd);
+   nir_def *dot_sum = nir_iadd(b, even, odd);
+
+   return saturate ? nir_iadd_sat(b, dot_sum, accum) : nir_iadd(b, dot_sum, accum);
+}
+
+static bool
+radv_gfx1013_lower_sdot_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   struct radv_gfx1013_sdot_state *state = data;
+
+   if (instr->type != nir_instr_type_alu)
+      return false;
+
+   nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (state->wrappers && alu->op == nir_op_iadd) {
+      for (unsigned i = 0; i < 2; i++) {
+         nir_alu_instr *dot = nir_src_as_alu(alu->src[i].src);
+         if (!dot || (dot->op != nir_op_sdot_4x8_iadd && dot->op != nir_op_sdot_4x8_iadd_sat) ||
+             !list_is_singular(&dot->def.uses))
+            continue;
+
+         b->cursor = nir_before_instr(instr);
+         nir_def *extra = nir_ssa_for_alu_src(b, alu, !i);
+         nir_src extra_src = nir_src_for_ssa(extra);
+         if (dot->op == nir_op_sdot_4x8_iadd_sat &&
+             (!nir_src_is_const(extra_src) || nir_src_as_uint(extra_src) != 0))
+            continue;
+
+         nir_def_replace(&alu->def, radv_gfx1013_lower_one_sdot(b, dot, extra, state->dense));
+         return true;
+      }
+      return false;
+   }
+
+   if (state->wrappers || (alu->op != nir_op_sdot_4x8_iadd && alu->op != nir_op_sdot_4x8_iadd_sat))
+      return false;
+
+   b->cursor = nir_before_instr(instr);
+   nir_def_replace(&alu->def, radv_gfx1013_lower_one_sdot(b, alu, NULL, state->dense));
+   return true;
+}
+
+static void
+radv_gfx1013_optimize_sdot(nir_shader *shader)
+{
+   struct radv_gfx1013_sdot_stats stats = radv_gfx1013_analyze_sdot(shader);
+   struct radv_gfx1013_sdot_state state = {
+      .dense = radv_gfx1013_use_dense_sdot(&stats),
+      .wrappers = true,
+   };
+
+   NIR_PASS(_, shader, nir_shader_instructions_pass, radv_gfx1013_lower_sdot_instr,
+            nir_metadata_control_flow, &state);
+   state.wrappers = false;
+   NIR_PASS(_, shader, nir_shader_instructions_pass, radv_gfx1013_lower_sdot_instr,
+            nir_metadata_control_flow, &state);
+   NIR_PASS(_, shader, nir_opt_dce);
+}
+
 nir_shader *
 radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct radv_shader_stage *stage,
                          const struct radv_spirv_to_nir_options *options, bool is_internal)
@@ -779,6 +932,27 @@ radv_shader_spirv_to_nir(const struct radv_compiler_info *compiler_info, struct
    };
    NIR_PASS(_, nir, nir_opt_access, &opt_access_options);
 
+   const bool gfx1013_sdot =
+      !compiler_info->key.use_llvm && nir->info.stage == MESA_SHADER_COMPUTE &&
+      compiler_info->debug.family == CHIP_GFX1013;
+
+   if (gfx1013_sdot) {
+      /* Keep signed dots intact for one round so algebraic can fold surrounding
+       * accumulators.  This private options copy never changes advertised features.
+       */
+      if (!stage->key.optimisations_disabled) {
+         const nir_shader_compiler_options *real_options = nir->options;
+         nir_shader_compiler_options deferred_options = *real_options;
+         deferred_options.has_sdot_4x8 = true;
+         deferred_options.has_sdot_4x8_sat = true;
+         nir->options = &deferred_options;
+         NIR_PASS(_, nir, nir_opt_algebraic);
+         nir->options = real_options;
+      }
+
+      radv_gfx1013_optimize_sdot(nir);
+   }
+
    if (!stage->key.optimisations_disabled) {
       /* Only run this pass once before nir_lower_var_copies is called,
       * so that we don't introduce any new copy_deref instructions later.
-- 

+/* The direct and hybrid BC250 representations are created while the complete
+ * Mesh<->FS interface is available. GPL, shader objects, DGC indirect-bindable
+ * pipelines, and source-less imports don't retain enough rate/provenance
+ * information to select a representation safely. Reject them before linking
+ * rather than letting missing metadata fall through to DIRECT.
+ */
+static VkResult
+radv_bc250_mesh_source_provenance_check(struct radv_device *device, const struct radv_shader_stage *stages,
+                                        const struct radv_graphics_state_key *gfx_state)
+{
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   const struct radv_shader_stage *mesh = &stages[MESA_SHADER_MESH];
+
+   if (!radv_is_bc250_experimental_mesh(pdev) || !mesh->nir)
+      return VK_SUCCESS;
+
+   if (!gfx_state->bc250_mesh_source_monolithic)
+      return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "BC250 experimental Mesh requires a source-monolithic Mesh+FS pipeline; "
+                       "GPL, shader objects and opaque imports are fail-closed");
+
+   if (mesh->key.indirect_bindable)
+      return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "BC250 experimental Mesh does not support DGC indirect-bindable pipelines");
+
+   if (stages[MESA_SHADER_TASK].nir)
+      return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "BC250 experimental Mesh does not support Task shaders");
+
+   return VK_SUCCESS;

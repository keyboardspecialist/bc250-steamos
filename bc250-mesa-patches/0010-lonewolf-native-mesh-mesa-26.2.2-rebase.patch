+/* Execute the actual generated routing NIR without any device access. */
+TEST_F(mesh_hybrid_test, interpreter_boundaries_and_matching)
+{
+   nir_shader *ms = mesh();
+   ac_mesh_hybrid_layout r = {};
+   ASSERT_TRUE(ac_nir_mesh_hybrid_layout_init(ms, &r, nullptr));
+   r.allow_cyclic_rotation = true;
+   ac_mesh_hybrid_test_layout shared = {};
+   nir_shader *code = ac_nir_create_mesh_hybrid_classifier_test(&options, &r, &shared);
+   using triangle = std::array<unsigned, 3>;
+   auto check = [&](unsigned nv, const std::vector<triangle> &indices,
+                    const std::vector<unsigned> &payloads, unsigned expected_count, unsigned expected_route) {
+      mesh_hybrid_nir_interpreter cpu(code);
+      cpu.store(0, nv); cpu.store(4, indices.size());
+      for (unsigned v = 0; v < nv; ++v)
+         for (unsigned c = 0; c < 4; ++c) cpu.store(shared.vertex + 16 * v + 4 * c, 4 * v + c);
+      for (unsigned p = 0; p < indices.size(); ++p) {
+         for (unsigned c = 0; c < 3; ++c) cpu.store(shared.indices + 3 * p + c, indices[p][c], 1);
+         for (unsigned c = 0; c < 4; ++c) cpu.store(shared.primitive + 16 * p + 4 * c, 4 * payloads[p] + c);
+      }
+      const uint64_t steps = cpu.run(code);
+      unsigned count = cpu.load(16), route = cpu.load(20);
+      EXPECT_EQ(count, expected_count) << "V=" << nv << " P=" << indices.size() << " CPU steps=" << steps;
+      EXPECT_EQ(route, expected_route);
+      if (route == AC_MESH_HYBRID_DIRECT) {
+         ASSERT_LE(count, 256u);
+         for (unsigned p = 0; p < indices.size(); ++p) {
+            unsigned physical = cpu.load(shared.primitive_physical + 4 * p);
+            ASSERT_LT(physical, count);
+            unsigned base = cpu.load(shared.physical_vertex + 4 * physical);
+            unsigned data = cpu.load(shared.physical_primitive + 4 * physical);
+            ASSERT_LT(data, payloads.size());
+            EXPECT_EQ(payloads[data], payloads[p]);
+            EXPECT_NE(std::find(indices[p].begin(), indices[p].end(), base), indices[p].end());
+            for (unsigned vertex : indices[p]) {
+               unsigned alias = cpu.load(shared.alias + 4 * vertex);
+               unsigned corner = cpu.load(shared.representative + 4 * alias);
+               ASSERT_LT(corner, count);
+               EXPECT_EQ(cpu.load(shared.physical_vertex + 4 * corner), vertex);
+            }
+         }
+      }
+   };
+   check(4, {{3,1,2}, {3,2,0}}, {0,1}, 5, AC_MESH_HYBRID_DIRECT);
+   for (unsigned p : {254u,255u,256u}) {
+      std::vector<triangle> indices(p, {0,1,2});
+      indices.back() = {2,3,4};
+      std::vector<unsigned> payloads(p);
+      for (unsigned i = 0; i < p; ++i) payloads[i] = i;
+      check(5, indices, payloads, p+1, p == 256 ? AC_MESH_HYBRID_OVERFLOW : AC_MESH_HYBRID_DIRECT);
+   }
+   std::vector<triangle> fan;
+   for (unsigned i = 1; i < 255; ++i) fan.push_back({0,i,i+1});
+   fan.push_back({0,255,1}); fan.push_back({0,1,2});
+   std::vector<unsigned> payloads(256);
+   for (unsigned i = 0; i < 256; ++i) payloads[i] = i;
+   check(256, fan, payloads, 256, AC_MESH_HYBRID_DIRECT);
+   std::fill(payloads.begin(), payloads.end(), 0);
+   check(256, fan, payloads, 256, AC_MESH_HYBRID_DIRECT);
+   ralloc_free(code);
+   ralloc_free(ms);
+}
+
+TEST_F(mesh_hybrid_test, interpreter_external_campaign)
+{
+   const char *path = getenv("AC_MESH_HYBRID_CPU_CASES");
+   if (!path) GTEST_SKIP() << "optional CPU-only campaign input not selected";
+   std::ifstream input(path);
+   ASSERT_TRUE(input.good());
+   nir_shader *ms = mesh();
+   ac_mesh_hybrid_layout r = {};
+   ASSERT_TRUE(ac_nir_mesh_hybrid_layout_init(ms, &r, nullptr));
+   r.allow_cyclic_rotation = true;
+   ac_mesh_hybrid_test_layout shared = {};
+   nir_shader *code = ac_nir_create_mesh_hybrid_classifier_test(&options, &r, &shared);
+   std::string name;
+   r.allow_cyclic_rotation = false;
+   ac_mesh_hybrid_test_layout fixed_shared = {};
+   nir_shader *fixed_code = ac_nir_create_mesh_hybrid_classifier_test(&options, &r, &fixed_shared);
+   ASSERT_EQ(memcmp(&shared, &fixed_shared, sizeof(shared)), 0);
+   unsigned nv, np, exact_fit, rotate, n = 0, unknown = 0, false_replay = 0;
+   while (input >> name >> nv >> np >> exact_fit >> rotate) {
+      ASSERT_LE(nv, 256u); ASSERT_LE(np, 256u);
+      nir_shader *selected = rotate ? code : fixed_code;
+      mesh_hybrid_nir_interpreter cpu(selected);
+      cpu.store(0, nv); cpu.store(4, np);
+      for (unsigned v = 0; v < nv; ++v)
+         for (unsigned c = 0; c < 4; ++c) cpu.store(shared.vertex + 16*v + 4*c, 4*v+c);
+      std::vector<std::array<unsigned, 3>> indices(np);
+      std::vector<unsigned> payloads(np);
+      for (unsigned p = 0; p < np; ++p) {
+         input >> indices[p][0] >> indices[p][1] >> indices[p][2] >> payloads[p];
+         ASSERT_TRUE(input.good());
+         for (unsigned c = 0; c < 3; ++c) {
+            ASSERT_LT(indices[p][c], nv);
+            cpu.store(shared.indices + 3*p+c, indices[p][c], 1);
+         }
+         for (unsigned c = 0; c < 4; ++c) cpu.store(shared.primitive + 16*p + 4*c, 4*payloads[p]+c);
+      }
+      const uint64_t steps = cpu.run(selected);
+      unsigned count = cpu.load(16), route = cpu.load(20);
+      ASSERT_TRUE(route >= 1 && route <= 3);
+      if (route == AC_MESH_HYBRID_DIRECT) {
+         ASSERT_EQ(exact_fit, 1u) << "false direct: " << name;
+         ASSERT_LE(count, 256u);
+         for (unsigned p = 0; p < np; ++p) {
+            unsigned physical = cpu.load(shared.primitive_physical + 4*p);
+            ASSERT_LT(physical, count);
+            unsigned base = cpu.load(shared.physical_vertex + 4*physical);
+            unsigned data = cpu.load(shared.physical_primitive + 4*physical);
+            ASSERT_LT(data, np);
+            ASSERT_EQ(payloads[data], payloads[p]) << name;
+            ASSERT_NE(std::find(indices[p].begin(), indices[p].end(), base), indices[p].end()) << name;
+            if (!rotate) ASSERT_EQ(base, indices[p][0]) << name;
+            for (unsigned v : indices[p]) {
+               unsigned alias = cpu.load(shared.alias + 4*v);
+               unsigned corner = cpu.load(shared.representative + 4*alias);
+               ASSERT_LT(corner, count);
+               ASSERT_EQ(cpu.load(shared.physical_vertex + 4*corner), v) << name;
+            }
+         }
+      } else if (route == AC_MESH_HYBRID_OVERFLOW) {
+         ASSERT_EQ(exact_fit, 0u) << "false overflow: " << name;
+         ASSERT_GT(count, 256u);
+      } else {
+         ++unknown;
+         false_replay += exact_fit;
+      }
+      std::cout << "CPU_NIR_CASE " << name << " route=" << route << " records=" << count
+                << " reference_fit=" << exact_fit << " instructions=" << steps << std::endl;
+      ++n;
+   }
+   std::cout << "CPU_NIR_TOTAL cases=" << n << " unknown=" << unknown
+             << " false_replay=" << false_replay << std::endl;
+   ralloc_free(code);
+   ralloc_free(fixed_code);
+   ralloc_free(ms);
+}
+
+TEST_F(mesh_hybrid_test, interpreter_raster_only_preserves_raw_corner_and_payload_bits)
+{
+   const uint32_t patterns[] = {0, 0x80000000, 0x7fc01234, 0x7f800000, 0xffffffff, 0x3f800000};
+   std::mt19937 random(0x51bc250);
+   for (mesa_prim topology : {MESA_PRIM_POINTS, MESA_PRIM_LINES, MESA_PRIM_TRIANGLES}) {
+      nir_shader *ms = mesh(topology);
+      ac_mesh_hybrid_layout r = {};
+      ASSERT_TRUE(ac_nir_mesh_hybrid_layout_init(ms, &r, nullptr));
+      nir_shader *vs = ac_nir_create_mesh_hybrid_replay(&options, &r);
+      std::array<std::array<uint32_t, 4>, 256> vertices, payloads;
+      for (unsigned j = 0; j < 256; ++j)
+         for (unsigned c = 0; c < 4; ++c) {
+            vertices[j][c] = patterns[random() % 6] ^ (j << 8);
+            payloads[j][c] = patterns[random() % 6] ^ (j << 16);
+         }
+      std::array<std::array<unsigned, 3>, 256> indices;
+      for (auto &p : indices) for (auto &v : p) v = random() % 256;
+      for (unsigned id = 0; id < 256 * r.corners; ++id) {
+         mesh_hybrid_nir_interpreter cpu(vs, r.size);
+         cpu.vertex_id = id;
+         for (unsigned j = 0; j < 256; ++j) {
+            uint32_t packed = 0;
+            for (unsigned c = 0; c < r.corners; ++c) packed |= indices[j][c] << (8*c);
+            cpu.store(r.indices_offset + 4*j, packed);
+            for (unsigned c = 0; c < 4; ++c) {
+               cpu.store(r.vertex_offset + r.vertex_stride*j + 4*c, vertices[j][c]);
+               cpu.store(r.primitive_offset + r.primitive_stride*j + 4*c, payloads[j][c]);
+            }
+         }
+         cpu.run(vs);
+         unsigned p = id / r.corners, c = id % r.corners;
+         EXPECT_EQ(cpu.outputs[VARYING_SLOT_POS], vertices[indices[p][c]]);
+         EXPECT_EQ(cpu.outputs[VARYING_SLOT_VAR0], payloads[p]);
+      }
+      ralloc_free(vs); ralloc_free(ms);
+   }
+}
diff --git a/src/amd/common/nir/tests/mesh_hybrid_nir_interpreter.h b/src/amd/common/nir/tests/mesh_hybrid_nir_interpreter.h
new file mode 100644
index 0000000000000000000000000000000000000000..aa53bf6e4a5e4ff2fb8befe67aa27bfc6a728ff8
--- /dev/null
+++ b/src/amd/common/nir/tests/mesh_hybrid_nir_interpreter.h
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: MIT
+ * Deliberately small CPU interpreter for the generated routing subroutine.
+ * No Vulkan/DRM/device access. Unimplemented instructions, uninitialized reads,
+ * OOB accesses and excessive execution are hard test errors, never approximated.
+ * Barriers are no-ops ONLY because this adapter executes a single leader; wave
+ * handoff is validated separately by compiler inspection and future hardware.
+ */
+#pragma once
+#include "nir.h"
+#include <array>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+class mesh_hybrid_nir_interpreter {
+   using value = std::array<uint64_t, 16>;
+   std::vector<value> values;
+   std::vector<bool> defined;
+   nir_block *previous = nullptr;
+   uint64_t steps = 0;
+   enum flow { normal, stop_break, stop_continue, stop_return };
+   static void check(bool b, const char *why) { if (!b) throw std::runtime_error(why); }
+   static uint64_t mask(unsigned bits) { return bits == 64 ? UINT64_MAX : (1ull << bits) - 1; }
+   uint64_t src(nir_src s, unsigned c = 0) { return values.at(s.ssa->index).at(c); }
+
+   void alu(nir_alu_instr *a)
+   {
+      auto &out = values.at(a->def.index);
+      for (unsigned c = 0; c < a->def.num_components; ++c) {
+         auto input = [&](unsigned s) {
+            unsigned component = nir_op_infos[a->op].input_sizes[s] == 1 ? 0 : c;
+            return src(a->src[s].src, a->src[s].swizzle[component]);
+         };
+         uint64_t x = input(0), y = nir_op_infos[a->op].num_inputs > 1 ? input(1) : 0;
+         uint64_t z = nir_op_infos[a->op].num_inputs > 2 ? input(2) : 0;
+         uint64_t result;
+         switch (a->op) {
+         case nir_op_mov: case nir_op_u2u8: case nir_op_u2u16: case nir_op_u2u32: case nir_op_u2u64: result = x; break;
+         case nir_op_vec2: case nir_op_vec3: case nir_op_vec4: result = input(c); break;
+         case nir_op_iadd: result = x + y; break;
+         case nir_op_isub: result = x - y; break;
+         case nir_op_imul: result = x * y; break;
+         case nir_op_iand: result = x & y; break;
+         case nir_op_ior: result = x | y; break;
+         case nir_op_ixor: result = x ^ y; break;
+         case nir_op_inot: result = ~x; break;
+         case nir_op_ishl: result = x << (y & (a->def.bit_size - 1)); break;
+         case nir_op_ushr: result = x >> (y & (a->def.bit_size - 1)); break;
+         case nir_op_umin: result = x < y ? x : y; break;
+         case nir_op_umax: result = x > y ? x : y; break;
+         case nir_op_udiv: check(y != 0, "divide by zero"); result = x / y; break;
+         case nir_op_umod: check(y != 0, "modulo by zero"); result = x % y; break;
+         case nir_op_ieq: result = x == y ? mask(a->def.bit_size) : 0; break;
+         case nir_op_ine: result = x != y ? mask(a->def.bit_size) : 0; break;
+         case nir_op_ult: result = x < y ? mask(a->def.bit_size) : 0; break;
+         case nir_op_uge: result = x >= y ? mask(a->def.bit_size) : 0; break;
+         case nir_op_bcsel: result = x ? y : z; break;
+         case nir_op_b2i32: result = x != 0; break;
+         default: throw std::runtime_error(std::string("unsupported ALU ") + nir_op_infos[a->op].name);
+         }
+         out[c] = result & mask(a->def.bit_size);
+      }
+   }
+
+   void intrinsic(nir_intrinsic_instr *i)
+   {
+      value unused = {};
+      auto &out = nir_intrinsic_infos[i->intrinsic].has_dest ? values.at(i->def.index) : unused;
+      switch (i->intrinsic) {
+      case nir_intrinsic_barrier: break;
+      case nir_intrinsic_load_mesh_hybrid_buffer_amd: out[0] = 0; break;
+      case nir_intrinsic_load_vertex_id_zero_base: out[0] = vertex_id; break;
+      case nir_intrinsic_load_global:
+         for (unsigned c = 0; c < i->def.num_components; ++c)
+            out[c] = load(src(i->src[0]) + c * (i->def.bit_size / 8), i->def.bit_size / 8);
+         break;
+      case nir_intrinsic_store_output: {
+         check(src(i->src[1]) == 0, "unsupported dynamic output offset");
+         unsigned slot = nir_intrinsic_io_semantics(i).location;
+         for (unsigned c = 0; c < i->src[0].ssa->num_components; ++c)
+            if (nir_intrinsic_write_mask(i) & (1u << c))
+               outputs.at(slot).at(nir_intrinsic_component(i) + c) = src(i->src[0], c);
+         break;
+      }
+      case nir_intrinsic_load_local_invocation_index:
+      case nir_intrinsic_load_subgroup_id: out[0] = 0; break;
+      case nir_intrinsic_read_first_invocation:
+         out = values.at(i->src[0].ssa->index); break;
+      case nir_intrinsic_load_shared:
+         for (unsigned c = 0; c < i->def.num_components; ++c)
+            out[c] = load(nir_intrinsic_base(i) + src(i->src[0]) + c * (i->def.bit_size / 8), i->def.bit_size / 8);
+         break;
+      case nir_intrinsic_store_shared:
+         for (unsigned c = 0; c < i->src[0].ssa->num_components; ++c) {
+            unsigned bytes = i->src[0].ssa->bit_size / 8;
+            if (nir_intrinsic_write_mask(i) & (1u << c))
+               store(nir_intrinsic_base(i) + src(i->src[1]) + c * bytes, src(i->src[0], c), bytes);
+         }
+         break;
+      default: throw std::runtime_error(std::string("unsupported intrinsic ") + nir_intrinsic_infos[i->intrinsic].name);
+      }
+   }
+
+   flow block(nir_block *b)
+   {
+      /* Phi assignments are simultaneous at the edge, including loop swaps. */
+      std::vector<std::pair<unsigned, value>> phis;
+      nir_foreach_instr(instr, b) {
+         if (instr->type != nir_instr_type_phi) break;
+         auto phi = nir_instr_as_phi(instr);
+         bool found = false;
+         nir_foreach_phi_src(s, phi) {
+            if (s->pred == previous) {
+               phis.emplace_back(phi->def.index, values.at(s->src.ssa->index));
+               found = true;
+            }
+         }
+         check(found, "missing phi predecessor");
+      }
+      for (const auto &p : phis) values.at(p.first) = p.second;
+      previous = b;
+      nir_foreach_instr(instr, b) {
+         check(++steps < 200000000, "CPU interpreter step budget exceeded");
+         switch (instr->type) {
+         case nir_instr_type_phi: break;
+         case nir_instr_type_load_const: {
+            auto c = nir_instr_as_load_const(instr);
+            for (unsigned j = 0; j < c->def.num_components; ++j)
+               values.at(c->def.index)[j] = nir_const_value_as_uint(c->value[j], c->def.bit_size);
+            break;
+         }
+         case nir_instr_type_alu: alu(nir_instr_as_alu(instr)); break;
+         case nir_instr_type_intrinsic: intrinsic(nir_instr_as_intrinsic(instr)); break;
+         case nir_instr_type_undef: break; /* Unselected phi seeds; memory still tracks definedness. */
+         case nir_instr_type_jump:
+            switch (nir_instr_as_jump(instr)->type) {
+            case nir_jump_break: return stop_break;
+            case nir_jump_continue: return stop_continue;
+            case nir_jump_return: return stop_return;
+            default: throw std::runtime_error("unsupported jump");
+            }
+         default: throw std::runtime_error("unsupported instruction type");
+         }
+      }
+      return normal;
+   }
+
+   flow list(exec_list *l)
+   {
+      foreach_list_typed(nir_cf_node, n, node, l) {
+         flow result = normal;
+         switch (n->type) {
+         case nir_cf_node_block: result = block(nir_cf_node_as_block(n)); break;
+         case nir_cf_node_if: {
+            auto i = nir_cf_node_as_if(n);
+            result = list(src(i->condition) ? &i->then_list : &i->else_list);
+            break;
+         }
+         case nir_cf_node_loop: {
+            auto loop = nir_cf_node_as_loop(n);
+            check(!nir_loop_has_continue_construct(loop), "unsupported continue construct");
+            do { result = list(&loop->body); } while (result == normal || result == stop_continue);
+            if (result == stop_break) result = normal;
+            break;
+         }
+         default: throw std::runtime_error("unsupported CF node");
+         }
+         if (result != normal) return result;
+      }
+      return normal;
+   }
+public:
+   std::vector<uint8_t> memory;
+   unsigned vertex_id = 0;
+   std::array<std::array<uint32_t, 4>, 64> outputs = {};
+   explicit mesh_hybrid_nir_interpreter(nir_shader *s, unsigned global_bytes = 0)
+      : values(nir_shader_get_entrypoint(s)->ssa_alloc),
+        defined(std::max(s->info.shared_size, global_bytes)), memory(defined.size()) {}
+   void store(size_t address, uint64_t value, unsigned bytes = 4)
+   {
+      check(address <= memory.size() && bytes <= memory.size() - address, "shared store OOB");
+      memcpy(memory.data() + address, &value, bytes);
+      for (unsigned j = 0; j < bytes; ++j) defined.at(address + j) = true;
+   }
+   uint64_t load(size_t address, unsigned bytes = 4)
+   {
+      check(address <= memory.size() && bytes <= memory.size() - address, "shared load OOB");
+      for (unsigned j = 0; j < bytes; ++j) check(defined.at(address + j), "uninitialized shared load");
+      uint64_t value = 0;
+      memcpy(&value, memory.data() + address, bytes);
+      return value;
+   }
+   uint64_t run(nir_shader *s)
+   {
+      list(&nir_shader_get_entrypoint(s)->body);
+      return steps;
+   }
+};

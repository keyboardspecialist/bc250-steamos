+   const struct radv_shader_info *fs = &stages[MESA_SHADER_FRAGMENT].info;
+   const unsigned ps_inputs = util_bitcount(fs->ps.input_mask) + fs->ps.has_pcoord +
+                              !!(fs->ps.input_clips_culls_mask & 0x0f) + !!(fs->ps.input_clips_culls_mask & 0xf0) +
+                              fs->ps.viewport_index_input + fs->ps.prim_id_input;
+   if (ms->outinfo.prim_param_exports || fs->ps.input_per_primitive_mask || ms->outinfo.param_exports > 32 ||
+       ps_inputs > 32)
+      return vk_errorf(device, VK_ERROR_UNKNOWN, "BC250 direct primitive research has invalid physical PARAM allocation");
+
+   uint32_t used = 0;
+   u_foreach_bit (i, fs->ps.input_mask) {
+      const unsigned offset = ms->outinfo.vs_output_param_offset[VARYING_SLOT_VAR0 + i];
+      if (offset > AC_EXP_PARAM_OFFSET_31 || (used & BITFIELD_BIT(offset)))
+         return vk_errorf(device, VK_ERROR_UNKNOWN,
+                          "BC250 direct primitive research requires distinct valid physical PARAM locations");
+      used |= BITFIELD_BIT(offset);
+   }
+   if (fs->ps.prim_id_input) {
+      const unsigned offset = ms->outinfo.vs_output_param_offset[VARYING_SLOT_PRIMITIVE_ID];
+      if (offset > AC_EXP_PARAM_OFFSET_31 || (used & BITFIELD_BIT(offset)))
+         return vk_errorf(device, VK_ERROR_UNKNOWN,
+                          "BC250 direct primitive research requires a distinct valid PrimitiveId PARAM location");
+   }
+   return VK_SUCCESS;
+}

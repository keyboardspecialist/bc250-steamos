+         if (s->options->mesh_hybrid) {
+            ms_store_mapping(b, p, provoking, s->primitive_to_vertex.choice_addr);
+            ms_store_mapping(b, p, p, s->primitive_to_vertex.physical_to_primitive_addr);
+            ms_store_mapping(b, p, p, s->primitive_to_vertex.primitive_to_physical_addr);
+         }
+
+         nir_def *owner = ms_load_mapping(b, provoking, s->primitive_to_vertex.owner_addr);
+         nir_if *if_first_owner = nir_push_if(b, nir_ieq(b, owner, unassigned));
+         {
+            ms_store_mapping(b, provoking, p, s->primitive_to_vertex.owner_addr);
+            ms_store_mapping(b, provoking, p, s->primitive_to_vertex.representative_addr);
+         }
+         nir_pop_if(b, if_first_owner);
+
+         for (unsigned c = 0; c < s->vertices_per_prim; ++c)
+            ms_store_mapping(b, nir_channel(b, indices, c), nir_imm_int(b, 1),
+                              s->primitive_to_vertex.used_addr);
+         nir_store_var(b, counter, nir_iadd_imm(b, p, 1), 1);
+      }
+      nir_pop_loop(b, primitive_loop);
+
+      nir_store_var(b, physical_count, num_prm, 1);
+      nir_store_var(b, counter, zero, 1);
+      nir_loop *base_loop = nir_push_loop(b);
+      {
+         nir_def *v = nir_load_var(b, counter);
+         nir_break_if(b, nir_uge(b, v, num_vtx));
+         nir_def *used = ms_load_mapping(b, v, s->primitive_to_vertex.used_addr);
+         nir_def *owner = ms_load_mapping(b, v, s->primitive_to_vertex.owner_addr);
+         nir_if *if_base = nir_push_if(b, nir_iand(b, nir_ine_imm(b, used, 0),
+                                                   nir_ieq(b, owner, unassigned)));
+         {
+            nir_def *physical = nir_load_var(b, physical_count);
+            ms_store_mapping(b, v, physical, s->primitive_to_vertex.representative_addr);
+            ms_store_mapping(b, physical, v, s->primitive_to_vertex.physical_to_logical_addr);
+            if (s->options->mesh_hybrid)
+               ms_store_mapping(b, physical, zero, s->primitive_to_vertex.physical_to_primitive_addr);
+            nir_store_var(b, physical_count, nir_iadd_imm(b, physical, 1), 1);
+         }
+         nir_pop_if(b, if_base);
+         nir_store_var(b, counter, nir_iadd_imm(b, v, 1), 1);
+      }
+      nir_pop_loop(b, base_loop);
+
+      nir_store_shared(b, nir_load_var(b, physical_count), zero,
+                        .base = s->primitive_to_vertex.count_addr, .align_mul = 16);
+   }
+   nir_pop_if(b, if_leader);
+
+   nir_barrier(b, .execution_scope = SCOPE_WORKGROUP, .memory_scope = SCOPE_WORKGROUP,
+                  .memory_semantics = NIR_MEMORY_ACQ_REL, .memory_modes = nir_var_mem_shared);
+   nir_def *count = nir_load_shared(b, 1, 32, zero,
+                                    .base = s->primitive_to_vertex.count_addr, .align_mul = 16);
+   return nir_read_first_invocation(b, count);
+}
+
+/* Cheap constructive upper bound, computed BEFORE physical-map writes. A
+ * bound exceeding 256 is UNKNOWN, not proof of irreducibility. Subsequent
+ * exact/coalescing classifiers may tighten it without touching the old mapper.
+ * This initial guard is intentionally not a complete routing classifier.
+ */
+static nir_def *
+ms_hybrid_fixed_count(nir_builder *b, nir_def *nv, nir_def *np, lower_ngg_ms_state *s)
+{
+   nir_def *zero = nir_imm_int(b, 0);
+   nir_variable *i = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_count_index");
+   nir_variable *count = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_fixed_bound");
+   nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+   {
+      nir_store_var(b, i, zero, 1);
+      nir_push_loop(b);
+      nir_def *v = nir_load_var(b, i);
+      nir_break_if(b, nir_uge(b, v, nv));
+      ms_store_mapping(b, v, zero, s->primitive_to_vertex.used_addr);
+      ms_store_mapping(b, v, zero, s->primitive_to_vertex.owner_addr);
+      nir_store_var(b, i, nir_iadd_imm(b, v, 1), 1);
+      nir_pop_loop(b, NULL);
+
+      nir_store_var(b, i, zero, 1);
+      nir_push_loop(b);
+      nir_def *p = nir_load_var(b, i);
+      nir_break_if(b, nir_uge(b, p, np));
+      nir_def *indices = nir_u2u32(b, nir_load_shared(b, s->vertices_per_prim, 8,
+         nir_imul_imm(b, p, s->vertices_per_prim), .base = s->layout.lds.indices_addr));
+      indices = nir_umin(b, indices, nir_iadd_imm(b, nv, -1));
+      ms_store_mapping(b, nir_channel(b, indices, 0), nir_imm_int(b, 1), s->primitive_to_vertex.owner_addr);
+      for (unsigned c = 0; c < s->vertices_per_prim; ++c)
+         ms_store_mapping(b, nir_channel(b, indices, c), nir_imm_int(b, 1), s->primitive_to_vertex.used_addr);
+      nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+      nir_pop_loop(b, NULL);
+
+      nir_store_var(b, count, np, 1);
+      nir_store_var(b, i, zero, 1);
+      nir_push_loop(b);
+      v = nir_load_var(b, i);
+      nir_break_if(b, nir_uge(b, v, nv));
+      nir_def *used = ms_load_mapping(b, v, s->primitive_to_vertex.used_addr);
+      nir_def *owner = ms_load_mapping(b, v, s->primitive_to_vertex.owner_addr);
+      nir_store_var(b, count, nir_iadd(b, nir_load_var(b, count), nir_isub(b, used, owner)), 1);
+      nir_store_var(b, i, nir_iadd_imm(b, v, 1), 1);
+      nir_pop_loop(b, NULL);
+      nir_store_shared(b, nir_load_var(b, count), zero, .base = s->primitive_to_vertex.count_addr, .align_mul = 16);
+   }
+   nir_pop_if(b, NULL);
+   nir_barrier(b, .execution_scope = SCOPE_WORKGROUP, .memory_scope = SCOPE_WORKGROUP,
+               .memory_semantics = NIR_MEMORY_ACQ_REL, .memory_modes = nir_var_mem_shared);
+   return nir_read_first_invocation(b, nir_load_shared(b, 1, 32, zero,
+      .base = s->primitive_to_vertex.count_addr, .align_mul = 16));
+}
+
+static nir_def *
+ms_hybrid_indices(nir_builder *b, nir_def *p, lower_ngg_ms_state *s)
+{
+   return nir_u2u32(b, nir_load_shared(b, s->vertices_per_prim, 8,
+      nir_imul_imm(b, p, s->vertices_per_prim), .base = s->layout.lds.indices_addr));
+}
+
+static nir_def *
+ms_hybrid_equal(nir_builder *b, nir_def *a, nir_def *c, bool primitive, bool flat_only,
+                 lower_ngg_ms_state *s)
+{
+   const struct ac_mesh_hybrid_layout *r = s->options->mesh_hybrid;
+   uint64_t mask = primitive ? r->primitive_outputs : r->vertex_outputs;
+   nir_def *same = nir_imm_true(b);
+   u_foreach_bit64(slot, mask) {
+      unsigned components = flat_only ? r->flat_vertex_components[slot] : r->slots[slot].components;
+      u_foreach_bit(j, components) {
+         nir_def *x = ms_load_arrayed_output(b, a, nir_imm_int(b, 0), slot, j, 1, 32, s);
+         nir_def *y = ms_load_arrayed_output(b, c, nir_imm_int(b, 0), slot, j, 1, 32, s);
+         same = nir_iand(b, same, nir_ieq(b, x, y)); /* raw bits, including signed zero/NaNs */
+      }
+   }
+   return same;
+}
+
+/* Canonicalize complete raw vertex/payload tuples. Undefined output components
+ * are not compared unless they are part of the live stored component mask.
+ * Actual arrays are already in LDS; application execution is never repeated.
+ * Leader-only. The slow classifier is entered only when the cheap bound fails.
+ */
+static nir_def *
+ms_hybrid_classes(nir_builder *b, nir_def *nv, nir_def *np, lower_ngg_ms_state *s)
+{
+   nir_variable *i = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_class_i");
+   nir_variable *j = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_class_j");
+   nir_variable *distinct = nir_local_variable_create(b->impl, glsl_bool_type(), "hybrid_distinct_payloads");
+   nir_store_var(b, distinct, nir_imm_true(b), 1);
+   for (unsigned primitive = 0; primitive < 2; ++primitive) {
+      nir_def *limit = primitive ? np : nv;
+      unsigned base = primitive ? s->primitive_to_vertex.class_addr : s->primitive_to_vertex.alias_addr;
+      nir_store_var(b, i, nir_imm_int(b, 0), 1);
+      nir_push_loop(b);
+      nir_def *a = nir_load_var(b, i);
+      nir_break_if(b, nir_uge(b, a, limit));
+      ms_store_mapping(b, a, a, base);
+      nir_store_var(b, j, nir_imm_int(b, 0), 1);
+      nir_push_loop(b);
+      nir_def *c = nir_load_var(b, j);
+      nir_break_if(b, nir_uge(b, c, a));
+      nir_push_if(b, ms_hybrid_equal(b, a, c, primitive, false, s));
+      ms_store_mapping(b, a, ms_load_mapping(b, c, base), base);
+      if (primitive)
+         nir_store_var(b, distinct, nir_imm_false(b), 1);
+      nir_jump(b, nir_jump_break);
+      nir_pop_if(b, NULL);
+      nir_store_var(b, j, nir_iadd_imm(b, c, 1), 1);
+      nir_pop_loop(b, NULL);
+      if (primitive) {
+         nir_def *first = nir_channel(b, ms_hybrid_indices(b, a, s), 0);
+         ms_store_mapping(b, a, ms_load_mapping(b, first, s->primitive_to_vertex.alias_addr),
+                          s->primitive_to_vertex.choice_addr);
+      }
+      nir_store_var(b, i, nir_iadd_imm(b, a, 1), 1);
+      nir_pop_loop(b, NULL);
+   }
+   return nir_load_var(b, distinct);
+}
+
+/* Count distinct (base vertex, primitive tuple) records plus unowned bases.
+ * Write mode is called ONLY after count mode proved <=256. Caller is leader.
+ */
+static nir_def *
+ms_hybrid_selected_map(nir_builder *b, nir_def *nv, nir_def *np, bool write, lower_ngg_ms_state *s)
+{
+   nir_def *zero = nir_imm_int(b, 0), *none = nir_imm_int(b, -1);
+   nir_variable *i = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_map_i");
+   nir_variable *j = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_map_j");
+   nir_variable *count = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_map_count");
+   nir_variable *duplicate = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_map_duplicate");
+   nir_store_var(b, count, zero, 1);
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   nir_def *v = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, v, nv));
+   ms_store_mapping(b, v, zero, s->primitive_to_vertex.used_addr);
+   ms_store_mapping(b, v, zero, s->primitive_to_vertex.owner_addr);
+   if (write)
+      ms_store_mapping(b, v, none, s->primitive_to_vertex.representative_addr);
+   nir_store_var(b, i, nir_iadd_imm(b, v, 1), 1);
+   nir_pop_loop(b, NULL);
+
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   nir_def *p = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, p, np));
+   nir_def *indices = ms_hybrid_indices(b, p, s);
+   for (unsigned c = 0; c < s->vertices_per_prim; ++c) {
+      nir_def *alias = ms_load_mapping(b, nir_channel(b, indices, c), s->primitive_to_vertex.alias_addr);
+      ms_store_mapping(b, alias, nir_imm_int(b, 1), s->primitive_to_vertex.used_addr);
+   }
+   nir_def *choice = ms_load_mapping(b, p, s->primitive_to_vertex.choice_addr);
+   nir_def *cls = ms_load_mapping(b, p, s->primitive_to_vertex.class_addr);
+   ms_store_mapping(b, choice, nir_imm_int(b, 1), s->primitive_to_vertex.owner_addr);
+   nir_store_var(b, duplicate, none, 1);
+   nir_store_var(b, j, zero, 1);
+   nir_push_loop(b);
+   nir_def *q = nir_load_var(b, j);
+   nir_break_if(b, nir_uge(b, q, p));
+   nir_def *same = nir_iand(b, nir_ieq(b, cls, ms_load_mapping(b, q, s->primitive_to_vertex.class_addr)),
+                             nir_ieq(b, choice, ms_load_mapping(b, q, s->primitive_to_vertex.choice_addr)));
+   nir_push_if(b, same);
+   nir_store_var(b, duplicate, q, 1);
+   nir_jump(b, nir_jump_break);
+   nir_pop_if(b, NULL);
+   nir_store_var(b, j, nir_iadd_imm(b, q, 1), 1);
+   nir_pop_loop(b, NULL);
+   nir_def *dup = nir_load_var(b, duplicate);
+   nir_if *unique = nir_push_if(b, nir_ieq(b, dup, none));
+   nir_def *physical = nir_load_var(b, count);
+   if (write) {
+      ms_store_mapping(b, p, physical, s->primitive_to_vertex.primitive_to_physical_addr);
+      ms_store_mapping(b, physical, choice, s->primitive_to_vertex.physical_to_logical_addr);
+      ms_store_mapping(b, physical, p, s->primitive_to_vertex.physical_to_primitive_addr);
+      ms_store_mapping(b, choice, physical, s->primitive_to_vertex.representative_addr);
+   }
+   nir_store_var(b, count, nir_iadd_imm(b, physical, 1), 1);
+   if (write) {
+      nir_push_else(b, unique);
+      ms_store_mapping(b, p, ms_load_mapping(b, dup, s->primitive_to_vertex.primitive_to_physical_addr),
+                       s->primitive_to_vertex.primitive_to_physical_addr);
+   }
+   nir_pop_if(b, unique);
+   nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+   nir_pop_loop(b, NULL);
+
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   v = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, v, nv));
+   nir_def *used = ms_load_mapping(b, v, s->primitive_to_vertex.used_addr);
+   nir_def *owner = ms_load_mapping(b, v, s->primitive_to_vertex.owner_addr);
+   nir_push_if(b, nir_iand(b, nir_ine_imm(b, used, 0), nir_ieq_imm(b, owner, 0)));
+   physical = nir_load_var(b, count);
+   if (write) {
+      ms_store_mapping(b, physical, v, s->primitive_to_vertex.physical_to_logical_addr);
+      ms_store_mapping(b, physical, zero, s->primitive_to_vertex.physical_to_primitive_addr);
+      ms_store_mapping(b, v, physical, s->primitive_to_vertex.representative_addr);
+   }
+   nir_store_var(b, count, nir_iadd_imm(b, physical, 1), 1);
+   nir_pop_if(b, NULL);
+   nir_store_var(b, i, nir_iadd_imm(b, v, 1), 1);
+   nir_pop_loop(b, NULL);
+   return nir_load_var(b, count);
+}
+
+/* Bounded augmenting-path matching. Queue length <=P: each matched primitive
+ * can be enqueued only through its single matched vertex, visited once per
+ * augmentation. At most P augmentations and P*3 inspected edges per BFS.
+ * Repeated payloads still need a covering solver; matching is then a witness,
+ * never a generic impossibility proof.
+ */
+static void
+ms_hybrid_matching(nir_builder *b, nir_def *nv, nir_def *np, lower_ngg_ms_state *s)
+{
+   const unsigned match_v = s->primitive_to_vertex.representative_addr;
+   const unsigned match_p = s->primitive_to_vertex.primitive_to_physical_addr;
+   const unsigned visited = s->primitive_to_vertex.owner_addr;
+   const unsigned pred = s->primitive_to_vertex.used_addr;
+   nir_def *zero = nir_imm_int(b, 0), *none = nir_imm_int(b, -1);
+   nir_variable *i = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_match_root");
+   nir_variable *head = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_match_head");
+   nir_variable *tail = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_match_tail");
+   nir_variable *end = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_match_end");
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   nir_def *v = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, v, nv));
+   ms_store_mapping(b, v, none, match_v);
+   ms_store_mapping(b, v, none, visited);
+   nir_store_var(b, i, nir_iadd_imm(b, v, 1), 1);
+   nir_pop_loop(b, NULL);
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   nir_def *p = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, p, np));
+   ms_store_mapping(b, p, none, match_p);
+   nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+   nir_pop_loop(b, NULL);
+
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   p = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, p, np));
+   nir_store_var(b, head, zero, 1);
+   nir_store_var(b, tail, nir_imm_int(b, 1), 1);
+   nir_store_var(b, end, none, 1);
+   ms_store_mapping(b, zero, p, s->primitive_to_vertex.queue_addr);
+   nir_push_loop(b);
+   nir_def *h = nir_load_var(b, head);
+   nir_break_if(b, nir_ior(b, nir_uge(b, h, nir_load_var(b, tail)), nir_ine(b, nir_load_var(b, end), none)));
+   nir_def *q = ms_load_mapping(b, h, s->primitive_to_vertex.queue_addr);
+   nir_def *indices = ms_hybrid_indices(b, q, s);
+   for (unsigned c = 0; c < s->vertices_per_prim; ++c) {
+      nir_def *logical = nir_channel(b, indices, c);
+      nir_def *candidate = ms_load_mapping(b, logical, s->primitive_to_vertex.alias_addr);
+      nir_def *allowed = ms_hybrid_equal(b, nir_channel(b, indices, 0), logical, false, true, s);
+      nir_def *test = nir_iand(b, allowed, nir_iand(b, nir_ieq(b, nir_load_var(b, end), none),
+                         nir_ine(b, ms_load_mapping(b, candidate, visited), p)));
+      nir_push_if(b, test);
+      ms_store_mapping(b, candidate, p, visited);
+      ms_store_mapping(b, candidate, q, pred);
+      nir_def *old = ms_load_mapping(b, candidate, match_v);
+      nir_if *free_vertex = nir_push_if(b, nir_ieq(b, old, none));
+      nir_store_var(b, end, candidate, 1);
+      nir_push_else(b, free_vertex);
+      ms_store_mapping(b, nir_load_var(b, tail), old, s->primitive_to_vertex.queue_addr);
+      nir_store_var(b, tail, nir_iadd_imm(b, nir_load_var(b, tail), 1), 1);
+      nir_pop_if(b, free_vertex);
+      nir_pop_if(b, NULL);
+   }
+   nir_store_var(b, head, nir_iadd_imm(b, h, 1), 1);
+   nir_pop_loop(b, NULL);
+
+   nir_push_loop(b);
+   v = nir_load_var(b, end);
+   nir_break_if(b, nir_ieq(b, v, none));
+   nir_def *parent = ms_load_mapping(b, v, pred);
+   nir_def *previous = ms_load_mapping(b, parent, match_p);
+   ms_store_mapping(b, v, parent, match_v);
+   ms_store_mapping(b, parent, v, match_p);
+   nir_store_var(b, end, previous, 1);
+   nir_pop_loop(b, NULL);
+   nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+   nir_pop_loop(b, NULL);
+
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   p = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, p, np));
+   v = ms_load_mapping(b, p, match_p);
+   nir_push_if(b, nir_ine(b, v, none));
+   ms_store_mapping(b, p, v, s->primitive_to_vertex.choice_addr);
+   nir_pop_if(b, NULL);
+   nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+   nir_pop_loop(b, NULL);
+}
+
+/* Sparse record-cover DFS. U base records are unavoidable. The first selected
+ * payload at a base replaces that base at zero marginal cost; each subsequent
+ * distinct payload costs one record. An uncovered primitive must select one
+ * eligible (base,payload) record. This branching is complete, cost monotonic.
+ * At most P records/depth: each push covers at least its selected primitive.
+ * Reuse the NOT-YET-exportable map arrays as a stack/linked sparse record set.
+ * 4096 nodes is an execution cap, not an impossibility certificate.
+ */
+static nir_def *
+ms_hybrid_cover(nir_builder *b, nir_def *nv, nir_def *np, lower_ngg_ms_state *s)
+{
+   nir_def *zero = nir_imm_int(b, 0), *one = nir_imm_int(b, 1), *none = nir_imm_int(b, -1);
+   unsigned heads = s->primitive_to_vertex.owner_addr;
+   unsigned used = s->primitive_to_vertex.used_addr;
+   unsigned sel_v = s->primitive_to_vertex.physical_to_logical_addr;
+   unsigned sel_a = s->primitive_to_vertex.physical_to_primitive_addr;
+   unsigned next = s->primitive_to_vertex.primitive_to_physical_addr;
+   unsigned frame_p = s->primitive_to_vertex.choice_addr;
+   unsigned frame_c = s->primitive_to_vertex.queue_addr;
+   nir_variable *i = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_i");
+   nir_variable *depth = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_depth");
+   nir_variable *cost = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_cost");
+   nir_variable *nodes = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_nodes");
+   nir_variable *link = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_link");
+   nir_variable *new_node = nir_local_variable_create(b->impl, glsl_bool_type(), "cover_new_node");
+   nir_variable *best_p = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_best_p");
+   nir_variable *best_n = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_best_n");
+   nir_variable *covered = nir_local_variable_create(b->impl, glsl_bool_type(), "cover_covered");
+   nir_variable *feasible = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_feasible");
+   nir_variable *pushed = nir_local_variable_create(b->impl, glsl_bool_type(), "cover_pushed");
+   nir_variable *result = nir_local_variable_create(b->impl, glsl_uint_type(), "cover_result");
+
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   nir_def *v = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, v, nv));
+   ms_store_mapping(b, v, none, heads);
+   ms_store_mapping(b, v, zero, used);
+   nir_store_var(b, i, nir_iadd_imm(b, v, 1), 1);
+   nir_pop_loop(b, NULL);
+   nir_store_var(b, cost, zero, 1);
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   nir_def *p = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, p, np));
+   nir_def *indices = ms_hybrid_indices(b, p, s);
+   for (unsigned c = 0; c < s->vertices_per_prim; ++c) {
+      v = ms_load_mapping(b, nir_channel(b, indices, c), s->primitive_to_vertex.alias_addr);
+      nir_def *seen = ms_load_mapping(b, v, used);
+      nir_store_var(b, cost, nir_iadd(b, nir_load_var(b, cost), nir_isub(b, one, seen)), 1);
+      ms_store_mapping(b, v, one, used);
+   }
+   nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+   nir_pop_loop(b, NULL);
+   nir_store_var(b, depth, zero, 1);
+   nir_store_var(b, nodes, zero, 1);
+   nir_store_var(b, new_node, nir_imm_true(b), 1);
+   nir_store_var(b, result, nir_imm_int(b, AC_MESH_HYBRID_UNKNOWN), 1);
+   nir_push_loop(b);
+   {
+      nir_push_if(b, nir_load_var(b, new_node));
+      {
+         nir_break_if(b, nir_uge_imm(b, nir_load_var(b, nodes), 4096));
+         nir_store_var(b, nodes, nir_iadd_imm(b, nir_load_var(b, nodes), 1), 1);
+         nir_store_var(b, best_p, none, 1);
+         nir_store_var(b, best_n, nir_imm_int(b, 4), 1);
+         nir_store_var(b, i, zero, 1);
+         nir_push_loop(b);
+         {
+            p = nir_load_var(b, i);
+            nir_break_if(b, nir_uge(b, p, np));
+            indices = ms_hybrid_indices(b, p, s);
+            nir_def *cls = ms_load_mapping(b, p, s->primitive_to_vertex.class_addr);
+            nir_store_var(b, covered, nir_imm_false(b), 1);
+            nir_store_var(b, feasible, zero, 1);
+            for (unsigned c = 0; c < s->vertices_per_prim; ++c) {
+               nir_def *logical = nir_channel(b, indices, c);
+               v = ms_load_mapping(b, logical, s->primitive_to_vertex.alias_addr);
+               nir_def *eligible = ms_hybrid_equal(b, nir_channel(b, indices, 0), logical, false, true, s);
+               nir_push_if(b, eligible);
+               nir_def *head = ms_load_mapping(b, v, heads);
+               nir_def *marginal = nir_b2i32(b, nir_ine(b, head, none));
+               nir_def *fits = nir_ule_imm(b, nir_iadd(b, nir_load_var(b, cost), marginal), 256);
+               nir_store_var(b, feasible, nir_iadd(b, nir_load_var(b, feasible), nir_b2i32(b, fits)), 1);
+               nir_store_var(b, link, head, 1);
+               nir_push_loop(b);
+               nir_def *l = nir_load_var(b, link);
+               nir_break_if(b, nir_ieq(b, l, none));
+               nir_push_if(b, nir_ieq(b, ms_load_mapping(b, l, sel_a), cls));
+               nir_store_var(b, covered, nir_imm_true(b), 1);
+               nir_jump(b, nir_jump_break);
+               nir_pop_if(b, NULL);
+               nir_store_var(b, link, ms_load_mapping(b, l, next), 1);
+               nir_pop_loop(b, NULL);
+               nir_pop_if(b, NULL);
+            }
+            nir_push_if(b, nir_iand(b, nir_inot(b, nir_load_var(b, covered)),
+               nir_ult(b, nir_load_var(b, feasible), nir_load_var(b, best_n))));
+            nir_store_var(b, best_p, p, 1);
+            nir_store_var(b, best_n, nir_load_var(b, feasible), 1);
+            nir_pop_if(b, NULL);
+            /* A zero-option uncovered constraint makes this branch impossible. */
+            nir_break_if(b, nir_ieq_imm(b, nir_load_var(b, best_n), 0));
+            nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+         }
+         nir_pop_loop(b, NULL);
+         nir_push_if(b, nir_ieq(b, nir_load_var(b, best_p), none));
+         nir_store_var(b, result, nir_imm_int(b, AC_MESH_HYBRID_DIRECT), 1);
+         nir_jump(b, nir_jump_break);
+         nir_pop_if(b, NULL);
+         ms_store_mapping(b, nir_load_var(b, depth), nir_load_var(b, best_p), frame_p);
+         ms_store_mapping(b, nir_load_var(b, depth), zero, frame_c);
+      }
+      nir_pop_if(b, NULL);
+
+      nir_store_var(b, new_node, nir_imm_false(b), 1);
+      nir_store_var(b, pushed, nir_imm_false(b), 1);
+      nir_def *d = nir_load_var(b, depth);
+      p = ms_load_mapping(b, d, frame_p);
+      indices = ms_hybrid_indices(b, p, s);
+      nir_def *start = ms_load_mapping(b, d, frame_c);
+      for (unsigned c = 0; c < s->vertices_per_prim; ++c) {
+         nir_def *logical = nir_channel(b, indices, c);
+         v = ms_load_mapping(b, logical, s->primitive_to_vertex.alias_addr);
+         nir_def *head = ms_load_mapping(b, v, heads);
+         nir_def *eligible = ms_hybrid_equal(b, nir_channel(b, indices, 0), logical, false, true, s);
+         nir_def *n = nir_iadd(b, nir_load_var(b, cost), nir_b2i32(b, nir_ine(b, head, none)));
+         nir_def *test = nir_iand(b, nir_inot(b, nir_load_var(b, pushed)), nir_ule_imm(b, start, c));
+         test = nir_iand(b, test, nir_iand(b, eligible, nir_ule_imm(b, n, 256)));
+         nir_push_if(b, test);
+         ms_store_mapping(b, d, nir_imm_int(b, c + 1), frame_c);
+         ms_store_mapping(b, d, v, sel_v);
+         ms_store_mapping(b, d, ms_load_mapping(b, p, s->primitive_to_vertex.class_addr), sel_a);
+         ms_store_mapping(b, d, head, next);
+         ms_store_mapping(b, v, d, heads);
+         nir_store_var(b, cost, n, 1);
+         nir_store_var(b, depth, nir_iadd_imm(b, d, 1), 1);
+         nir_store_var(b, pushed, nir_imm_true(b), 1);
+         nir_store_var(b, new_node, nir_imm_true(b), 1);
+         nir_pop_if(b, NULL);
+      }
+      nir_push_if(b, nir_inot(b, nir_load_var(b, pushed)));
+      nir_push_if(b, nir_ieq_imm(b, d, 0));
+      nir_store_var(b, result, nir_imm_int(b, AC_MESH_HYBRID_OVERFLOW), 1);
+      nir_jump(b, nir_jump_break);
+      nir_pop_if(b, NULL);
+      nir_def *parent = nir_iadd_imm(b, d, -1);
+      v = ms_load_mapping(b, parent, sel_v);
+      nir_def *head = ms_load_mapping(b, parent, next);
+      ms_store_mapping(b, v, head, heads);
+      nir_store_var(b, cost, nir_isub(b, nir_load_var(b, cost), nir_b2i32(b, nir_ine(b, head, none))), 1);
+      nir_store_var(b, depth, parent, 1);
+      nir_pop_if(b, NULL);
+   }
+   nir_pop_loop(b, NULL);
+
+   nir_push_if(b, nir_ieq_imm(b, nir_load_var(b, result), AC_MESH_HYBRID_DIRECT));
+   nir_store_var(b, i, zero, 1);
+   nir_push_loop(b);
+   p = nir_load_var(b, i);
+   nir_break_if(b, nir_uge(b, p, np));
+   indices = ms_hybrid_indices(b, p, s);
+   nir_store_var(b, covered, nir_imm_false(b), 1);
+   for (unsigned c = 0; c < s->vertices_per_prim; ++c) {
+      nir_def *logical = nir_channel(b, indices, c);
+      v = ms_load_mapping(b, logical, s->primitive_to_vertex.alias_addr);
+      nir_def *eligible = ms_hybrid_equal(b, nir_channel(b, indices, 0), logical, false, true, s);
+      nir_push_if(b, nir_iand(b, eligible, nir_inot(b, nir_load_var(b, covered))));
+      nir_store_var(b, link, ms_load_mapping(b, v, heads), 1);
+      nir_push_loop(b);
+      nir_def *l = nir_load_var(b, link);
+      nir_break_if(b, nir_ieq(b, l, none));
+      nir_push_if(b, nir_ieq(b, ms_load_mapping(b, l, sel_a), ms_load_mapping(b, p, s->primitive_to_vertex.class_addr)));
+      ms_store_mapping(b, p, v, s->primitive_to_vertex.choice_addr);
+      nir_store_var(b, covered, nir_imm_true(b), 1);
+      nir_jump(b, nir_jump_break);
+      nir_pop_if(b, NULL);
+      nir_store_var(b, link, ms_load_mapping(b, l, next), 1);
+      nir_pop_loop(b, NULL);
+      nir_pop_if(b, NULL);
+   }
+   nir_store_var(b, i, nir_iadd_imm(b, p, 1), 1);
+   nir_pop_loop(b, NULL);
+   nir_pop_if(b, NULL);
+   nir_store_shared(b, nir_load_var(b, nodes), zero,
+                    .base = s->primitive_to_vertex.count_addr + 8, .align_mul = 4);
+   return nir_load_var(b, result);
+}
+
+static nir_def *
+ms_hybrid_route(nir_builder *b, nir_def *nv, nir_def *np, lower_ngg_ms_state *s)
+{
+   const struct ac_mesh_hybrid_layout *r = s->options->mesh_hybrid;
+   nir_def *zero = nir_imm_int(b, 0);
+   nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+   nir_store_shared(b, zero, zero, .base = s->primitive_to_vertex.count_addr + 8, .align_mul = 4);
+   nir_pop_if(b, NULL);
+   nir_def *bound = ms_hybrid_fixed_count(b, nv, np, s);
+   nir_if *cheap = nir_push_if(b, nir_ule_imm(b, bound, 256));
+   ms_build_primitive_to_vertex_map(b, nv, np, s);
+   nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+   nir_store_shared(b, nir_imm_int(b, AC_MESH_HYBRID_DIRECT), zero,
+                    .base = s->primitive_to_vertex.count_addr + 4, .align_mul = 4);
+   nir_pop_if(b, NULL);
+   nir_push_else(b, cheap);
+   nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+   {
+      nir_variable *count = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_selected_count");
+      nir_def *distinct = ms_hybrid_classes(b, nv, np, s);
+      nir_store_var(b, count, ms_hybrid_selected_map(b, nv, np, false, s), 1);
+      if (r->allow_cyclic_rotation) {
+         nir_push_if(b, nir_ugt_imm(b, nir_load_var(b, count), 256));
+         ms_hybrid_matching(b, nv, np, s);
+         nir_store_var(b, count, ms_hybrid_selected_map(b, nv, np, false, s), 1);
+         nir_pop_if(b, NULL);
+      }
+      nir_variable *cover_result = nir_local_variable_create(b->impl, glsl_uint_type(), "hybrid_cover_result");
+      nir_store_var(b, cover_result, nir_imm_int(b, AC_MESH_HYBRID_UNKNOWN), 1);
+      if (r->allow_cyclic_rotation) {
+         nir_push_if(b, nir_iand(b, nir_ugt_imm(b, nir_load_var(b, count), 256), nir_inot(b, distinct)));
+         nir_store_var(b, cover_result, ms_hybrid_cover(b, nv, np, s), 1);
+         nir_push_if(b, nir_ieq_imm(b, nir_load_var(b, cover_result), AC_MESH_HYBRID_DIRECT));
+         nir_store_var(b, count, ms_hybrid_selected_map(b, nv, np, false, s), 1);
+         nir_pop_if(b, NULL);
+         nir_pop_if(b, NULL);
+      }
+      nir_def *n = nir_load_var(b, count);
+      nir_def *fits = nir_ule_imm(b, n, 256);
+      nir_push_if(b, fits);
+      ms_hybrid_selected_map(b, nv, np, true, s);
+      nir_pop_if(b, NULL);
+      /* Complete unrestricted matching + distinct primitive tuples gives
+       * F=P+U-M. Restricted corners or repeated tuples are still UNKNOWN.
+       */
+      bool unrestricted = r->allow_cyclic_rotation;
+      for (unsigned slot = 0; slot < 64; ++slot)
+         unrestricted &= !r->flat_vertex_components[slot];
+      nir_def *overflow_proven = nir_ior(b, nir_iand(b, nir_imm_bool(b, unrestricted), distinct),
+         nir_ieq_imm(b, nir_load_var(b, cover_result), AC_MESH_HYBRID_OVERFLOW));
+      if (!r->allow_cyclic_rotation)
+         overflow_proven = nir_imm_true(b); /* singleton eligibility: coalesced fixed map is exact */
+      nir_def *route = nir_bcsel(b, fits, nir_imm_int(b, AC_MESH_HYBRID_DIRECT),
+         nir_bcsel(b, overflow_proven, nir_imm_int(b, AC_MESH_HYBRID_OVERFLOW), nir_imm_int(b, AC_MESH_HYBRID_UNKNOWN)));
+      nir_store_shared(b, nir_vec2(b, n, route), zero,
+                       .base = s->primitive_to_vertex.count_addr, .align_mul = 8);
+   }
+   nir_pop_if(b, NULL);
+   nir_pop_if(b, cheap);
+   nir_barrier(b, .execution_scope = SCOPE_WORKGROUP, .memory_scope = SCOPE_WORKGROUP,
+               .memory_semantics = NIR_MEMORY_ACQ_REL, .memory_modes = nir_var_mem_shared);
+   return nir_read_first_invocation(b, nir_load_shared(b, 1, 32, zero,
+      .base = s->primitive_to_vertex.count_addr, .align_mul = 16));
+}
+
+static void
+ms_hybrid_record_outputs(nir_builder *b, nir_def *record, nir_def *index, bool primitive,
+                         lower_ngg_ms_state *s)
+{
+   const struct ac_mesh_hybrid_layout *r = s->options->mesh_hybrid;
+   uint64_t mask = primitive ? r->primitive_outputs : r->vertex_outputs;
+   unsigned stride = primitive ? r->primitive_stride : r->vertex_stride;
+   unsigned offset = primitive ? r->primitive_offset : r->vertex_offset;
+   nir_def *element = nir_iadd(b, record, nir_u2u64(b, nir_imul_imm(b, index, stride)));
+   u_foreach_bit64(slot, mask) {
+      unsigned slot_offset = offset + 16 * util_bitcount64(mask & BITFIELD64_MASK(slot));
+      u_foreach_bit(c, r->slots[slot].components) {
+         nir_def *value = ms_load_arrayed_output(b, index, nir_imm_int(b, 0), slot, c, 1, 32, s);
+         nir_store_global(b, value, nir_iadd_imm(b, element, slot_offset + 4 * c),
+                          .access = ACCESS_COHERENT, .align_mul = 4);
+      }
+   }
+}
+
+static void
+ms_hybrid_snapshot(nir_builder *b, nir_def *record, nir_def *nv, nir_def *np, lower_ngg_ms_state *s)
+{
+   const struct ac_mesh_hybrid_layout *r = s->options->mesh_hybrid;
+   nir_def *index = nir_load_local_invocation_index(b);
+   nir_push_if(b, nir_ult(b, index, nv));
+   ms_hybrid_record_outputs(b, record, index, false, s);
+   nir_pop_if(b, NULL);
+   nir_push_if(b, nir_ult(b, index, np));
+   {
+      ms_hybrid_record_outputs(b, record, index, true, s);
+      nir_def *indices = nir_u2u32(b, nir_load_shared(b, s->vertices_per_prim, 8,
+         nir_imul_imm(b, index, s->vertices_per_prim), .base = s->layout.lds.indices_addr));
+      nir_def *packed = nir_channel(b, indices, 0);
+      for (unsigned c = 1; c < s->vertices_per_prim; ++c)
+         packed = nir_ior(b, packed, nir_ishl_imm(b, nir_channel(b, indices, c), 8 * c));
+      nir_def *addr = nir_iadd(b, record, nir_u2u64(b, nir_imul_imm(b, index, 4)));
+      nir_store_global(b, packed, nir_iadd_imm(b, addr, r->indices_offset),
+                       .access = ACCESS_COHERENT, .align_mul = 4);
+   }
+   nir_pop_if(b, NULL);
+   nir_barrier(b, .execution_scope = SCOPE_WORKGROUP, .memory_scope = SCOPE_DEVICE,
+               .memory_semantics = NIR_MEMORY_ACQ_REL, .memory_modes = nir_var_mem_global);
+}
+
+static void
+ms_hybrid_publish(nir_builder *b, nir_def *record, nir_def *nv, nir_def *np, nir_def *bound,
+                   bool direct, lower_ngg_ms_state *s)
+{
+   const struct ac_mesh_hybrid_layout *r = s->options->mesh_hybrid;
+   unsigned vertex_bytes = 0, primitive_bytes = 0;
+   u_foreach_bit64(slot, r->vertex_outputs)
+      vertex_bytes += 4 * util_bitcount(r->slots[slot].components);
+   u_foreach_bit64(slot, r->primitive_outputs)
+      primitive_bytes += 4 * util_bitcount(r->slots[slot].components);
+
+   nir_def *zero = nir_imm_int(b, 0);
+   nir_push_if(b, nir_ieq_imm(b, nir_load_local_invocation_index(b), 0));
+   {
+      nir_def *draw_count = direct ? zero : nir_imul_imm(b, np, r->corners);
+      nir_def *writes = direct ? zero : nir_iadd(b, nir_imul_imm(b, nv, vertex_bytes),
+                                                  nir_imul_imm(b, np, primitive_bytes + 4));
+      nir_def *reads = direct ? zero : nir_imul_imm(b, draw_count, vertex_bytes + primitive_bytes + 4);
+      nir_store_global(b, nir_vec4(b, draw_count, nir_imm_int(b, 1), zero, zero), record,
+                       .access = ACCESS_COHERENT, .align_mul = 16);
+      nir_def *route = nir_load_shared(b, 1, 32, zero,
+                                       .base = s->primitive_to_vertex.count_addr + 4, .align_mul = 4);
+      nir_store_global(b, nir_vec4(b, route,
+                                  bound, nv, np), nir_iadd_imm(b, record, 16),
+                       .access = ACCESS_COHERENT, .align_mul = 16);
+      nir_store_global(b, nir_vec4(b, nir_load_mesh_hybrid_workgroup_amd(b), writes, reads,
+                                  nir_load_shared(b, 1, 32, zero,
+                                     .base = s->primitive_to_vertex.count_addr + 8, .align_mul = 4)),
+                       nir_iadd_imm(b, record, 32),
+                       .access = ACCESS_COHERENT, .align_mul = 16);
+      nir_store_global(b, nir_vec4(b, zero, zero, zero, zero), nir_iadd_imm(b, record, 48),
+                       .access = ACCESS_COHERENT, .align_mul = 16);
+   }
+   nir_pop_if(b, NULL);
+   nir_barrier(b, .execution_scope = SCOPE_NONE, .memory_scope = SCOPE_DEVICE,
+               .memory_semantics = NIR_MEMORY_RELEASE, .memory_modes = nir_var_mem_global);
+}

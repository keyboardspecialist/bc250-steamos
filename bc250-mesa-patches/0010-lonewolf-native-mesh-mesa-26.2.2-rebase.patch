+      return vk_errorf(device, VK_ERROR_UNKNOWN, "BC250 direct primitive research exceeds the combined 32 PARAM/input limit");
+
+   uint64_t vertex_stores = 0, primitive_stores = 0;
+   nir_foreach_block (block, nir_shader_get_entrypoint(ms)) {
+      nir_foreach_instr (instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;

+static VkResult
+radv_bc250_mesh_direct_check_params(struct radv_device *device, const struct radv_shader_stage *stages)
+{
+   const struct radv_shader_info *ms = &stages[MESA_SHADER_MESH].info;
+   if (!stages[MESA_SHADER_MESH].nir || !ms->ms.mesh_primitive_to_vertex)
+      return VK_SUCCESS;

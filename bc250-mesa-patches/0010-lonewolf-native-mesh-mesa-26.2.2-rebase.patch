+      /* Shader completion plus GFX10 L2 writeback/invalidation and consumer
+       * cache invalidation, with PFP acquisition for indirect/COND_EXEC reads.
+       */
+      cmd_buffer->state.flush_bits |= RADV_CMD_FLAG_VS_PARTIAL_FLUSH | RADV_CMD_FLAG_INV_SCACHE |
+                                      RADV_CMD_FLAG_INV_VCACHE | RADV_CMD_FLAG_INV_L2;
+      radv_emit_cache_flush(cmd_buffer);
+      radv_bind_graphics_pipeline(cmd_buffer, replay);
+      struct radv_draw_info replay_info = {
+         .count = 1, .instance_count = 1, .indirect_va = record, .stride = 16,
+      };
+      if (!radv_before_draw(cmd_buffer, &replay_info, 1, 0, false))
+         break;
+      radv_emit_mesh_hybrid_userdata(cmd_buffer, replay->base.shaders[MESA_SHADER_VERTEX], record, wg);

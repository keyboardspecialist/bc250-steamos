+      radv_bind_graphics_pipeline(cmd_buffer, body);
+      /* The internal replay bind can overwrite body user-data registers.
+       * Unlike the public CmdBindPipeline entrypoint, this private bind does
+       * not mark graphics descriptors dirty.  Re-emit the application Mesh
+       * descriptors before every logical body execution so each workgroup
+       * sees exactly its original descriptor state. */
+      radv_mark_descriptors_dirty(cmd_buffer, VK_PIPELINE_BIND_POINT_GRAPHICS);
+      cmd_buffer->state.dynamic = saved;
+      cmd_buffer->state.dirty_dynamic |= RADV_DYNAMIC_ALL;
+      cmd_buffer->state.dirty |= RADV_CMD_DIRTY_GUARDBAND;
+      struct radv_draw_info mesh_info = {.count = 1, .instance_count = 1};
+      if (!radv_before_taskmesh_draw(cmd_buffer, &mesh_info, 1, false))
+         break;
+      radv_emit_mesh_hybrid_userdata(cmd_buffer, body->base.shaders[MESA_SHADER_MESH], record, wg);
+      radv_emit_userdata_mesh(cmd_buffer, x, y, z);
+      radv_cs_emit_draw_packet(cmd_buffer, 1, 0);
+      radv_after_draw(cmd_buffer);

+   if ((fs->info.per_primitive_inputs & ~supported) || ((ms->info.per_primitive_outputs & ~special) & ~supported))
+      return vk_errorf(device, VK_ERROR_UNKNOWN,
+                       "BC250 direct primitive research only transports generic primitive IO and PrimitiveId");
+
+   const unsigned v = ms->info.mesh.max_vertices_out;
+   const unsigned p = ms->info.mesh.max_primitives_out;
+   const unsigned k = mesa_vertices_per_prim(ms->info.mesh.primitive_type);
+   if (v > 256 || p > 256 || k < 1 || k > 3)
+      return vk_errorf(device, VK_ERROR_UNKNOWN, "BC250 direct primitive research has unsupported logical output limits");
+
+   /* Distinct primitive payload worst case. Zero domains must not underflow. */

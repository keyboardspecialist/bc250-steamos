+}
+
+/* These tests exercise the experimental producer only. They do not change the
+ * ordinary Mesh golden paths above and do not compile or execute GPU code.
+ */
+static nir_shader *
+create_fixed_first_shader(nir_shader_compiler_options *compiler_options, unsigned api_size,
+                          unsigned max_vertices, unsigned max_primitives, unsigned vertices,
+                          unsigned primitives, mesa_prim topology)
+{
+   nir_shader *shader = create_mesh_shader(compiler_options, vertices, primitives, topology);
+   shader->info.workgroup_size[0] = api_size;
+   shader->info.mesh.max_vertices_out = max_vertices;
+   shader->info.mesh.max_primitives_out = max_primitives;
+   shader->info.shared_size = 17; /* Exercise alignment before private metadata. */
+   shader->info.outputs_written = VARYING_BIT_POS | VARYING_BIT_PRIMITIVE_INDICES |
+                                  BITFIELD64_BIT(VARYING_SLOT_VAR0) | BITFIELD64_BIT(VARYING_SLOT_VAR1);
+   shader->info.per_primitive_outputs = BITFIELD64_BIT(VARYING_SLOT_VAR1);
+   /* Deliberately leave cross-invocation access clear: the transport must force it. */
+   shader->info.mesh.ms_cross_invocation_output_access = 0;
+
+   nir_builder b = nir_builder_at(nir_after_impl(nir_shader_get_entrypoint(shader)));
+   nir_def *zero = nir_imm_int(&b, 0);
+   nir_use(&b, nir_imm_int(&b, 0x1234)); /* Unique application-body marker. */
+   nir_barrier(&b, .execution_scope = SCOPE_WORKGROUP, .memory_scope = SCOPE_WORKGROUP,
+                  .memory_semantics = NIR_MEMORY_ACQ_REL, .memory_modes = nir_var_shader_out);
+
+   for (unsigned v = 0; v < vertices; ++v) {
+      nir_store_per_vertex_output(&b, nir_imm_vec4(&b, 0.0, 0.0, 0.0, 1.0), nir_imm_int(&b, v), zero,
+                                    .write_mask = 0xf, .io_semantics = {.location = VARYING_SLOT_POS, .num_slots = 1});
+      /* Original flat/explicit vertex bits must be loaded from the logical vertex. */
+      nir_store_per_vertex_output(&b, nir_imm_int(&b, 0x3f800000 + v), nir_imm_int(&b, v), zero,
+                                    .write_mask = 1, .io_semantics = {.location = VARYING_SLOT_VAR0, .num_slots = 1});
+   }
+
+   const unsigned k = mesa_vertices_per_prim(topology);
+   for (unsigned p = 0; p < primitives; ++p) {
+      const unsigned fixture[2][3] = {{3, 1, 2}, {3, 2, 0}};
+      nir_def *indices[3];
+      for (unsigned c = 0; c < k; ++c)
+         indices[c] = nir_imm_int(&b, fixture[p % 2][c]);
+      nir_store_per_primitive_output(&b, nir_vec(&b, indices, k), nir_imm_int(&b, p), zero,
+                                       .write_mask = BITFIELD_MASK(k),
+                                       .io_semantics = {.location = VARYING_SLOT_PRIMITIVE_INDICES, .num_slots = 1});
+      nir_store_per_primitive_output(&b, nir_imm_int(&b, 0x7fc00001 + p), nir_imm_int(&b, p), zero,
+                                       .write_mask = 1, .io_semantics = {.location = VARYING_SLOT_VAR1, .num_slots = 1});
+   }
+   return shader;
+}
+
+static void
+run_fixed_first_nir_case(unsigned api_size, unsigned hw_size, unsigned max_vertices,
+                         unsigned max_primitives, unsigned vertices, unsigned primitives,
+                         mesa_prim topology, bool workaround)
+{
+   ac_compiler_info compiler_info = {};
+   compiler_info.gfx_level = GFX10;
+   compiler_info.has_ngg_fully_culled_bug = workaround;
+   nir_shader_compiler_options compiler_options = {};
+   ac_nir_set_options(&compiler_info, false, &compiler_options);
+
+   const unsigned k = mesa_vertices_per_prim(topology);
+   const unsigned physical_max = MIN2(k * max_primitives, max_primitives + max_vertices - 1);
+   nir_shader *shader = create_fixed_first_shader(&compiler_options, api_size, max_vertices,
+                                                   max_primitives, vertices, primitives, topology);
+   nir_validate_shader(shader, "before fixed-first Mesh producer");
+
+   uint8_t param_offsets[VARYING_SLOT_MAX];
+   memset(param_offsets, AC_EXP_PARAM_UNDEFINED, sizeof(param_offsets));
+   param_offsets[VARYING_SLOT_VAR0] = 0;
+   param_offsets[VARYING_SLOT_VAR1] = 1;
+   ac_nir_lower_ngg_options options = {};
+   options.compiler_info = &compiler_info;
+   options.max_workgroup_size = hw_size;
+   options.wave_size = 64;
+   options.vs_output_param_offset = param_offsets;
+   options.has_param_exports = true;
+   options.mesh_primitive_to_vertex = true;
+   options.mesh_physical_max_vertices = physical_max;
+
+   bool scratch = true;
+   EXPECT_TRUE(ac_nir_lower_ngg_mesh(shader, &options, &scratch));
+   EXPECT_FALSE(scratch);
+   nir_validate_shader(shader, "after fixed-first Mesh producer cleanup");
+   EXPECT_EQ(shader->info.mesh.max_vertices_out, max_vertices);
+   EXPECT_EQ(shader->info.mesh.max_primitives_out, max_primitives);
+   EXPECT_EQ(shader->info.workgroup_size[0], api_size);
+   EXPECT_EQ(shader->info.per_primitive_outputs, BITFIELD64_BIT(VARYING_SLOT_VAR1));
+
+   const unsigned map_addr = 32;
+   const unsigned metadata_size = ac_nir_ngg_mesh_primitive_to_vertex_lds_size(max_vertices, physical_max);
+   const unsigned vertex_base = map_addr + metadata_size + 16;
+   const unsigned primitive_base = vertex_base + max_vertices * 2 * 16;
+   EXPECT_EQ(shader->info.shared_size, primitive_base + max_primitives * 16 + max_primitives * k);
+
+   unsigned markers = 0, params[2] = {}, map_loads = 0, representative_loads = 0;
+   bool stored_physical_count = false, map_barrier = false;
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic == nir_intrinsic_use) {
+               ++markers;
+               if (api_size < hw_size) {
+                  /* The original body remains inside the application-lane mask. */
+                  nir_cf_node *parent = block->cf_node.parent;
+                  ASSERT_EQ(parent->type, nir_cf_node_if);
+                  nir_def *condition = nir_cf_node_as_if(parent)->condition.ssa;
+                  ASSERT_EQ(nir_def_instr(condition)->type, nir_instr_type_alu);
+                  nir_alu_instr *alu = nir_instr_as_alu(nir_def_instr(condition));
+                  EXPECT_EQ(alu->op, nir_op_ult);
+                  ASSERT_TRUE(nir_src_is_const(alu->src[1].src));
+                  EXPECT_EQ(nir_src_as_uint(alu->src[1].src), api_size);
+               }
+            }
+            if (intrin->intrinsic == nir_intrinsic_store_shared && nir_intrinsic_base(intrin) == map_addr)
+               stored_physical_count = true;
+            if (intrin->intrinsic == nir_intrinsic_barrier && stored_physical_count &&
+                nir_intrinsic_execution_scope(intrin) == SCOPE_WORKGROUP)
+               map_barrier = true;
+            if (intrin->intrinsic == nir_intrinsic_sendmsg_amd &&
+                nir_intrinsic_base(intrin) == AC_SENDMSG_GS_ALLOC_REQ) {
+               EXPECT_TRUE(stored_physical_count);
+               EXPECT_TRUE(map_barrier);
+            }
+            if (intrin->intrinsic == nir_intrinsic_load_shared) {
+               const unsigned base = nir_intrinsic_base(intrin);
+               map_loads += base == map_addr + 16 + 12 * max_vertices;
+               representative_loads += base == map_addr + 16 + 8 * max_vertices;
+            }
+            if (intrin->intrinsic == nir_intrinsic_export_amd) {
+               unsigned target = nir_intrinsic_target(intrin);
+               if (target >= V_008DFC_SQ_EXP_PARAM && target < V_008DFC_SQ_EXP_PARAM + 2)
+                  ++params[target - V_008DFC_SQ_EXP_PARAM];
+            }
+            EXPECT_NE(intrin->intrinsic, nir_intrinsic_store_per_vertex_output);
+            EXPECT_NE(intrin->intrinsic, nir_intrinsic_store_per_primitive_output);
+            EXPECT_NE(intrin->intrinsic, nir_intrinsic_load_ring_mesh_scratch_amd);
+            EXPECT_NE(intrin->intrinsic, nir_intrinsic_load_ring_mesh_scratch_offset_amd);
+         }
+      }
+   }
+   EXPECT_EQ(markers, 1u);
+   EXPECT_EQ(map_loads, 1u);
+   EXPECT_EQ(representative_loads, k - 1);
+   /* The payload PARAM must not also be exported by primitive lanes. */
+   EXPECT_EQ(params[0], vertices ? 1u : 0u);
+   EXPECT_EQ(params[1], primitives ? 1u : 0u);
+   const lowered_mesh_shape shape = inspect_lowered_mesh(shader);
+   EXPECT_EQ(shape.alloc_requests, workaround ? 2u : 1u);
+   EXPECT_EQ(shape.dummy_pos_done_exports, workaround ? 1u : 0u);
+   ralloc_free(shader);
+}
+

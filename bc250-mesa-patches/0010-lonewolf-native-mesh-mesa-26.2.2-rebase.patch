+   const uint64_t generic = BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32);
+   const uint64_t special = VARYING_BIT_PRIMITIVE_COUNT | VARYING_BIT_PRIMITIVE_INDICES | VARYING_BIT_CULL_PRIMITIVE;

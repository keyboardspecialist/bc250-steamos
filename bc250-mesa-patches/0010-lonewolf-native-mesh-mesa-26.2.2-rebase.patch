index 0000000000000000000000000000000000000000..f3e992d7ff04fe1bd935d08d833cff7d370fd2b2
--- /dev/null
+++ b/src/amd/common/nir/tests/ac_nir_lower_intrinsics_to_args_test.cpp
@@ -0,0 +1,255 @@
+/*
+ * Copyright © 2026 Valve Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <cstdlib>
+#include <cstdio>
+
+#include <gtest/gtest.h>
+
+#include "ac_gpu_info.h"
+#include "ac_nir.h"
+#include "ac_shader_args.h"
+#include "nir_builder.h"
+
+struct grid_case {
+   const char *name;
+   mesa_shader_stage stage;
+   enum ac_hw_stage hw_stage;
+   bool load_grid_size_from_user_sgpr;
+   unsigned grid_arg_size;
+   enum ac_arg_type grid_arg_type;
+   bool expect_direct;
+};
+
+struct grid_shape {
+   unsigned num_workgroups = 0;
+   unsigned scalar_arg_2 = 0;
+   unsigned scalar_arg_3 = 0;
+   unsigned smem_load_3 = 0;
+   unsigned pack_64_2x32 = 0;
+};
+
+static void
+dump_nir_if_requested(nir_shader *shader, const char *case_name, const char *phase)
+{
+   const char *dir = std::getenv("BC250_PACKET002_NIR_DUMP_DIR");
+   if (!dir)
+      return;
+
+   char path[1024];
+   snprintf(path, sizeof(path), "%s/%s-%s.nir", dir, case_name, phase);
+   FILE *file = fopen(path, "w");
+   ASSERT_NE(file, nullptr) << path;
+   nir_print_shader(shader, file);
+   fclose(file);
+}
+
+static nir_shader *
+create_live_grid_shader(const grid_case &test, nir_shader_compiler_options *compiler_options)
+{
+   nir_builder builder = nir_builder_init_simple_shader(test.stage, compiler_options, "%s", test.name);
+   nir_def *grid = nir_load_num_workgroups(&builder);
+
+   /* Preserve an order-sensitive symbolic use of X, Y, Z.  The evidence run
+    * uses values 2, 3, 5, whose encoded value is 532. */
+   nir_def *x = nir_channel(&builder, grid, 0);
+   nir_def *y = nir_channel(&builder, grid, 1);
+   nir_def *z = nir_channel(&builder, grid, 2);
+   nir_def *encoded = nir_iadd(&builder, x,
+                               nir_iadd(&builder, nir_imul_imm(&builder, y, 10),
+                                        nir_imul_imm(&builder, z, 100)));
+   nir_use(&builder, encoded);
+   return builder.shader;
+}
+
+static grid_shape
+inspect_grid_shape(nir_shader *shader, const struct ac_shader_args *args)
+{
+   grid_shape result;
+
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic) {
+               nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+
+               if (intrin->intrinsic == nir_intrinsic_load_num_workgroups)
+                  result.num_workgroups++;
+
+               if (intrin->intrinsic == nir_intrinsic_load_scalar_arg_amd &&
+                   nir_intrinsic_base(intrin) == args->num_work_groups.arg_index) {
+                  if (intrin->def.num_components == 2)
+                     result.scalar_arg_2++;
+                  if (intrin->def.num_components == 3)
+                     result.scalar_arg_3++;
+               }
+
+               if (intrin->intrinsic == nir_intrinsic_load_global && intrin->def.num_components == 3 &&
+                   (nir_intrinsic_access(intrin) & ACCESS_SMEM_AMD))
+                  result.smem_load_3++;
+            } else if (instr->type == nir_instr_type_alu) {
+               nir_alu_instr *alu = nir_instr_as_alu(instr);
+               if (alu->op == nir_op_pack_64_2x32)
+                  result.pack_64_2x32++;
+            }
+         }
+      }
+   }
+
+   return result;
+}
+
+static void
+run_grid_case(const grid_case &test)
+{
+   struct radeon_info info = {};
+   info.gfx_level = GFX10;
+   info.compiler_info.gfx_level = GFX10;
+   info.compiler_info.has_packed_math_16bit = true;
+   info.compiler_info.has_accelerated_dot_product = true;
+
+   nir_shader_compiler_options compiler_options = {};
+   ac_nir_set_options(&info.compiler_info, false, &compiler_options);
+
+   struct ac_shader_args args = {};
+   args.args[0] = {
+      .type = test.grid_arg_type,
+      .file = AC_ARG_SGPR,
+      .offset = 0,
+      .size = static_cast<uint8_t>(test.grid_arg_size),
+   };
+   args.arg_count = 1;
+   args.num_sgprs_used = test.grid_arg_size;
+   args.num_work_groups = {
+      .arg_index = 0,
+      .used = true,
+   };
+
+   nir_shader *shader = create_live_grid_shader(test, &compiler_options);
+   dump_nir_if_requested(shader, test.name, "before");
+   nir_validate_shader(shader, "before ac_nir_lower_intrinsics_to_args");
+
+   ac_nir_lower_intrinsics_to_args_options options = {
+      .gfx_level = GFX10,
+      .has_ls_vgpr_init_bug = false,
+      .hw_stage = test.hw_stage,
+      .wave_size = 64,
+      .workgroup_size = 64,
+      .use_llvm = false,
+      .load_grid_size_from_user_sgpr = test.load_grid_size_from_user_sgpr,
+   };
+
+   EXPECT_TRUE(ac_nir_lower_intrinsics_to_args(shader, &args, &options));
+   nir_validate_shader(shader, "after ac_nir_lower_intrinsics_to_args");
+   dump_nir_if_requested(shader, test.name, "after");
+
+   const grid_shape shape = inspect_grid_shape(shader, &args);
+   EXPECT_EQ(shape.num_workgroups, 0u);
+
+   if (test.expect_direct) {
+      EXPECT_EQ(shape.scalar_arg_3, 1u);
+      EXPECT_EQ(shape.scalar_arg_2, 0u);
+      EXPECT_EQ(shape.smem_load_3, 0u);
+      EXPECT_EQ(shape.pack_64_2x32, 0u);
+   } else {
+      EXPECT_EQ(shape.scalar_arg_3, 0u);
+      EXPECT_EQ(shape.scalar_arg_2, 1u);
+      EXPECT_EQ(shape.smem_load_3, 1u);
+      EXPECT_EQ(shape.pack_64_2x32, 1u);
+   }
+
+   ralloc_free(shader);
+}
+
+class lower_intrinsics_to_args_test : public ::testing::Test {
+ protected:
+   lower_intrinsics_to_args_test()
+   {
+      glsl_type_singleton_init_or_ref();
+   }
+
+   ~lower_intrinsics_to_args_test()
+   {
+      glsl_type_singleton_decref();
+   }
+};
+
+TEST_F(lower_intrinsics_to_args_test, mesh_future_false_uses_direct_values)
+{
+   run_grid_case({
+      .name = "mesh_future_false",
+      .stage = MESA_SHADER_MESH,
+      .hw_stage = AC_HW_NEXT_GEN_GEOMETRY_SHADER,
+      .load_grid_size_from_user_sgpr = true,
+      .grid_arg_size = 3,
+      .grid_arg_type = AC_ARG_VALUE,
+      .expect_direct = true,
+   });
+}
+
+TEST_F(lower_intrinsics_to_args_test, mesh_current_true_uses_direct_values)
+{
+   run_grid_case({
+      .name = "mesh_current_true",
+      .stage = MESA_SHADER_MESH,
+      .hw_stage = AC_HW_NEXT_GEN_GEOMETRY_SHADER,
+      .load_grid_size_from_user_sgpr = true,
+      .grid_arg_size = 3,
+      .grid_arg_type = AC_ARG_VALUE,
+      .expect_direct = true,
+   });
+}
+
+TEST_F(lower_intrinsics_to_args_test, compute_false_preserves_pointer_smem)
+{
+   run_grid_case({
+      .name = "compute_false",
+      .stage = MESA_SHADER_COMPUTE,
+      .hw_stage = AC_HW_COMPUTE_SHADER,
+      .load_grid_size_from_user_sgpr = false,
+      .grid_arg_size = 2,
+      .grid_arg_type = AC_ARG_CONST_ADDR,
+      .expect_direct = false,
+   });
+}
+
+TEST_F(lower_intrinsics_to_args_test, compute_true_preserves_direct_values)
+{
+   run_grid_case({
+      .name = "compute_true",
+      .stage = MESA_SHADER_COMPUTE,
+      .hw_stage = AC_HW_COMPUTE_SHADER,
+      .load_grid_size_from_user_sgpr = true,
+      .grid_arg_size = 3,
+      .grid_arg_type = AC_ARG_VALUE,
+      .expect_direct = true,
+   });
+}
+
+TEST_F(lower_intrinsics_to_args_test, task_false_preserves_pointer_smem)
+{
+   run_grid_case({
+      .name = "task_false",
+      .stage = MESA_SHADER_TASK,
+      .hw_stage = AC_HW_COMPUTE_SHADER,
+      .load_grid_size_from_user_sgpr = false,
+      .grid_arg_size = 2,
+      .grid_arg_type = AC_ARG_CONST_ADDR,
+      .expect_direct = false,
+   });
+}
+
+TEST_F(lower_intrinsics_to_args_test, task_true_preserves_direct_values)
+{
+   run_grid_case({
+      .name = "task_true",
+      .stage = MESA_SHADER_TASK,
+      .hw_stage = AC_HW_COMPUTE_SHADER,
+      .load_grid_size_from_user_sgpr = true,
+      .grid_arg_size = 3,
+      .grid_arg_type = AC_ARG_VALUE,
+      .expect_direct = true,
+   });
+}
diff --git a/src/amd/common/nir/tests/ac_nir_lower_ngg_mesh_test.cpp b/src/amd/common/nir/tests/ac_nir_lower_ngg_mesh_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e6135d341dc2fb455f22a0f174c5a5aaf61a1e15
--- /dev/null
+++ b/src/amd/common/nir/tests/ac_nir_lower_ngg_mesh_test.cpp
@@ -0,0 +1,456 @@
+/*
+ * Copyright © 2026 Valve Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <gtest/gtest.h>
+
+#include <array>
+#include <utility>
+#include <vector>
+
+#include "ac_gpu_info.h"
+#include "ac_nir.h"
+#include "ac_shader_util.h"
+#include "nir_builder.h"
+#include "sid.h"
+
+struct lowered_mesh_shape {
+   unsigned alloc_requests = 0;
+   unsigned prim_done_exports = 0;
+   unsigned pos_done_exports = 0;
+   unsigned pos_valid_mask_done_exports = 0;
+   unsigned dummy_pos_done_exports = 0;
+   unsigned set_output_intrinsics = 0;
+};
+
+static nir_shader *
+create_mesh_shader(nir_shader_compiler_options *compiler_options, unsigned num_vertices,
+                   unsigned num_primitives, mesa_prim primitive_type)
+{
+   nir_builder builder = nir_builder_init_simple_shader(MESA_SHADER_MESH, compiler_options,
+                                                        "ngg_mesh_zero_outputs");
+   nir_shader *shader = builder.shader;
+
+   shader->info.next_stage = MESA_SHADER_FRAGMENT;
+   shader->info.workgroup_size[0] = 64;
+   shader->info.workgroup_size[1] = 1;
+   shader->info.workgroup_size[2] = 1;
+   shader->info.mesh.max_vertices_out = 3;
+   shader->info.mesh.max_primitives_out = 1;
+   shader->info.mesh.primitive_type = primitive_type;
+
+   nir_set_vertex_and_primitive_count(&builder, nir_imm_int(&builder, num_vertices),
+                                      nir_imm_int(&builder, num_primitives),
+                                      nir_undef(&builder, 1, 32));
+   return shader;
+}
+
+static lowered_mesh_shape
+inspect_lowered_mesh(nir_shader *shader)
+{
+   lowered_mesh_shape shape;
+
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            switch (intrin->intrinsic) {
+            case nir_intrinsic_sendmsg_amd:
+               if (nir_intrinsic_base(intrin) == AC_SENDMSG_GS_ALLOC_REQ)
+                  shape.alloc_requests++;
+               break;
+            case nir_intrinsic_export_amd:
+            case nir_intrinsic_export_row_amd:
+               if (!(nir_intrinsic_flags(intrin) & AC_EXP_FLAG_DONE))
+                  break;
+               if (nir_intrinsic_target(intrin) == V_008DFC_SQ_EXP_PRIM)
+                  shape.prim_done_exports++;
+               if (nir_intrinsic_target(intrin) == V_008DFC_SQ_EXP_POS) {
+                  shape.pos_done_exports++;
+                  if (nir_intrinsic_flags(intrin) & AC_EXP_FLAG_VALID_MASK)
+                     shape.pos_valid_mask_done_exports++;
+                  else
+                     shape.dummy_pos_done_exports++;
+               }
+               break;
+            case nir_intrinsic_set_vertex_and_primitive_count:
+               shape.set_output_intrinsics++;
+               break;
+            default:
+               break;
+            }
+         }
+      }
+   }
+
+   return shape;
+}
+
+static lowered_mesh_shape
+run_mesh_case(bool fully_culled_workaround, unsigned num_vertices, unsigned num_primitives,
+              mesa_prim primitive_type)
+{
+   radeon_info info = {};
+   info.gfx_level = GFX10;
+   info.compiler_info.gfx_level = GFX10;
+   info.compiler_info.has_packed_math_16bit = true;
+   info.compiler_info.has_accelerated_dot_product = true;
+   info.compiler_info.has_ngg_fully_culled_bug = fully_culled_workaround;
+
+   nir_shader_compiler_options compiler_options = {};
+   ac_nir_set_options(&info.compiler_info, false, &compiler_options);
+
+   nir_shader *shader = create_mesh_shader(&compiler_options, num_vertices, num_primitives,
+                                            primitive_type);
+   nir_validate_shader(shader, "before ac_nir_lower_ngg_mesh");
+
+   ac_nir_lower_ngg_options options = {
+      .compiler_info = &info.compiler_info,
+      .max_workgroup_size = 64,
+      .wave_size = 64,
+   };
+   bool needs_scratch_ring = false;
+   EXPECT_TRUE(ac_nir_lower_ngg_mesh(shader, &options, &needs_scratch_ring));
+   EXPECT_FALSE(needs_scratch_ring);
+   nir_validate_shader(shader, "after ac_nir_lower_ngg_mesh");
+
+   lowered_mesh_shape shape = inspect_lowered_mesh(shader);
+   ralloc_free(shader);
+   return shape;
+}
+
+static nir_intrinsic_instr *
+find_ssbo_barrier(nir_shader *shader)
+{
+   nir_intrinsic_instr *result = nullptr;
+
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic != nir_intrinsic_barrier ||
+                !(nir_intrinsic_memory_modes(intrin) & nir_var_mem_ssbo))
+               continue;
+
+            EXPECT_EQ(result, nullptr);
+            result = intrin;
+         }
+      }
+   }
+
+   return result;
+}
+
+class lower_ngg_mesh_test : public ::testing::Test {
+ protected:
+   lower_ngg_mesh_test()
+   {
+      glsl_type_singleton_init_or_ref();
+   }
+
+   ~lower_ngg_mesh_test()
+   {
+      glsl_type_singleton_decref();
+   }
+};
+
+TEST_F(lower_ngg_mesh_test, gfx10_zero_outputs_emit_safe_dummy_for_all_topologies)
+{
+   const mesa_prim topologies[] = {MESA_PRIM_POINTS, MESA_PRIM_LINES, MESA_PRIM_TRIANGLES};
+
+   for (mesa_prim topology : topologies) {
+      const lowered_mesh_shape shape = run_mesh_case(true, 0, 0, topology);
+      /* The workaround has a runtime zero-count branch and a normal branch. */
+      EXPECT_EQ(shape.alloc_requests, 2u);
+      EXPECT_EQ(shape.prim_done_exports, 2u);
+      EXPECT_EQ(shape.pos_done_exports, 2u);
+      EXPECT_EQ(shape.pos_valid_mask_done_exports, 1u);
+      EXPECT_EQ(shape.dummy_pos_done_exports, 1u);
+      EXPECT_EQ(shape.set_output_intrinsics, 0u);
+   }
+}
+
+TEST_F(lower_ngg_mesh_test, gfx10_normalizes_one_zero_count_before_safe_dummy)
+{
+   for (const auto counts : {std::pair<unsigned, unsigned>{0, 1}, {3, 0}}) {
+      const lowered_mesh_shape shape =
+         run_mesh_case(true, counts.first, counts.second, MESA_PRIM_TRIANGLES);

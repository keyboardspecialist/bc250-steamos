+
+TEST_F(lower_ngg_mesh_test, fixed_first_shared_provoker_mapping_model)
+{
+   const std::array<std::array<unsigned, 3>, 2> indices = {{{3, 1, 2}, {3, 2, 0}}};
+   std::array<int, 4> owner = {-1, -1, -1, -1};
+   std::array<bool, 4> used = {};
+   std::array<unsigned, 4> representative = {};
+   std::vector<unsigned> physical;
+   for (unsigned p = 0; p < indices.size(); ++p) {
+      unsigned v = indices[p][0];
+      physical.push_back(v);
+      if (owner[v] < 0) {
+         owner[v] = p;
+         representative[v] = p;
+      }
+      for (unsigned corner : indices[p])
+         used[corner] = true;
+   }
+   for (unsigned v = 0; v < used.size(); ++v) {
+      if (used[v] && owner[v] < 0) {
+         representative[v] = physical.size();
+         physical.push_back(v);
+      }
+   }
+   EXPECT_EQ(physical, (std::vector<unsigned>{3, 3, 0, 1, 2}));
+   EXPECT_EQ(representative, (std::array<unsigned, 4>{2, 3, 4, 0}));
+   for (unsigned p = 0; p < indices.size(); ++p) {
+      for (unsigned c = 0; c < 3; ++c) {
+         unsigned h = c == 0 ? p : representative[indices[p][c]];
+         EXPECT_EQ(physical[h], indices[p][c]);
+         if (c == 0) {
+            EXPECT_EQ(h, p); /* Selects A[p], even when the logical vertex is shared. */
+         }
+      }
+   }
+}

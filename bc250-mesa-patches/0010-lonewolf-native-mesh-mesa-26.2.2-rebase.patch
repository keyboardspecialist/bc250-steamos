diff --git a/bin/bc250_ff7_mesh_readiness.py b/bin/bc250_ff7_mesh_readiness.py
new file mode 100644
index 0000000000000000000000000000000000000000..2c9c3fbdc44872666acc2783b560d92fc8411ff8
--- /dev/null
+++ b/bin/bc250_ff7_mesh_readiness.py
@@ -0,0 +1,246 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Offline inventory for retained FF7/vkd3d SPIR-V captures.
+
+This intentionally does not create a Vulkan instance or device.  It is an
+evidence tool, not a shader-hash policy: it records what the capture contains
+and whether a Mesh module needs the BC250 S11 primitive-output transform.
+
+The dump format used by vkd3d records shader modules independently.  Therefore
+the report never invents a Mesh<->fragment pipeline pairing or draw-command
+model when the capture does not preserve one.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import pathlib
+import re
+import shutil
+import subprocess
+import sys
+from collections import Counter
+
+
+EXECUTION_MODE_RE = re.compile(r"OpExecutionMode(?:Id)?\s+%\S+\s+(\w+)(?:\s+(.+))?$")
+ENTRY_POINT_RE = re.compile(r'OpEntryPoint\s+(\w+)\s+%\S+\s+"([^"]+)"')
+DECORATE_RE = re.compile(r"OpDecorate\s+(%\S+)\s+(\w+)(?:\s+(.*))?$")
+STORE_RE = re.compile(r"OpStore\s+(%\S+)")
+SET_MESH_OUTPUTS_RE = re.compile(r"OpSetMeshOutputsEXT\s+(%\S+)\s+(%\S+)")
+CONSTANT_RE = re.compile(r"^\s*(%\S+)\s+=\s+Op(?:Spec)?Constant(?:True|False)?\b")
+
+
+def run(argv: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(argv, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def disassemble(path: pathlib.Path, spirv_dis: str) -> tuple[str, str | None]:
+    proc = run([spirv_dis, "--raw-id", str(path)])
+    if proc.returncode:
+        return "", proc.stderr.strip() or f"{spirv_dis} exited {proc.returncode}"
+    return proc.stdout, None
+
+
+def validate(path: pathlib.Path, spirv_val: str) -> tuple[bool, str]:
+    proc = run([spirv_val, str(path)])
+    return proc.returncode == 0, proc.stderr.strip()
+
+
+def builtin_ids(disassembly: str) -> dict[str, set[str]]:
+    result: dict[str, set[str]] = {}
+    for line in disassembly.splitlines():
+        match = DECORATE_RE.search(line)
+        if not match or match.group(2) != "BuiltIn" or not match.group(3):
+            continue
+        result.setdefault(match.group(3).split()[0], set()).add(match.group(1))
+    return result
+
+
+def descriptor_bindings(disassembly: str) -> list[dict[str, int]]:
+    decorations: dict[str, dict[str, int]] = {}
+    for line in disassembly.splitlines():
+        match = DECORATE_RE.search(line)
+        if not match or match.group(2) not in {"DescriptorSet", "Binding"} or not match.group(3):
+            continue
+        try:
+            decorations.setdefault(match.group(1), {})[match.group(2)] = int(match.group(3).split()[0], 0)
+        except ValueError:
+            continue
+    return [
+        {"set": value["DescriptorSet"], "binding": value["Binding"]}
+        for _, value in sorted(decorations.items())
+        if "DescriptorSet" in value and "Binding" in value
+    ]
+
+
+def has_store_to(disassembly: str, ids: set[str]) -> bool:
+    return any((match := STORE_RE.search(line)) and match.group(1) in ids for line in disassembly.splitlines())
+
+
+def mesh_output_calls(disassembly: str) -> tuple[int, bool | None]:
+    """Return call count and whether at least one count is non-constant.
+
+    OpSetMeshOutputsEXT is the SPIR-V representation of SetMeshOutputsEXT;
+    it has no VertexCount/PrimitiveCount output variables to inspect.
+    """
+    constants = {
+        match.group(1)
+        for line in disassembly.splitlines()
+        if (match := CONSTANT_RE.search(line))
+    }
+    calls = [match for line in disassembly.splitlines() if (match := SET_MESH_OUTPUTS_RE.search(line))]
+    if not calls:
+        return 0, None
+    return len(calls), any(match.group(1) not in constants or match.group(2) not in constants for match in calls)
+
+
+def module_record(path: pathlib.Path, spirv_dis: str, spirv_val: str) -> dict[str, object]:
+    contents = path.read_bytes()
+    text, dis_error = disassemble(path, spirv_dis)
+    valid, val_error = validate(path, spirv_val)
+    stages: list[str] = []
+    entries: list[str] = []
+    modes: dict[str, list[str]] = {}
+    if text:
+        for line in text.splitlines():
+            entry = ENTRY_POINT_RE.search(line)
+            if entry:
+                stages.append(entry.group(1))
+                entries.append(entry.group(2))
+            mode = EXECUTION_MODE_RE.search(line)
+            if mode:
+                modes.setdefault(mode.group(1), []).append((mode.group(2) or "").strip())
+
+    is_mesh = "MeshEXT" in stages
+    builtins = builtin_ids(text)
+    perprimitive_ids = {
+        m.group(1)
+        for line in text.splitlines()
+        if (m := DECORATE_RE.search(line)) and m.group(2) == "PerPrimitiveEXT"
+    }
+    # These are Mesh primitive-output / Mesh-to-FS special contracts, not the
+    # ordinary gl_CullDistance path.  They must never accidentally become a
+    # direct route if metadata is absent.
+    special_builtins = (
+        "PrimitiveId",
+        "Layer",
+        "ViewportIndex",
+        "ViewportMaskNV",
+        "PrimitiveShadingRateKHR",
+        "PrimitiveShadingRateEXT",
+        "CullPrimitiveEXT",
+    )
+    special = {name: bool(builtins.get(name)) or name in text for name in special_builtins}
+    set_outputs_calls, set_outputs_dynamic = mesh_output_calls(text)
+    descriptors = descriptor_bindings(text)
+    output_vertices = modes.get("OutputVertices", [])
+    output_primitives = modes.get("OutputPrimitivesEXT", [])
+    topologies = [k for k in ("OutputPoints", "OutputLinesEXT", "OutputTrianglesEXT") if k in modes]
+    local_size = modes.get("LocalSize", [])
+
+    needs_s11 = bool(perprimitive_ids) or any(special.values())
+    # This tool only makes a source/module-level classification.  A route that
+    # needs S11 still requires a complete linked FS interface and runtime
+    # output counts, so calling it direct/replay here would be unsound.
+    route = (
+        "DIRECT_NO_S11_TRANSFORM"
+        if is_mesh and not needs_s11
+        else "LINKED_INTERFACE_REQUIRED" if is_mesh else "NOT_MESH"
+    )
+    return {
+        "file": path.name,
+        "sha256": hashlib.sha256(contents).hexdigest(),
+        "bytes": len(contents),
+        "spirv_valid": valid,
+        "spirv_validation_error": val_error,
+        "disassembly_error": dis_error,
+        "entry_stages": stages,
+        "entry_points": entries,
+        "is_mesh": is_mesh,
+        "execution_modes": modes,
+        "local_size": local_size,
+        "output_vertices": output_vertices,
+        "output_primitives": output_primitives,
+        "output_topology": topologies,
+        "mesh_set_outputs_calls": set_outputs_calls,
+        "mesh_set_outputs_dynamic_counts": set_outputs_dynamic,
+        "descriptor_bindings": descriptors,
+        "requires_paired_pipeline_layout": bool(descriptors),
+        "workgroup_id": bool(builtins.get("WorkgroupId")),
+        "local_invocation_id": bool(builtins.get("LocalInvocationId")),
+        "num_subgroups": bool(builtins.get("NumSubgroups")),
+        "draw_index": bool(builtins.get("DrawIndex")),
+        "perprimitive_decorations": len(perprimitive_ids),
+        "special_primitive_semantics": special,
+        "cull_distance": bool(builtins.get("CullDistance")),
+        "route_static": route,
+        "route_reason": (
+            "No PerPrimitiveEXT or special primitive semantic in this unpaired Mesh module"
+            if route == "DIRECT_NO_S11_TRANSFORM"
+            else "Requires complete linked pipeline/routing provenance"
+            if route == "LINKED_INTERFACE_REQUIRED"
+            else "No MeshEXT entry point"
+        ),
+    }
+
+
+def write_tsv(path: pathlib.Path, records: list[dict[str, object]]) -> None:
+    fields = [
+        "file", "sha256", "spirv_valid", "local_size", "output_vertices",
+        "output_primitives", "output_topology", "perprimitive_decorations",
+        "draw_index", "workgroup_id", "num_subgroups", "cull_distance",
+        "route_static", "route_reason",
+    ]
+    with path.open("w", newline="", encoding="utf-8") as output:
+        writer = csv.DictWriter(output, fieldnames=fields, delimiter="\t", extrasaction="ignore")
+        writer.writeheader()
+        for record in records:
+            row = dict(record)
+            for field in ("local_size", "output_vertices", "output_primitives", "output_topology"):
+                row[field] = ";".join(row[field])
+            writer.writerow(row)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--shader-dir", required=True, type=pathlib.Path)
+    parser.add_argument("--out-json", required=True, type=pathlib.Path)
+    parser.add_argument("--out-tsv", required=True, type=pathlib.Path)
+    parser.add_argument("--spirv-dis", default=shutil.which("spirv-dis") or "spirv-dis")
+    parser.add_argument("--spirv-val", default=shutil.which("spirv-val") or "spirv-val")
+    args = parser.parse_args()
+    if not args.shader_dir.is_dir():
+        parser.error(f"not a directory: {args.shader_dir}")
+
+    records = [module_record(path, args.spirv_dis, args.spirv_val) for path in sorted(args.shader_dir.glob("*.spv"))]
+    mesh = [record for record in records if record["is_mesh"]]
+    summary = {
+        "schema": 1,
+        "scope": "Unpaired retained vkd3d SPIR-V module capture; no Vulkan work performed.",
+        "total_spirv_modules": len(records),
+        "mesh_shader_unique_count": len(mesh),
+        "mesh_pipeline_count": "UNAVAILABLE_UNPAIRED_MODULE_CAPTURE",
+        "root_signature_blobs": len(list(args.shader_dir.glob("*.rs"))),
+        "mesh_direct_candidates": sum(record["route_static"] == "DIRECT_NO_S11_TRANSFORM" for record in mesh),
+        "mesh_requires_linked_routing_analysis": sum(record["route_static"] == "LINKED_INTERFACE_REQUIRED" for record in mesh),
+        "mesh_modules_requiring_paired_pipeline_layout": sum(record["requires_paired_pipeline_layout"] for record in mesh),
+        "invalid_spirv_modules": sum(not record["spirv_valid"] for record in records),
+        "entry_stage_counts": dict(Counter(stage for record in records for stage in record["entry_stages"])),
+        "mesh_local_sizes": dict(Counter(" ".join(record["local_size"]) for record in mesh)),
+        "mesh_output_vertices": dict(Counter(" ".join(record["output_vertices"]) for record in mesh)),
+        "mesh_output_primitives": dict(Counter(" ".join(record["output_primitives"]) for record in mesh)),
+        "modules": records,
+    }
+    args.out_json.parent.mkdir(parents=True, exist_ok=True)
+    args.out_tsv.parent.mkdir(parents=True, exist_ok=True)
+    args.out_json.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    write_tsv(args.out_tsv, mesh)
+    print(json.dumps({key: summary[key] for key in summary if key != "modules"}, sort_keys=True))
+    return 0 if not summary["invalid_spirv_modules"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

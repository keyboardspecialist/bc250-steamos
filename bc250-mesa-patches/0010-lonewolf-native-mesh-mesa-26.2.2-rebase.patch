+               nir_def *index, bool primitive)
+{
+   const uint64_t mask = primitive ? r->primitive_outputs : r->vertex_outputs;
+   const unsigned stride = primitive ? r->primitive_stride : r->vertex_stride;
+   const unsigned offset = primitive ? r->primitive_offset : r->vertex_offset;
+   nir_def *element = nir_iadd(b, record, nir_u2u64(b, nir_imul_imm(b, index, stride)));
+   u_foreach_bit64(slot, mask) {
+      const struct ac_mesh_hybrid_slot *out = &r->slots[slot];
+      unsigned slot_offset = offset + 16 * util_bitcount64(mask & BITFIELD64_MASK(slot));
+      u_foreach_bit(c, out->components) {
+         nir_def *value = nir_load_global(b, 1, 32, nir_iadd_imm(b, element, slot_offset + c * 4),
+                                         .access = ACCESS_COHERENT, .align_mul = 4);
+         nir_store_output(b, value, nir_imm_int(b, 0), .component = c, .write_mask = 1,
+                          .base = util_bitcount64((r->vertex_outputs | r->primitive_outputs) & BITFIELD64_MASK(slot)),
+                          .src_type = out->type[c], .io_semantics = {
+                             .location = slot, .num_slots = 1,
+                             .no_sysval_output = !(out->sysval & BITFIELD_BIT(c)),
+                             .no_varying = !(out->varying & BITFIELD_BIT(c)),
+                          });
+      }
+   }
+}
+
+nir_shader *
+ac_nir_create_mesh_hybrid_replay(const nir_shader_compiler_options *options,
+                                const struct ac_mesh_hybrid_layout *r)
+{
+   if (r->abi != AC_MESH_HYBRID_ABI || r->corners < 1 || r->corners > 3 ||
+       r->max_vertices > 256 || r->max_primitives > 256)
+      return NULL;
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_VERTEX, options, "mesh_hybrid_raster_only");
+   b.shader->info.next_stage = MESA_SHADER_FRAGMENT;
+   b.shader->info.io_lowered = true;
+   nir_def *record = nir_load_mesh_hybrid_buffer_amd(&b);
+   nir_def *id = nir_load_vertex_id_zero_base(&b);
+   nir_def *p = nir_udiv_imm(&b, id, r->corners);
+   nir_def *c = nir_umod_imm(&b, id, r->corners);
+   nir_def *addr = nir_iadd(&b, record, nir_u2u64(&b, nir_imul_imm(&b, p, 4)));
+   nir_def *packed = nir_load_global(&b, 1, 32, nir_iadd_imm(&b, addr, r->indices_offset),
+                                    .access = ACCESS_COHERENT, .align_mul = 4);
+   nir_def *v = nir_iand_imm(&b, nir_ushr(&b, packed, nir_imul_imm(&b, c, 8)), 255);
+   replay_outputs(&b, r, record, v, false);
+   /* All-corner payload reads initially: preserve raw bits and either provoking
+    * convention. Owner-only reads are an optimization, not assumed traffic.
+    */
+   replay_outputs(&b, r, record, p, true);
+   nir_shader_gather_info(b.shader, nir_shader_get_entrypoint(b.shader));
+   nir_validate_shader(b.shader, "generated hybrid raster-only VS");
+   return b.shader;
+}

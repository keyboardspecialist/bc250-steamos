+/* SPDX-License-Identifier: MIT */
+#include "ac_nir_mesh_hybrid.h"
+#include "nir_builder.h"
+
+static bool
+fail(const char **reason, const char *message)
+{
+   if (reason)
+      *reason = message;
+   return false;
+}
+
+unsigned
+ac_nir_mesh_hybrid_map_lds_size(unsigned vertices, unsigned primitives)
+{
+   /* Alias[V], class[P], choice[P], physical->primitive[256], primitive->physical[P],
+    * BFS queue[P]. Matching reuses old owner/used/representative arrays.
+    */
+   return align(4 * (vertices + 4 * primitives + 256), 16);
+}
+
+bool
+ac_nir_mesh_hybrid_layout_init(const nir_shader *mesh, struct ac_mesh_hybrid_layout *layout,
+                               const char **reason)
+{
+   if (reason)
+      *reason = NULL;
+   if (mesh->info.stage != MESA_SHADER_MESH)
+      return fail(reason, "hybrid requires Mesh IO");
+   if (!mesh->info.mesh.max_vertices_out || mesh->info.mesh.max_vertices_out > 256 ||
+       !mesh->info.mesh.max_primitives_out || mesh->info.mesh.max_primitives_out > 256)
+      return fail(reason, "hybrid logical maxima must be in 1..256");
+   if (mesh->info.mesh.primitive_type != MESA_PRIM_POINTS &&
+       mesh->info.mesh.primitive_type != MESA_PRIM_LINES &&
+       mesh->info.mesh.primitive_type != MESA_PRIM_TRIANGLES)
+      return fail(reason, "hybrid requires a Mesh list topology");
+   const uint64_t generic = BITFIELD64_RANGE(VARYING_SLOT_VAR0, 32);
+   struct ac_mesh_hybrid_layout r = {
+      .abi = AC_MESH_HYBRID_ABI,
+      .max_vertices = mesh->info.mesh.max_vertices_out,
+      .max_primitives = mesh->info.mesh.max_primitives_out,
+      .corners = mesa_vertices_per_prim(mesh->info.mesh.primitive_type),
+      .vertex_outputs = mesh->info.outputs_written & ~mesh->info.per_primitive_outputs & ~VARYING_BIT_PRIMITIVE_INDICES,
+      .primitive_outputs = mesh->info.outputs_written & mesh->info.per_primitive_outputs & ~VARYING_BIT_PRIMITIVE_INDICES,
+   };
+   if ((r.vertex_outputs & ~(generic | VARYING_BIT_POS)) ||
+       (r.primitive_outputs & ~(generic | VARYING_BIT_PRIMITIVE_ID)) || mesh->info.outputs_written_16bit)
+      return fail(reason, "hybrid supports Position, PrimitiveId and 32-bit generic outputs only");
+   nir_foreach_function_impl(impl, mesh) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if ((intr->intrinsic == nir_intrinsic_store_deref || intr->intrinsic == nir_intrinsic_load_deref) &&
+                nir_deref_mode_is(nir_src_as_deref(intr->src[0]), nir_var_shader_out))
+               return fail(reason, "hybrid requires arrayed output IO, not derefs");
+            if (intr->intrinsic == nir_intrinsic_store_output)
+               return fail(reason, "hybrid requires logical arrayed output stores");
+            if (intr->intrinsic == nir_intrinsic_load_task_payload || intr->intrinsic == nir_intrinsic_load_view_index)
+               return fail(reason, "hybrid does not admit Task or multiview");
+            if (intr->intrinsic != nir_intrinsic_store_per_vertex_output &&
+                intr->intrinsic != nir_intrinsic_store_per_primitive_output)
+               continue;
+            nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+            if (sem.location == VARYING_SLOT_PRIMITIVE_INDICES)
+               continue;
+            if (intr->src[0].ssa->bit_size != 32 || sem.high_16bits)
+               return fail(reason, "hybrid requires full 32-bit output components");
+            const nir_src *off = nir_get_io_offset_src(intr);
+            unsigned first = nir_src_is_const(*off) ? nir_src_as_uint(*off) : 0;
+            unsigned count = nir_src_is_const(*off) ? 1 : sem.num_slots;
+            if (!count || first >= 64 || sem.location + first + count > 64)
+               return fail(reason, "hybrid output offset outside logical layout");
+            unsigned mask = nir_intrinsic_write_mask(intr) << nir_intrinsic_component(intr);
+            if (!mask || mask > 15)
+               return fail(reason, "hybrid output must fit a vec4 slot");
+            uint64_t domain = intr->intrinsic == nir_intrinsic_store_per_primitive_output ?
+                                 r.primitive_outputs : r.vertex_outputs;
+            for (unsigned i = 0; i < count; ++i) {
+               unsigned slot = sem.location + first + i;
+               if (!(domain & BITFIELD64_BIT(slot)))
+                  return fail(reason, "hybrid logical output rate mismatch");
+               struct ac_mesh_hybrid_slot *out = &r.slots[slot];
+               nir_alu_type type = nir_intrinsic_src_type(intr);
+               if (type == nir_type_invalid)
+                  type = nir_type_uint32;
+               u_foreach_bit(c, mask) {
+                  if ((out->components & BITFIELD_BIT(c)) && out->type[c] != type)
+                     return fail(reason, "hybrid component has conflicting IO types");
+                  out->type[c] = type;
+               }
+               out->components |= mask;
+               if (!sem.no_sysval_output)
+                  out->sysval |= mask;
+               if (!sem.no_varying)
+                  out->varying |= mask;
+            }
+         }
+      }
+   }
+   r.vertex_offset = AC_MESH_HYBRID_HEADER_SIZE;
+   r.vertex_stride = 16 * util_bitcount64(r.vertex_outputs);
+   r.primitive_offset = r.vertex_offset + r.max_vertices * r.vertex_stride;
+   r.primitive_stride = 16 * util_bitcount64(r.primitive_outputs);
+   r.indices_offset = r.primitive_offset + r.max_primitives * r.primitive_stride;
+   r.size = align(r.indices_offset + 4 * r.max_primitives, 256);
+   *layout = r;
+   return true;
+}
+
+static void

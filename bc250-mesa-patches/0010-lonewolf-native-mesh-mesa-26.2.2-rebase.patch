+      nir_shader *vs = ac_nir_create_mesh_hybrid_replay(&options, &r);
+      ASSERT_NE(vs, nullptr);
+      EXPECT_EQ(vs->info.stage, MESA_SHADER_VERTEX);
+      EXPECT_EQ(vs->info.outputs_written, VARYING_BIT_POS | VARYING_BIT_VAR(0));
+      EXPECT_EQ(vs->info.per_primitive_outputs, 0ull);
+      unsigned loads = 0, outputs = 0, private_buffer = 0;
+      nir_foreach_block(block, nir_shader_get_entrypoint(vs)) {

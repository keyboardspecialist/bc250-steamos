+   if (needs_hybrid && !(instance->experimental_flags & RADV_EXPERIMENTAL_BC250_MESH_HYBRID))
+      return vk_errorf(device, VK_ERROR_UNKNOWN,
+                       "BC250 direct primitive research capacity proof exceeds 256 vertices (%u); not an irreducibility proof",
+                       physical_max);
+   if (needs_hybrid)
+      physical_max = 256;
+
+   if ((ms->info.outputs_written & ~(generic | VARYING_BIT_PRIMITIVE_ID | VARYING_BIT_POS |
+                                     VARYING_BIT_PRIMITIVE_INDICES)) ||
+       ms->info.outputs_written_16bit || fs->info.inputs_read_16bit)
+      return vk_errorf(device, VK_ERROR_UNKNOWN,

+/* These builtins do not share the generic primitive-varying representation.
+ *
+ * The direct/hybrid S11 transform intentionally turns only generic
+ * per-primitive values into flat, provoking-vertex-owned PARAMs.  A pipeline
+ * without a generic primitive varying used to skip that transform's source
+ * check altogether, which left a path for PrimitiveId, Layer, Viewport, or
+ * primitive shading-rate state to reach the unvalidated native GFX10 route.
+ * Keep this check before linking/lowering and run it for every source Mesh
+ * pipeline, including a warm NIR-cache hit.  The source-monolithic policy
+ * above deliberately makes missing provenance fail closed instead.
+ */
+static VkResult
+radv_bc250_mesh_special_semantic_check(struct radv_device *device, const struct radv_shader_stage *stages)
+{
+   const struct radv_physical_device *pdev = radv_device_physical(device);
+   nir_shader *ms = stages[MESA_SHADER_MESH].nir;
+   nir_shader *fs = stages[MESA_SHADER_FRAGMENT].nir;
+   const uint64_t special = VARYING_BIT_LAYER | VARYING_BIT_VIEWPORT | VARYING_BIT_VIEWPORT_MASK |
+                            VARYING_BIT_PRIMITIVE_SHADING_RATE;
+
+   if (!radv_is_bc250_experimental_mesh(pdev) || !ms)
+      return VK_SUCCESS;
+
+   nir_shader_gather_info(ms, nir_shader_get_entrypoint(ms));
+   const uint64_t mesh_io = ms->info.outputs_written | ms->info.outputs_read | ms->info.per_primitive_outputs;
+   if (mesh_io & special)
+      return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "BC250 experimental Mesh does not support special primitive Layer/Viewport/VRS IO");
+
+   if (!fs)
+      return VK_SUCCESS;
+
+   nir_shader_gather_info(fs, nir_shader_get_entrypoint(fs));
+   const uint64_t fs_io = fs->info.inputs_read;
+   const bool fs_special_sysval = BITSET_TEST(fs->info.system_values_read, SYSTEM_VALUE_LAYER_ID);
+   if ((fs_io & special) || fs_special_sysval)
+      return vk_errorf(device, VK_ERROR_FEATURE_NOT_PRESENT,
+                       "BC250 experimental Mesh does not support special primitive Layer/Viewport/VRS IO");
+
+   return VK_SUCCESS;
+}

+/* SPDX-License-Identifier: MIT */
+#ifndef AC_NIR_MESH_HYBRID_H
+#define AC_NIR_MESH_HYBRID_H
+#include "nir.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Private logical-output ABI. Never used by a proven-direct shader.
+ * 0..15: VkDrawIndirectCommand (zero vertexCount for DIRECT).
+ * 16..31: route, physical-count witness (or UINT_MAX), actual V, actual P.
+ * 32..47: original flat WG, geometry bytes written, replay bytes requested,
+ *         exact covering-search nodes (0 if that slow path is unused).
+ *         This is NOT a count of all classifier ALU or memory instructions.
+ * 48..63: reserved zero.
+ * The driver owns inter-command visibility and record lifetime.
+ */
+enum ac_mesh_hybrid_route {
+   AC_MESH_HYBRID_DIRECT = 1,
+   AC_MESH_HYBRID_OVERFLOW = 2,
+   AC_MESH_HYBRID_UNKNOWN = 3,
+};
+enum { AC_MESH_HYBRID_HEADER_SIZE = 64, AC_MESH_HYBRID_ABI = 1 };
+
+struct ac_mesh_hybrid_slot {
+   uint8_t components, sysval, varying;
+   nir_alu_type type[4];
+};
+struct ac_mesh_hybrid_layout {
+   uint32_t abi;
+   uint32_t max_vertices, max_primitives, corners;
+   uint32_t vertex_offset, vertex_stride, primitive_offset, primitive_stride;
+   uint32_t indices_offset, size;
+   uint64_t vertex_outputs, primitive_outputs;
+   struct ac_mesh_hybrid_slot slots[64];
+   bool allow_cyclic_rotation;
+   uint8_t flat_vertex_components[64];
+};
+
+/* Temporary classifier storage and final map arrays; no global geometry IO. */
+unsigned ac_nir_mesh_hybrid_map_lds_size(unsigned vertices, unsigned primitives);
+
+/* Linked/scalarized IO; failure leaves the input and caller layout unchanged.
+ * Initial admission shares the existing 32-bit generic/Position boundary.
+ */
+bool ac_nir_mesh_hybrid_layout_init(const nir_shader *mesh,
+                                  struct ac_mesh_hybrid_layout *layout, const char **reason);
+/* Raster-only list VS: no Mesh application instructions, one physical corner
+ * per invocation. Caller preserves topology/order and flat primitive PARAMs.
+ */
+nir_shader *ac_nir_create_mesh_hybrid_replay(const nir_shader_compiler_options *options,
+                                          const struct ac_mesh_hybrid_layout *layout);
+
+/* CPU test adapter for the SAME generated routing code, not a GPU pipeline.
+ * Shared bytes 0/4 contain actual V/P; 16/20 return F/route. Geometry follows
+ * the returned LDS offsets, and returned maps use uint32 entries. A scalar NIR
+ * interpreter executes invocation 0; this does not validate multiwave barriers.
+ */
+struct ac_mesh_hybrid_test_layout {
+   unsigned vertex, primitive, indices, physical_vertex, physical_primitive, primitive_physical, choice, alias, representative;
+};
+nir_shader *ac_nir_create_mesh_hybrid_classifier_test(const nir_shader_compiler_options *options,
+   const struct ac_mesh_hybrid_layout *layout, struct ac_mesh_hybrid_test_layout *shared);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/src/amd/common/nir/tests/ac_nir_lower_intrinsics_to_args_test.cpp b/src/amd/common/nir/tests/ac_nir_lower_intrinsics_to_args_test.cpp

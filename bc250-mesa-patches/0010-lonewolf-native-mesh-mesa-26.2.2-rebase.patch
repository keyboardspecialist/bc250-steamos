+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Inventory FF7 Fossilize graphics-pipeline records without Vulkan work.
+
+This is deliberately a file-format reader, not a Fossilize replayer.  It
+never loads Vulkan, creates a device, records a command buffer, or submits
+work.  It decodes the public Fossilize v5/v6 database representation well
+enough to retain the real Mesh--fragment pairings and the SPIR-V modules
+referenced by those pairings.
+
+The result is evidence for BC250 route provenance.  It is not a driver
+shader-hash policy and it does not infer draw commands which a pipeline cache
+cannot contain.
+"""
+
+from __future__ import annotations
+
+import argparse
+import binascii
+import collections
+import csv
+import hashlib
+import json
+import pathlib
+import re
+import struct
+import subprocess
+import sys
+import zlib
+from dataclasses import dataclass
+from typing import Iterator
+
+
+FOZ_MAGIC_PREFIX = b"\x81FOSSILIZEDB\0\0\0"
+FOZ_HEADER_SIZE = 16
+FOZ_NAME_SIZE = 40
+FOZ_PAYLOAD_HEADER_SIZE = 16
+FOZ_FORMAT_NONE = 1
+FOZ_FORMAT_DEFLATE = 2
+
+RESOURCE_SHADER_MODULE = 4
+RESOURCE_GRAPHICS_PIPELINE = 6
+
+VK_SHADER_STAGE_TASK_BIT_EXT = 0x40
+VK_SHADER_STAGE_MESH_BIT_EXT = 0x80
+VK_SHADER_STAGE_FRAGMENT_BIT = 0x10
+
+VK_DYNAMIC_STATE_FRAGMENT_SHADING_RATE_KHR = 1000226000
+VK_STRUCTURE_TYPE_PIPELINE_FRAGMENT_SHADING_RATE_STATE_CREATE_INFO_KHR = 1000226001
+VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADING_RATE_FEATURES_KHR = 1000226003
+VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MESH_SHADER_FEATURES_EXT = 1000328000
+VK_STRUCTURE_TYPE_PIPELINE_CREATE_FLAGS_2_CREATE_INFO_KHR = 1000470005
+VK_PIPELINE_CREATE_RENDERING_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR = 0x00200000
+VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR = 1000290000
+VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT = 1000320002
+
+SPECIAL_PRIMITIVE_BUILTINS = (
+    "PrimitiveId",
+    "Layer",
+    "ViewportIndex",
+    "ViewportMaskNV",
+    "PrimitiveShadingRateKHR",
+    "PrimitiveShadingRateEXT",
+    "CullPrimitiveEXT",
+)
+
+ENTRY_POINT_RE = re.compile(r'OpEntryPoint\s+(\w+)\s+%\S+\s+"([^"]+)"')
+EXECUTION_MODE_RE = re.compile(r"OpExecutionMode(?:Id)?\s+%\S+\s+(\w+)(?:\s+(.+))?$")
+DECORATE_RE = re.compile(r"OpDecorate\s+(%\S+)\s+(\w+)(?:\s+(.*))?$")
+SET_MESH_OUTPUTS_RE = re.compile(r"OpSetMeshOutputsEXT\s+(%\S+)\s+(%\S+)")
+CONSTANT_RE = re.compile(r"^\s*(%\S+)\s+=\s+Op(?:Spec)?Constant(?:True|False)?\b")
+
+
+@dataclass(frozen=True)
+class FozEntry:
+    resource: int
+    resource_hash: str
+    compressed_size: int
+    compression: int
+    crc32: int
+    uncompressed_size: int
+    payload: bytes
+
+
+def fail(message: str) -> "None":
+    raise ValueError(message)
+
+
+def sha256_file(path: pathlib.Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def read_exact(stream, size: int, context: str) -> bytes:
+    data = stream.read(size)
+    if len(data) != size:
+        fail(f"truncated {context}: expected {size}, got {len(data)}")
+    return data
+
+
+def decode_payload(raw: bytes, compression: int, expected_size: int, crc32: int) -> bytes:
+    # Fossilize checks the stored byte stream. For DEFLATE this is deliberately
+    # the compressed payload, not the decompressed JSON/SPIR-V payload.
+    if crc32 and binascii.crc32(raw) & 0xffffffff != crc32:
+        fail("stored payload CRC32 mismatch")
+    if compression == FOZ_FORMAT_NONE:
+        payload = raw
+    elif compression == FOZ_FORMAT_DEFLATE:
+        payload = zlib.decompress(raw)
+    else:
+        fail(f"unsupported Fossilize compression format {compression}")
+    if len(payload) != expected_size:
+        fail(f"payload size mismatch: expected {expected_size}, got {len(payload)}")
+    return payload
+
+
+def iter_foz_entries(path: pathlib.Path) -> Iterator[FozEntry]:
+    with path.open("rb") as stream:
+        magic = read_exact(stream, FOZ_HEADER_SIZE, "Fossilize header")
+        if magic[:15] != FOZ_MAGIC_PREFIX or magic[15] not in (5, 6):
+            fail(f"unsupported Fossilize header {magic!r}")
+
+        index = 0
+        while True:
+            name = stream.read(FOZ_NAME_SIZE)
+            if not name:
+                return
+            if len(name) != FOZ_NAME_SIZE:
+                fail(f"truncated entry name {index}")
+            header = read_exact(stream, FOZ_PAYLOAD_HEADER_SIZE, f"entry {index} header")
+            compressed_size, compression, crc32, uncompressed_size = struct.unpack("<IIII", header)
+            raw = read_exact(stream, compressed_size, f"entry {index} payload")
+            try:
+                name_text = name.decode("ascii")
+                resource = int(name_text[16:24], 16)
+                resource_hash = name_text[24:40]
+            except (UnicodeDecodeError, ValueError) as error:
+                fail(f"invalid Fossilize entry name {index}: {error}")
+            yield FozEntry(
+                resource=resource,
+                resource_hash=resource_hash,
+                compressed_size=compressed_size,
+                compression=compression,
+                crc32=crc32,
+                uncompressed_size=uncompressed_size,
+                payload=decode_payload(raw, compression, uncompressed_size, crc32),
+            )
+            index += 1
+
+
+def parse_json_payload(entry: FozEntry) -> dict[str, object] | None:
+    # Shader-module records have a JSON header followed by a NUL and binary
+    # varint data. Other Fossilize resource records are JSON only.
+    header = entry.payload.split(b"\0", 1)[0]
+    if not header.startswith(b"{"):
+        return None
+    try:
+        return json.loads(header)
+    except json.JSONDecodeError as error:
+        fail(f"invalid JSON in resource {entry.resource}/{entry.resource_hash}: {error}")
+
+
+def decode_varint_words(payload: bytes, word_count: int) -> bytes:
+    words: list[int] = []
+    offset = 0
+    for _ in range(word_count):
+        value = 0
+        shift = 0
+        while True:
+            if offset >= len(payload) or shift >= 32:
+                fail("invalid SPIR-V varint payload")
+            byte = payload[offset]
+            offset += 1
+            value |= (byte & 0x7f) << shift
+            shift += 7
+            if not byte & 0x80:
+                break
+        words.append(value)
+    if offset != len(payload):
+        fail(f"SPIR-V varint payload has {len(payload) - offset} trailing bytes")
+    return struct.pack(f"<{len(words)}I", *words)
+
+
+def decode_shader_module(entry: FozEntry) -> tuple[str, bytes]:
+    try:
+        json_blob, varint_blob = entry.payload.split(b"\0", 1)
+    except ValueError:
+        fail(f"shader module {entry.resource_hash} has no JSON/varint delimiter")
+    try:
+        document = json.loads(json_blob)
+        modules = document["shaderModules"]
+        if len(modules) != 1:
+            fail("shader module payload does not contain exactly one module")
+        module_hash, metadata = next(iter(modules.items()))
+        code_size = int(metadata["codeSize"])
+        varint_offset = int(metadata["varintOffset"])
+        varint_size = int(metadata["varintSize"])
+    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
+        fail(f"invalid shader module {entry.resource_hash}: {error}")
+    if code_size % 4 or varint_offset < 0 or varint_size < 0:
+        fail(f"invalid shader module sizes for {module_hash}")
+    varint_end = varint_offset + varint_size
+    if varint_end > len(varint_blob):
+        fail(f"shader module varint range overflows payload for {module_hash}")
+    spirv = decode_varint_words(varint_blob[varint_offset:varint_end], code_size // 4)
+    if len(spirv) != code_size or spirv[:4] != b"\x03\x02#\x07":
+        fail(f"decoded shader module {module_hash} is not SPIR-V")
+    return module_hash, spirv
+
+
+def pipeline_record(pipeline_hash: str, pipeline: dict[str, object]) -> dict[str, object] | None:
+    stages = pipeline.get("stages", [])
+    if not isinstance(stages, list):
+        return None
+    mesh = [stage for stage in stages if stage.get("stage") == VK_SHADER_STAGE_MESH_BIT_EXT]
+    if not mesh:
+        return None
+    fragment = [stage for stage in stages if stage.get("stage") == VK_SHADER_STAGE_FRAGMENT_BIT]
+    task = [stage for stage in stages if stage.get("stage") == VK_SHADER_STAGE_TASK_BIT_EXT]
+    pnext = pipeline.get("pNext", [])
+    dynamic = pipeline.get("dynamicState", {}).get("dynamicState", [])
+    return {
+        "pipeline_hash": pipeline_hash,
+        "layout": pipeline.get("layout"),
+        "stage_set": [stage.get("stage") for stage in stages],
+        "mesh_module": mesh[0].get("module"),
+        "fragment_module": fragment[0].get("module") if len(fragment) == 1 else None,
+        "task_modules": [stage.get("module") for stage in task],
+        "flags": pipeline.get("flags"),
+        "pnext_stypes": [item.get("sType") for item in pnext],
+        "stage_pnext_stypes": [
+            item.get("sType") for stage in stages for item in stage.get("pNext", [])
+        ],
+        "dynamic_states": dynamic,
+        "uses_dynamic_fragment_shading_rate": VK_DYNAMIC_STATE_FRAGMENT_SHADING_RATE_KHR in dynamic,
+        "uses_static_fragment_shading_rate": any(
+            item.get("sType") == VK_STRUCTURE_TYPE_PIPELINE_FRAGMENT_SHADING_RATE_STATE_CREATE_INFO_KHR
+            for item in pnext
+        ),
+        "uses_pipeline_library": any(
+            item.get("sType")
+            in (VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR,
+                VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT)
+            for item in pnext
+        ),
+        "dynamic_rendering": any(item.get("sType") == 1000044002 for item in pnext),
+    }
+
+
+def run_tool(argv: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(argv, check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+
+def analyze_spirv(path: pathlib.Path, spirv_dis: str, spirv_val: str) -> dict[str, object]:
+    validation = run_tool([spirv_val, str(path)])
+    disassembly = run_tool([spirv_dis, "--raw-id", str(path)])
+    if validation.returncode or disassembly.returncode:
+        return {
+            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+            "spirv_valid": False,
+            "spirv_validation_error": validation.stderr.strip() or disassembly.stderr.strip(),
+            "route_static": "INVALID_SPIRV",
+        }
+    text = disassembly.stdout
+    modes: dict[str, list[str]] = {}
+    entry_stages: list[str] = []
+    builtins: set[str] = set()
+    perprimitive = 0
+    constants: set[str] = set()
+    for line in text.splitlines():
+        if entry := ENTRY_POINT_RE.search(line):
+            entry_stages.append(entry.group(1))
+        if mode := EXECUTION_MODE_RE.search(line):
+            modes.setdefault(mode.group(1), []).append((mode.group(2) or "").strip())
+        if decorate := DECORATE_RE.search(line):
+            if decorate.group(2) == "BuiltIn" and decorate.group(3):
+                builtins.add(decorate.group(3).split()[0])
+            if decorate.group(2) == "PerPrimitiveEXT":
+                perprimitive += 1
+        if constant := CONSTANT_RE.search(line):
+            constants.add(constant.group(1))
+    output_calls = [match for match in map(SET_MESH_OUTPUTS_RE.search, text.splitlines()) if match]
+    dynamic_outputs = bool(output_calls) and any(
+        match.group(1) not in constants or match.group(2) not in constants for match in output_calls
+    )
+    special = {name: name in builtins or name in text for name in SPECIAL_PRIMITIVE_BUILTINS}
+    needs_s11 = bool(perprimitive) or any(special.values())
+    return {
+        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+        "spirv_valid": True,
+        "entry_stages": entry_stages,
+        "local_size": modes.get("LocalSize", []),
+        "output_vertices": modes.get("OutputVertices", []),
+        "output_primitives": modes.get("OutputPrimitivesEXT", []),
+        "output_topology": [name for name in ("OutputPoints", "OutputLinesEXT", "OutputTrianglesEXT") if name in modes],
+        "mesh_set_outputs_calls": len(output_calls),
+        "mesh_set_outputs_dynamic_counts": dynamic_outputs if output_calls else None,
+        "workgroup_id": "WorkgroupId" in builtins,
+        "local_invocation_id": "LocalInvocationId" in builtins,
+        "num_subgroups": "NumSubgroups" in builtins,
+        "draw_index": "DrawIndex" in builtins,
+        "perprimitive_decorations": perprimitive,
+        "special_primitive_semantics": special,
+        "cull_distance": "CullDistance" in builtins,
+        "route_static": "DIRECT_NO_S11_TRANSFORM" if not needs_s11 else "LINKED_INTERFACE_REQUIRED",
+    }
+
+
+def write_tsv(path: pathlib.Path, records: list[dict[str, object]]) -> None:
+    fields = [
+        "pipeline_hash", "mesh_module", "fragment_module", "layout", "stage_set",
+        "uses_dynamic_fragment_shading_rate", "uses_static_fragment_shading_rate",
+        "uses_pipeline_library", "mesh_route_static", "mesh_route_reason",
+    ]
+    with path.open("w", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(stream, fieldnames=fields, delimiter="\t", extrasaction="ignore")
+        writer.writeheader()
+        for record in records:
+            row = dict(record)
+            row["stage_set"] = ";".join(map(str, row["stage_set"]))
+            writer.writerow(row)
+
+
+def mesh_feature_application_infos(source: pathlib.Path) -> set[str]:
+    """Return AppInfo resources that explicitly request EXT Mesh support.
+
+    Fossilize creates one device from the first retained AppInfo resource.  A
+    complete Steam cache can contain historical AppInfos for non-Mesh device
+    configurations, so retaining all of them makes an otherwise valid Mesh
+    subset nondeterministically select a feature chain without meshShader.
+    This is intentionally a cache-replay artifact selection, not a driver
+    policy or a modification to the retained application shaders.
+    """
+    result: set[str] = set()
+    for entry in iter_foz_entries(source):
+        if entry.resource != 0:
+            continue
+        document = parse_json_payload(entry)
+        if document is None:
+            continue
+        features = document.get("physicalDeviceFeatures", {})
+        for structure in features.get("pNext", []):
+            if (
+                structure.get("sType") == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MESH_SHADER_FEATURES_EXT
+                and structure.get("meshShader")
+            ):
+                result.add(entry.resource_hash)
+                break
+    return result
+
+
+def write_mesh_subset(
+    source: pathlib.Path,
+    destination: pathlib.Path,
+    selected: dict[int, set[str] | None],
+    physical_gfx10: bool = False,
+) -> dict[str, object]:
+    """Write a dependency-closed, re-compressed FF7 Mesh Fossilize subset.
+
+    This output is an evidence artifact.  It contains no command stream and
+    permits Fossilize's null-device parser to validate the exact linked Mesh
+    PSO graph without being distracted by incomplete unrelated cache entries.
+    A None selection means that every entry of that resource type is retained.
+    """
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    written: collections.Counter[int] = collections.Counter()
+    rewritten: collections.Counter[str] = collections.Counter()
+    with destination.open("wb") as stream:
+        stream.write(FOZ_MAGIC_PREFIX + bytes((6,)))
+        for entry in iter_foz_entries(source):
+            hashes = selected.get(entry.resource)
+            if hashes is None:
+                if entry.resource not in selected:
+                    continue
+            elif entry.resource_hash not in hashes:
+                continue
+            payload = entry.payload
+            if physical_gfx10 and entry.resource in (0, RESOURCE_GRAPHICS_PIPELINE):
+                document = parse_json_payload(entry)
+                assert document is not None
+                if entry.resource == 0:
+                    features = document.get("physicalDeviceFeatures", {})
+                    filtered_pnext = []
+                    for structure in features.get("pNext", []):
+                        if structure.get("sType") == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADING_RATE_FEATURES_KHR:
+                            rewritten["fragment_shading_rate_feature_structures_removed"] += 1
+                            continue
+                        if structure.get("sType") == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MESH_SHADER_FEATURES_EXT:
+                            # Current BC250 intentionally exposes only Mesh, not Task,
+                            # multiview Mesh, primitive FSR, or Mesh queries.
+                            structure = dict(structure)
+                            structure.update({
+                                "taskShader": 0,
+                                "multiviewMeshShader": 0,
+                                "primitiveFragmentShadingRateMeshShader": 0,
+                                "meshShaderQueries": 0,
+                            })
+                            rewritten["mesh_feature_structures_rewritten"] += 1
+                        filtered_pnext.append(structure)
+                    if isinstance(features, dict):
+                        features["pNext"] = filtered_pnext
+                else:
+                    for pipeline in document.get("graphicsPipelines", {}).values():
+                        dynamic = pipeline.get("dynamicState", {}).get("dynamicState", [])
+                        filtered_dynamic = [
+                            state for state in dynamic if state != VK_DYNAMIC_STATE_FRAGMENT_SHADING_RATE_KHR
+                        ]
+                        rewritten["dynamic_fragment_shading_rate_states_removed"] += len(dynamic) - len(filtered_dynamic)
+                        if "dynamicState" in pipeline:
+                            pipeline["dynamicState"]["dynamicState"] = filtered_dynamic
+                        for structure in pipeline.get("pNext", []):
+                            if structure.get("sType") != VK_STRUCTURE_TYPE_PIPELINE_CREATE_FLAGS_2_CREATE_INFO_KHR:
+                                continue
+                            flags = structure.get("flags", 0)
+                            filtered_flags = flags & ~VK_PIPELINE_CREATE_RENDERING_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR
+                            if filtered_flags != flags:
+                                structure["flags"] = filtered_flags
+                                rewritten["fragment_shading_rate_pipeline_flags_removed"] += 1
+                payload = json.dumps(document, separators=(",", ":")).encode("utf-8")
+            compressed = zlib.compress(payload)
+            header = struct.pack(
+                "<IIII",
+                len(compressed),
+                FOZ_FORMAT_DEFLATE,
+                binascii.crc32(compressed) & 0xffffffff,
+                len(payload),
+            )
+            name = f"{0:016x}{entry.resource:08x}{entry.resource_hash}".encode("ascii")
+            assert len(name) == FOZ_NAME_SIZE
+            stream.write(name)
+            stream.write(header)
+            stream.write(compressed)
+            written[entry.resource] += 1
+    return {
+        "path": str(destination),
+        "sha256": sha256_file(destination),
+        "resource_counts": {str(key): value for key, value in sorted(written.items())},
+        "physical_gfx10_rewrites": dict(sorted(rewritten.items())),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--foz", required=True, type=pathlib.Path)
+    parser.add_argument("--out-json", required=True, type=pathlib.Path)
+    parser.add_argument("--out-tsv", required=True, type=pathlib.Path)
+    parser.add_argument("--extract-dir", required=True, type=pathlib.Path)
+    parser.add_argument(
+        "--subset-foz",
+        type=pathlib.Path,
+        help="write a dependency-closed Fossilize subset for the discovered Mesh PSOs",
+    )
+    parser.add_argument(
+        "--physical-gfx10-foz",
+        type=pathlib.Path,
+        help=("write a CPU-validation-only variant with current BC250 Mesh-only/VRS-off feature state "
+              "and VRS dynamic state removed"),
+    )
+    parser.add_argument("--spirv-dis", default="spirv-dis")
+    parser.add_argument("--spirv-val", default="spirv-val")
+    args = parser.parse_args()
+    if not args.foz.is_file():
+        parser.error(f"not a file: {args.foz}")
+
+    resource_counts: collections.Counter[int] = collections.Counter()
+    graphics: list[dict[str, object]] = []
+    pipeline_layouts: dict[str, dict[str, object]] = {}
+    set_layouts: dict[str, dict[str, object]] = {}
+    for entry in iter_foz_entries(args.foz):
+        resource_counts[entry.resource] += 1
+        if entry.resource not in (RESOURCE_GRAPHICS_PIPELINE, 2, 3):
+            continue
+        document = parse_json_payload(entry)
+        if document is None:
+            continue
+        if entry.resource == RESOURCE_GRAPHICS_PIPELINE:
+            for pipeline_hash, pipeline in document.get("graphicsPipelines", {}).items():
+                record = pipeline_record(pipeline_hash, pipeline)
+                if record is not None:
+                    graphics.append(record)
+        elif entry.resource == 2:
+            set_layouts.update(document.get("setLayouts", {}))
+        elif entry.resource == 3:
+            pipeline_layouts.update(document.get("pipelineLayouts", {}))
+
+    requested = {
+        module
+        for record in graphics
+        for module in (record["mesh_module"], record["fragment_module"])
+        if module
+    }
+    modules: dict[str, bytes] = {}
+    for entry in iter_foz_entries(args.foz):
+        if entry.resource != RESOURCE_SHADER_MODULE or entry.resource_hash not in requested:
+            continue
+        module_hash, spirv = decode_shader_module(entry)
+        if module_hash != entry.resource_hash:
+            fail(f"shader module hash mismatch {module_hash} != {entry.resource_hash}")
+        modules[module_hash] = spirv
+    missing = sorted(requested.difference(modules))
+    if missing:
+        fail(f"missing {len(missing)} pipeline-referenced shader modules: {', '.join(missing[:8])}")
+
+    args.extract_dir.mkdir(parents=True, exist_ok=True)
+    mesh_ids = {record["mesh_module"] for record in graphics}
+    fragment_ids = {record["fragment_module"] for record in graphics if record["fragment_module"]}
+    analyses: dict[str, dict[str, object]] = {}
+    for module_hash in sorted(requested):
+        stage = "mesh" if module_hash in mesh_ids else "fragment"
+        path = args.extract_dir / f"{stage}-{module_hash}.spv"
+        path.write_bytes(modules[module_hash])
+        analyses[module_hash] = analyze_spirv(path, args.spirv_dis, args.spirv_val)
+
+    for record in graphics:
+        analysis = analyses[record["mesh_module"]]
+        record["mesh_route_static"] = analysis["route_static"]
+        record["mesh_route_reason"] = (
+            "No generic/special per-primitive semantic in linked Mesh module"
+            if analysis["route_static"] == "DIRECT_NO_S11_TRANSFORM"
+            else "Requires S11 linked-interface transform and runtime output routing"
+        )
+        record["mesh_analysis"] = analysis
+        layout = pipeline_layouts.get(record["layout"], {})
+        record["layout_set_layouts"] = layout.get("setLayouts", [])
+        record["layout_push_constant_ranges"] = layout.get("pushConstantRanges", [])
+
+    mesh_analyses = [analyses[module] for module in sorted(mesh_ids)]
+    pair_count = len({(record["mesh_module"], record["fragment_module"]) for record in graphics})
+    route_counts = collections.Counter(record["mesh_route_static"] for record in graphics)
+    subset = None
+    physical_gfx10_subset = None
+    if args.subset_foz or args.physical_gfx10_foz:
+        mesh_app_infos = mesh_feature_application_infos(args.foz)
+        if not mesh_app_infos:
+            raise RuntimeError("no Fossilize AppInfo explicitly requests VK_EXT_mesh_shader")
+        mesh_layouts = {record["layout"] for record in graphics if record["layout"]}
+        mesh_set_layouts = {
+            set_layout
+            for layout in mesh_layouts
+            for set_layout in pipeline_layouts.get(layout, {}).get("setLayouts", [])
+        }
+        selected = {
+                0: mesh_app_infos,  # select a Mesh-capable device feature chain
+                1: None,  # immutable samplers can be referenced by a set layout
+                2: mesh_set_layouts,
+                3: mesh_layouts,
+                4: requested,
+                5: None,  # retained defensively; all selected PSOs use dynamic rendering
+                6: {record["pipeline_hash"] for record in graphics},
+        }
+        if args.subset_foz:
+            subset = write_mesh_subset(args.foz, args.subset_foz, selected)
+        if args.physical_gfx10_foz:
+            physical_gfx10_subset = write_mesh_subset(
+                args.foz, args.physical_gfx10_foz, selected, physical_gfx10=True
+            )
+    summary = {
+        "schema": 1,
+        "scope": "Read-only Fossilize pipeline cache inventory; no Vulkan instance, device, command recording, or submission.",
+        "foz": str(args.foz),
+        "foz_sha256": sha256_file(args.foz),
+        "resource_counts": {str(key): value for key, value in sorted(resource_counts.items())},
+        "ff7_mesh_graphics_pipeline_count": len(graphics),
+        "ff7_mesh_unique_module_count": len(mesh_ids),
+        "ff7_fragment_unique_module_count": len(fragment_ids),
+        "ff7_mesh_fragment_unique_pair_count": pair_count,
+        "mesh_pipeline_stage_sets": {
+            ";".join(map(str, key)): value
+            for key, value in collections.Counter(tuple(record["stage_set"]) for record in graphics).items()
+        },
+        "mesh_task_stage_count": sum(len(record["task_modules"]) for record in graphics),
+        "mesh_pipelines_missing_fragment": sum(record["fragment_module"] is None for record in graphics),
+        "mesh_pipeline_layout_count": len({record["layout"] for record in graphics}),
+        "mesh_pipeline_dynamic_fragment_shading_rate_count": sum(
+            record["uses_dynamic_fragment_shading_rate"] for record in graphics
+        ),
+        "mesh_pipeline_static_fragment_shading_rate_count": sum(
+            record["uses_static_fragment_shading_rate"] for record in graphics
+        ),
+        "mesh_pipeline_library_count": sum(record["uses_pipeline_library"] for record in graphics),
+        "mesh_pipeline_dynamic_rendering_count": sum(record["dynamic_rendering"] for record in graphics),
+        "mesh_route_counts": dict(route_counts),
+        "mesh_spirv_invalid_count": sum(not analysis["spirv_valid"] for analysis in mesh_analyses),
+        "mesh_local_sizes": dict(collections.Counter(" ".join(analysis.get("local_size", [])) for analysis in mesh_analyses)),
+        "mesh_output_vertices": dict(collections.Counter(" ".join(analysis.get("output_vertices", [])) for analysis in mesh_analyses)),
+        "mesh_output_primitives": dict(collections.Counter(" ".join(analysis.get("output_primitives", [])) for analysis in mesh_analyses)),
+        "mesh_topologies": dict(collections.Counter(
+            ";".join(analysis.get("output_topology", [])) for analysis in mesh_analyses
+        )),
+        "mesh_dynamic_set_outputs_count": sum(bool(analysis.get("mesh_set_outputs_dynamic_counts")) for analysis in mesh_analyses),
+        "mesh_workgroup_id_count": sum(bool(analysis.get("workgroup_id")) for analysis in mesh_analyses),
+        "mesh_local_invocation_id_count": sum(bool(analysis.get("local_invocation_id")) for analysis in mesh_analyses),
+        "mesh_num_subgroups_count": sum(bool(analysis.get("num_subgroups")) for analysis in mesh_analyses),
+        "mesh_draw_index_count": sum(bool(analysis.get("draw_index")) for analysis in mesh_analyses),
+        "mesh_perprimitive_count": sum(bool(analysis.get("perprimitive_decorations")) for analysis in mesh_analyses),
+        "mesh_cullprimitive_count": sum(
+            bool(analysis.get("special_primitive_semantics", {}).get("CullPrimitiveEXT"))
+            for analysis in mesh_analyses
+        ),
+        "mesh_primitive_id_count": sum(
+            bool(analysis.get("special_primitive_semantics", {}).get("PrimitiveId"))
+            for analysis in mesh_analyses
+        ),
+        "mesh_layer_count": sum(
+            bool(analysis.get("special_primitive_semantics", {}).get("Layer"))
+            for analysis in mesh_analyses
+        ),
+        "mesh_viewport_index_count": sum(
+            bool(analysis.get("special_primitive_semantics", {}).get("ViewportIndex"))
+            for analysis in mesh_analyses
+        ),
+        "mesh_cull_distance_count": sum(bool(analysis.get("cull_distance")) for analysis in mesh_analyses),
+        "dependency_closed_mesh_subset": subset,
+        "physical_gfx10_mesh_subset": physical_gfx10_subset,
+        "pipelines": graphics,
+    }
+    args.out_json.parent.mkdir(parents=True, exist_ok=True)
+    args.out_tsv.parent.mkdir(parents=True, exist_ok=True)
+    args.out_json.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    write_tsv(args.out_tsv, graphics)
+    print(json.dumps({key: value for key, value in summary.items() if key != "pipelines"}, sort_keys=True))
+    return 0 if summary["mesh_spirv_invalid_count"] == 0 else 1
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, zlib.error) as error:
+        print(f"ERROR: {error}", file=sys.stderr)
+        sys.exit(2)
diff --git a/bin/bc250_ff7_mesh_compile.c b/bin/bc250_ff7_mesh_compile.c
new file mode 100644
index 0000000000000000000000000000000000000000..d02e978eb31ee8f6f2a1fac88a43fba67dbe9a2d
--- /dev/null
+++ b/bin/bc250_ff7_mesh_compile.c
@@ -0,0 +1,348 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * CPU-only FF7 Mesh module compiler harness.  It intentionally creates no
+ * command pool, command buffer, queue, resource allocation, or submission.
+ * Invoke it under the project no-submit seccomp/tripwire guard as an
+ * independent enforcement layer.
+ */
+#include <vulkan/vulkan.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(call)                                                                                 \
+   do {                                                                                              \
+      VkResult result_ = (call);                                                                      \
+      if (result_ != VK_SUCCESS) {                                                                    \
+         fprintf(stderr, "SETUP_FAIL %s result=%d line=%d\n", #call, result_, __LINE__);            \
+         return 2;                                                                                    \
+      }                                                                                               \
+   } while (0)
+
+static uint32_t *
+read_spirv(const char *path, size_t *size)
+{
+   FILE *file = fopen(path, "rb");
+   if (!file || fseek(file, 0, SEEK_END)) {
+      perror(path);
+      return NULL;
+   }
+   long bytes = ftell(file);
+   if (bytes <= 0 || bytes % 4 || fseek(file, 0, SEEK_SET)) {
+      fprintf(stderr, "invalid SPIR-V size: %s\n", path);
+      fclose(file);
+      return NULL;
+   }
+   uint32_t *data = malloc(bytes);
+   if (!data || fread(data, 1, bytes, file) != (size_t)bytes) {
+      perror(path);
+      free(data);
+      fclose(file);
+      return NULL;
+   }
+   fclose(file);
+   *size = bytes;
+   return data;
+}
+
+/* A vkd3d shader dump records a module but not the D3D12 root-signature to
+ * Vulkan descriptor-layout translation that accompanied its original PSO.
+ * Compiling such a module against an empty layout is invalid Vulkan usage and
+ * can make descriptor lowering dereference an absent binding. Detect that
+ * explicitly instead of treating an unpaired module as a compilable pipeline.
+ */
+static bool
+spirv_requires_descriptor_layout(const char *path)
+{
+   size_t bytes = 0;
+   uint32_t *words = read_spirv(path, &bytes);
+   if (!words || bytes < 5 * sizeof(*words) || words[0] != 0x07230203) {
+      free(words);
+      return true;
+   }
+   bool result = false;
+   for (size_t index = 5, count = bytes / sizeof(*words); index < count;) {
+      const uint16_t opcode = words[index] & 0xffff;
+      const uint16_t word_count = words[index] >> 16;
+      if (!word_count || index + word_count > count) {
+         result = true;
+         break;
+      }
+      /* OpDecorate = 71; Binding = 33 and DescriptorSet = 34. */
+      if (opcode == 71 && word_count >= 3 && (words[index + 2] == 33 || words[index + 2] == 34)) {
+         result = true;
+         break;
+      }
+      index += word_count;
+   }
+   free(words);
+   return result;
+}
+
+static VkPhysicalDevice
+find_bc250(VkInstance instance)
+{
+   uint32_t count = 0;
+   if (vkEnumeratePhysicalDevices(instance, &count, NULL) != VK_SUCCESS || !count)
+      return VK_NULL_HANDLE;
+   VkPhysicalDevice *devices = calloc(count, sizeof(*devices));
+   if (!devices || vkEnumeratePhysicalDevices(instance, &count, devices) != VK_SUCCESS) {
+      free(devices);
+      return VK_NULL_HANDLE;
+   }
+   VkPhysicalDevice result = VK_NULL_HANDLE;
+   for (uint32_t i = 0; i < count; ++i) {
+      VkPhysicalDeviceProperties properties;
+      vkGetPhysicalDeviceProperties(devices[i], &properties);
+      if (properties.vendorID == 0x1002 && properties.deviceID == 0x13fe) {
+         result = devices[i];
+         break;
+      }
+   }
+   free(devices);
+   return result;
+}
+
+static uint32_t
+find_graphics_queue_family(VkPhysicalDevice physical_device)
+{
+   uint32_t count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &count, NULL);
+   VkQueueFamilyProperties *properties = calloc(count, sizeof(*properties));
+   if (!properties)
+      return UINT32_MAX;
+   vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &count, properties);
+   uint32_t result = UINT32_MAX;
+   for (uint32_t i = 0; i < count; ++i) {
+      if (properties[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {
+         result = i;
+         break;
+      }
+   }
+   free(properties);
+   return result;
+}
+
+static VkResult
+compile_mesh_pipeline(VkDevice device, VkPipelineLayout layout, VkRenderPass render_pass, VkShaderModule fragment,
+                      const char *mesh_path)
+{
+   size_t mesh_size = 0;
+   uint32_t *mesh_code = read_spirv(mesh_path, &mesh_size);
+   if (!mesh_code)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   VkShaderModuleCreateInfo module_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = mesh_size,
+      .pCode = mesh_code,
+   };
+   VkShaderModule mesh = VK_NULL_HANDLE;
+   VkResult result = vkCreateShaderModule(device, &module_info, NULL, &mesh);
+   free(mesh_code);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkPipelineShaderStageCreateInfo stages[] = {
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .stage = VK_SHADER_STAGE_MESH_BIT_EXT,
+       .module = mesh,
+       .pName = "main"},
+      {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+       .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+       .module = fragment,
+       .pName = "main"},
+   };
+   VkViewport viewport = {0, 0, 64, 64, 0, 1};
+   VkRect2D scissor = {{0, 0}, {64, 64}};
+   VkPipelineViewportStateCreateInfo viewport_state = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor,
+   };
+   VkPipelineRasterizationStateCreateInfo rasterization = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE,
+      .lineWidth = 1.0f,
+   };
+   VkPipelineMultisampleStateCreateInfo multisample = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   VkPipelineColorBlendAttachmentState attachment = {.colorWriteMask = 0xf};
+   VkPipelineColorBlendStateCreateInfo blend = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &attachment,
+   };
+   VkGraphicsPipelineCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .stageCount = 2,
+      .pStages = stages,
+      .pViewportState = &viewport_state,
+      .pRasterizationState = &rasterization,
+      .pMultisampleState = &multisample,
+      .pColorBlendState = &blend,
+      .layout = layout,
+      .renderPass = render_pass,
+   };
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   result = vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &info, NULL, &pipeline);
+   if (pipeline)
+      vkDestroyPipeline(device, pipeline, NULL);
+   vkDestroyShaderModule(device, mesh, NULL);
+   return result;
+}
+
+int
+main(int argc, char **argv)
+{
+   bool expect_special_reject = argc > 1 && !strcmp(argv[1], "--expect-special-reject");
+   const int fragment_arg = expect_special_reject ? 2 : 1;
+   const int mesh_arg = fragment_arg + 1;
+   if (argc <= mesh_arg) {
+      fprintf(stderr, "usage: %s [--expect-special-reject] FRAGMENT.spv MESH0.spv [MESH1.spv ...]\n", argv[0]);
+      return 2;
+   }
+
+   VkApplicationInfo application = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "bc250-ff7-offline-mesh-compile",
+      .apiVersion = VK_API_VERSION_1_4,
+   };
+   VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &application,
+   };
+   VkInstance instance;
+   CHECK(vkCreateInstance(&instance_info, NULL, &instance));
+   VkPhysicalDevice physical_device = find_bc250(instance);
+   if (!physical_device) {
+      fprintf(stderr, "BC250 not found\n");
+      vkDestroyInstance(instance, NULL);
+      return 2;
+   }
+   VkPhysicalDeviceProperties properties;
+   vkGetPhysicalDeviceProperties(physical_device, &properties);
+   printf("DEVICE name=%s vendor=%04x device=%04x\n", properties.deviceName, properties.vendorID,
+          properties.deviceID);
+
+   VkPhysicalDeviceMeshShaderFeaturesEXT mesh_features = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MESH_SHADER_FEATURES_EXT,
+   };
+   VkPhysicalDeviceFeatures2 features = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+      .pNext = &mesh_features,
+   };
+   vkGetPhysicalDeviceFeatures2(physical_device, &features);
+   if (!mesh_features.meshShader || mesh_features.taskShader) {
+      fprintf(stderr, "unexpected Mesh/Task feature state mesh=%u task=%u\n", mesh_features.meshShader,
+              mesh_features.taskShader);
+      vkDestroyInstance(instance, NULL);
+      return 2;
+   }
+   uint32_t queue_family = find_graphics_queue_family(physical_device);
+   if (queue_family == UINT32_MAX) {
+      fprintf(stderr, "no graphics queue family\n");
+      vkDestroyInstance(instance, NULL);
+      return 2;
+   }
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = queue_family,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   mesh_features.meshShader = VK_TRUE;
+   VkDeviceCreateInfo device_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .pNext = &mesh_features,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = 1,
+      .ppEnabledExtensionNames = (const char *[]){VK_EXT_MESH_SHADER_EXTENSION_NAME},
+   };
+   VkDevice device;
+   CHECK(vkCreateDevice(physical_device, &device_info, NULL, &device));
+
+   size_t fragment_size = 0;
+   uint32_t *fragment_code = read_spirv(argv[fragment_arg], &fragment_size);
+   if (!fragment_code) {
+      vkDestroyDevice(device, NULL);
+      vkDestroyInstance(instance, NULL);
+      return 2;
+   }
+   VkShaderModuleCreateInfo fragment_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = fragment_size,
+      .pCode = fragment_code,
+   };
+   VkShaderModule fragment;
+   VkResult setup_result = vkCreateShaderModule(device, &fragment_info, NULL, &fragment);
+   free(fragment_code);
+   if (setup_result != VK_SUCCESS) {
+      fprintf(stderr, "fragment module failed result=%d\n", setup_result);
+      vkDestroyDevice(device, NULL);
+      vkDestroyInstance(instance, NULL);
+      return 2;
+   }
+   VkPipelineLayoutCreateInfo layout_info = {.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   VkPipelineLayout layout;
+   CHECK(vkCreatePipelineLayout(device, &layout_info, NULL, &layout));
+   VkAttachmentDescription attachment = {
+      .format = VK_FORMAT_R32G32B32A32_SFLOAT,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+      .storeOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+      .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+      .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+      .finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+   };
+   VkAttachmentReference reference = {.attachment = 0, .layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+   VkSubpassDescription subpass = {
+      .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &reference,
+   };
+   VkRenderPassCreateInfo render_pass_info = {
+      .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &attachment,
+      .subpassCount = 1,
+      .pSubpasses = &subpass,
+   };
+   VkRenderPass render_pass;
+   CHECK(vkCreateRenderPass(device, &render_pass_info, NULL, &render_pass));
+
+   unsigned failures = 0, unpaired_layouts = 0;
+   for (int i = mesh_arg; i < argc; ++i) {
+      if (spirv_requires_descriptor_layout(argv[i]) && !expect_special_reject) {
+         /* No pipeline is created for this module. */
+         printf("UNPAIRED_LAYOUT mesh=%s result=NOT_COMPILED\n", argv[i]);
+         ++unpaired_layouts;
+         continue;
+      }
+      VkResult result = compile_mesh_pipeline(device, layout, render_pass, fragment, argv[i]);
+      const bool pass = expect_special_reject ? result == VK_ERROR_FEATURE_NOT_PRESENT : result == VK_SUCCESS;
+      printf("%s mesh=%s result=%d expected=%d\n", pass ? "PASS" : "FAIL", argv[i], result,
+             expect_special_reject ? VK_ERROR_FEATURE_NOT_PRESENT : VK_SUCCESS);
+      failures += !pass;
+   }
+   vkDestroyRenderPass(device, render_pass, NULL);
+   vkDestroyPipelineLayout(device, layout, NULL);
+   vkDestroyShaderModule(device, fragment, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+   printf("SUMMARY modules=%d failures=%u unpaired_descriptor_layouts=%u GPU_COMMAND_RECORDED=NO "
+          "GPU_COMMAND_SUBMITTED=NO\n",
+          argc - mesh_arg, failures, unpaired_layouts);
+   return failures ? 1 : 0;
+}
